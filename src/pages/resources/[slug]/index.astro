---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '~/layouts/BaseLayout.astro';
import ClosingCta from '~/components/sections/ClosingCta.astro';
import ResourceCard from '~/components/ResourceCard.astro';
import { breadcrumbSchema, resourceSchema } from '~/data/schema';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

export const getStaticPaths = (async () => {
	const entries = await getCollection('resources', ({ data }) => !data.draft);
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const locale = getLocale(Astro);
const t = useTranslations(locale);

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Related: same category first, then anything else, capped at three.
const others = (await getCollection('resources', ({ data: d }) => !d.draft)).filter(
	(candidate) => candidate.id !== entry.id,
);
const related = [
	...others.filter((o) => o.data.category === data.category),
	...others.filter((o) => o.data.category !== data.category),
].slice(0, 3);

const path = `/resources/${entry.id}/`;
/* Absolute, for the share sheet and the clipboard fallback — a visitor pasting
   a root-relative path into a message sends nobody anywhere. */
const shareUrl = new URL(localizePath(path, locale), Astro.site).href;
const updated = data.updated.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
});
---

<BaseLayout
	title={data.title}
	description={data.blurb}
	ogImage={{
		// Per-resource card when one exists, hub card otherwise. Either way this
		// page ships its own value rather than inheriting a sitewide default.
		src: data.ogImage ?? '/images/og/resources.png',
		alt: `${data.title} — free resource from MOLAR AI`,
		width: 1200,
		height: 630,
	}}
	type="article"
	schema={[
		breadcrumbSchema([
			{ name: 'Home', path: '/' },
			{ name: 'Resources', path: '/resources/' },
			{ name: data.title, path },
		]),
		resourceSchema({
			title: data.title,
			description: data.blurb,
			path,
			updated: data.updated,
			category: data.category,
		}),
	]}
>
	<article class="resource">
		<div class="container-content resource__inner">
			{/*
				A back link rather than a full breadcrumb trail. There is exactly one
				way into this page and one way out of it, and a three-rung trail above
				an article is chrome pretending to be navigation. The trail still
				exists for crawlers — see breadcrumbSchema in the head.
			*/}
			<a class="resource__back" href={localizePath('/resources/', locale)}>
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M13.5 8h-11M6.5 4 2.5 8l4 4" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				{t('resources.back')}
			</a>

			<p class="resource__meta">
				<span class="resource__cat">{data.category}</span>
				<span>{data.pages} pages</span>
				<span>{data.format}</span>
				<time datetime={data.updated.toISOString().slice(0, 10)}>{updated}</time>
			</p>

			<h1 class="resource__title">{data.title}</h1>
			<p class="resource__blurb">{data.blurb}</p>

			{/*
				No email gate. The guide above is already the whole method, so
				trading the PDF for an address would be charging for the printable
				version of something the visitor just read for free — which reads as
				a toll booth after the fact, and costs more goodwill than the address
				is worth.

				Inline and across the measure rather than parked in a sidebar: on
				this page the download IS the call to action, and a sidebar puts it
				beside the article on a wide screen and below all of it on a narrow
				one, which is the one place nobody reaches.
			*/}
			<aside class="offer" aria-labelledby="offer-heading">
				<span class="offer__mark" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M12 3.6v10.2M8.2 10.4 12 14.2l3.8-3.8" stroke-linecap="round" stroke-linejoin="round" />
						<path d="M4.4 16.2v2.6a1.6 1.6 0 0 0 1.6 1.6h12a1.6 1.6 0 0 0 1.6-1.6v-2.6" stroke-linecap="round" />
					</svg>
				</span>

				<span class="offer__text">
					<span class="offer__title" id="offer-heading">
						{t('resources.offerTitle')}
						<span class="offer__badge">Free</span>
					</span>
					<span class="offer__lede">{t('resources.offerLede')}</span>
				</span>

				<span class="offer__actions">
					{/*
						Netlify already serves /pdfs/ with Content-Disposition:
						attachment, so this downloads rather than opening in a tab. The
						`download` attribute is the same instruction said client-side,
						for anyone serving these from somewhere that does not.
					*/}
					<a class="btn btn-primary offer__btn" href={data.file} download>
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						{t('resources.downloadPdf')}
					</a>

					<button
						type="button"
						class="btn btn-quiet offer__btn"
						data-share
						data-url={shareUrl}
						data-title={data.title}
						data-copied={t('resources.linkCopied')}
					>
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<circle cx="12" cy="3.8" r="1.9" />
							<circle cx="4" cy="8" r="1.9" />
							<circle cx="12" cy="12.2" r="1.9" />
							<path d="m5.7 7.1 4.6-2.4M5.7 8.9l4.6 2.4" stroke-linecap="round" />
						</svg>
						<span data-share-label>{t('resources.share')}</span>
					</button>
				</span>
			</aside>

			{/* data-prose is the script's handle — see the copy-button block below. */}
			<div class="resource__body" data-prose>
				<Content />
			</div>
		</div>
	</article>

	{
		related.length > 0 && (
			<section class="related section-rule" aria-labelledby="related-heading">
				<div class="container-content related__inner">
					<h2 class="related__title" id="related-heading">
						More from the library
					</h2>
					<div class="related__grid">
						{related.map((item) => (
							<ResourceCard entry={item} headingLevel="h3" />
						))}
					</div>
				</div>
			</section>
		)
	}

	<ClosingCta />
</BaseLayout>

<script>
	/**
	 * Decorates the guide body after render: a labelled bar with a copy button on
	 * every fenced block, and a scroll box around every table.
	 *
	 * Done here rather than in a rehype plugin because the content is plain
	 * markdown and should stay that way — an author writing a guide types three
	 * backticks, not a component. The markup ships readable without any of this;
	 * with no JS you get a plain <pre>, which is a fenced block that you select
	 * and copy the way you always did.
	 */
	const COPIED_MS = 1600;

	const icon = (paths: string) =>
		`<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

	const COPY_ICON = icon('<rect x="5.5" y="5.5" width="8" height="8" rx="1.6"/><path d="M10.5 5.5v-1a1.6 1.6 0 0 0-1.6-1.6H4a1.6 1.6 0 0 0-1.6 1.6v4.9A1.6 1.6 0 0 0 4 11h1"/>');
	const DONE_ICON = icon('<path d="m3.5 8.5 3 3 6-7"/>');

	/*
		Share. The native sheet where there is one — phones, and Safari on the
		desktop — because it reaches WhatsApp and Messages, which is how a practice
		manager actually passes something to a colleague. Everywhere else the
		clipboard is the honest fallback, and the button says so where you are
		already looking rather than firing a toast.
	*/
	const share = document.querySelector<HTMLButtonElement>('[data-share]');
	const shareLabel = share?.querySelector<HTMLElement>('[data-share-label]');

	if (share && shareLabel) {
		const idle = shareLabel.textContent ?? 'Share';
		const url = share.dataset.url ?? location.href;
		const title = share.dataset.title ?? document.title;

		share.addEventListener('click', async () => {
			if (navigator.share) {
				try {
					await navigator.share({ title, url });
					return;
				} catch {
					/* Dismissed, or refused. Fall through to the clipboard rather
					   than leaving the click having done nothing. */
				}
			}

			try {
				await navigator.clipboard.writeText(url);
				shareLabel.textContent = share.dataset.copied ?? 'Link copied';
				share.setAttribute('data-done', '');
				window.setTimeout(() => {
					shareLabel.textContent = idle;
					share.removeAttribute('data-done');
				}, COPIED_MS);
			} catch {
				/* No clipboard either — an insecure origin, or a hard denial. The
				   URL is in the address bar and there is nothing useful left to do. */
			}
		});
	}

	const body = document.querySelector<HTMLElement>('[data-prose]');

	if (body) {
		for (const pre of Array.from(body.querySelectorAll('pre'))) {
			/*
				The fence's language. Shiki puts it on the <pre> as `data-language`
				and leaves the <code> bare, and an unlabelled fence comes through as
				"plaintext" rather than as nothing. In a guide like these that is a
				prompt, which is what the reference calls them too.
			*/
			const language = pre.dataset.language;
			const generic = !language || language === 'plaintext' || language === 'text';

			const shell = document.createElement('div');
			shell.className = 'prompt';

			const bar = document.createElement('div');
			bar.className = 'prompt__bar';

			const label = document.createElement('span');
			label.className = 'prompt__label';
			label.textContent = generic ? 'PROMPT' : language.toUpperCase();

			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'prompt__copy';
			button.innerHTML = `${COPY_ICON}<span>Copy</span>`;

			button.addEventListener('click', async () => {
				const text = pre.innerText;
				try {
					await navigator.clipboard.writeText(text);
				} catch {
					/* Denied, or an insecure origin. Select it instead, so the
					   gesture still leaves the user one keystroke from copying
					   rather than doing nothing at all. */
					const range = document.createRange();
					range.selectNodeContents(pre);
					const selection = window.getSelection();
					selection?.removeAllRanges();
					selection?.addRange(range);
					return;
				}

				button.innerHTML = `${DONE_ICON}<span>Copied</span>`;
				button.setAttribute('data-copied', '');
				window.setTimeout(() => {
					button.innerHTML = `${COPY_ICON}<span>Copy</span>`;
					button.removeAttribute('data-copied');
				}, COPIED_MS);
			});

			bar.append(label, button);
			pre.replaceWith(shell);
			shell.append(bar, pre);
		}

		/*
			Wide content scrolls inside its own box. A table left to itself widens
			the article and takes the whole page's horizontal scroll with it.
		*/
		for (const table of Array.from(body.querySelectorAll('table'))) {
			const scroller = document.createElement('div');
			scroller.className = 'table-scroll';
			table.replaceWith(scroller);
			scroller.append(table);
		}
	}
</script>

<style>
	.resource {
		padding-block: calc(var(--nav-h, 4.5rem) + clamp(3rem, 7vw, 5rem)) clamp(3.5rem, 7vw, 6rem);
		background:
			radial-gradient(
				70% 55% at 12% 0%,
				color-mix(in oklab, var(--color-arc-700) 16%, transparent),
				transparent 60%
			),
			var(--color-ink-950);
	}

	/* A reading measure. The article is one column at every width. */
	.resource__inner {
		max-width: 46rem;
	}

	.resource__back {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 2.25rem;
		color: var(--color-bone-400);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color 0.28s var(--ease-out-quint);
	}

	.resource__back:hover {
		color: var(--color-arc-300);
	}

	.resource__back svg {
		width: 1rem;
		height: 1rem;
		transition: transform 0.28s var(--ease-out-quint);
	}

	.resource__back:hover svg {
		transform: translateX(-3px);
	}

	/*
		The facts, promoted out of the table they used to sit in at the foot of the
		page and set as one line above the title. Format and length are what you
		check before you decide to read, not after.
	*/
	.resource__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	.resource__cat {
		color: var(--color-arc-400);
	}

	.resource__title {
		margin: 1rem 0 0;
		font-size: var(--text-4xl);
		line-height: 1.06;
		letter-spacing: -0.03em;
		max-width: 18ch;
	}

	.resource__blurb {
		margin: 1.25rem 0 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	/* ── The offer ───────────────────────────────────────────────────────── */
	/*
		Wraps to a stack on a narrow screen without a media query: the form is
		given a basis wide enough that it cannot share a line with the copy until
		there is genuinely room for both.
	*/
	.offer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-block: clamp(2rem, 4vw, 2.75rem);
		padding: 1.125rem 1.25rem;
		border: 1px solid color-mix(in oklab, var(--color-arc-400) 26%, transparent);
		border-radius: 0.875rem;
		background-color: color-mix(in oklab, var(--color-arc-700) 18%, transparent);
		background-image: linear-gradient(
			180deg,
			color-mix(in oklab, #a3adbd 10%, transparent),
			color-mix(in oklab, #a3adbd 2%, transparent)
		);
		backdrop-filter: blur(14px) saturate(140%);
		box-shadow: inset 0 1px 0 color-mix(in oklab, #cfe4ff 14%, transparent);
	}

	.offer__mark {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.6875rem;
		border: 1px solid color-mix(in oklab, var(--color-arc-400) 30%, transparent);
		background: color-mix(in oklab, var(--color-arc-600) 22%, transparent);
		color: var(--color-arc-200);
	}

	.offer__mark svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.offer__text {
		display: grid;
		gap: 0.2rem;
		/* Takes the row until the form needs it, then both wrap. */
		flex: 1 1 14rem;
		min-width: 0;
	}

	.offer__title {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--color-bone-50);
	}

	.offer__badge {
		padding: 0.125rem 0.4375rem;
		border-radius: 0.3125rem;
		background: color-mix(in oklab, var(--color-arc-500) 26%, transparent);
		color: var(--color-arc-200);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.offer__lede {
		font-size: var(--text-sm);
		color: var(--color-bone-400);
	}

	/*
		`flex: none` and a basis wide enough that the pair drops to its own line
		rather than squeezing the copy to three words per line on a tablet.
	*/
	.offer__actions {
		flex: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	.offer__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		white-space: nowrap;
	}

	.offer__btn svg {
		width: 0.9375rem;
		height: 0.9375rem;
	}

	.offer__btn[data-done] {
		color: var(--color-arc-300);
		border-color: color-mix(in oklab, var(--color-arc-400) 55%, transparent);
	}

	/* ── Body ────────────────────────────────────────────────────────────── */
	/*
		Everything markdown can emit, styled once. The library is meant to hold
		full guides rather than a paragraph and a download button, so a heading
		level or a table turning up in a file should never be a reason to touch
		this page again.

		`:global` throughout because none of it exists at build time — <Content />
		renders markdown into elements Astro's scoper never sees, and a plain
		`.resource__body p` rule would compile to a selector with a cid attribute
		that no rendered paragraph carries.
	*/
	.resource__body {
		margin-block-start: 0.5rem;
		font-size: var(--text-base);
		line-height: 1.75;
	}

	.resource__body :global(p) {
		margin: 1.35rem 0 0;
		color: var(--color-bone-300);
	}

	.resource__body :global(h2) {
		margin: clamp(2.25rem, 4vw, 3rem) 0 0;
		font-size: var(--text-2xl);
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--color-bone-50);
	}

	.resource__body :global(h3) {
		margin: 2rem 0 0;
		font-size: var(--text-lg);
		line-height: 1.3;
		color: var(--color-bone-50);
	}

	.resource__body :global(ul),
	.resource__body :global(ol) {
		margin: 1.25rem 0 0;
		padding-inline-start: 1.35rem;
		color: var(--color-bone-300);
	}

	.resource__body :global(li) {
		margin: 0.55rem 0 0;
	}

	.resource__body :global(li::marker) {
		color: var(--color-arc-400);
	}

	.resource__body :global(strong) {
		color: var(--color-bone-50);
		font-weight: 600;
	}

	.resource__body :global(a) {
		color: var(--color-arc-300);
		text-underline-offset: 0.2em;
	}

	.resource__body :global(hr) {
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		border: 0;
		border-top: 1px solid var(--color-line);
	}

	.resource__body :global(img) {
		margin: 1.75rem 0 0;
		border-radius: 0.75rem;
		border: 1px solid var(--color-line);
	}

	/*
		The aside. A markdown blockquote, because an author writing a guide should
		not have to remember a component name to add one — "> text" is the thing
		every markdown writer already reaches for.
	*/
	.resource__body :global(blockquote) {
		margin: 1.75rem 0 0;
		padding: 1rem 1.25rem;
		border: 0;
		border-inline-start: 2px solid color-mix(in oklab, var(--color-arc-400) 60%, transparent);
		border-radius: 0 0.5rem 0.5rem 0;
		background: color-mix(in oklab, var(--color-arc-700) 14%, transparent);
		color: var(--color-bone-300);
		font-size: var(--text-sm);
	}

	.resource__body :global(blockquote p) {
		margin: 0.6rem 0 0;
	}

	.resource__body :global(blockquote p:first-child) {
		margin: 0;
	}

	/* Tables scroll inside their own box rather than widening the article. */
	.resource__body :global(.table-scroll) {
		margin: 1.75rem 0 0;
		overflow-x: auto;
	}

	.resource__body :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-sm);
	}

	.resource__body :global(th),
	.resource__body :global(td) {
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid var(--color-line);
		text-align: start;
	}

	.resource__body :global(th) {
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	/* ── Prompt blocks ───────────────────────────────────────────────────── */
	/*
		A fenced block in the markdown becomes a labelled panel with a copy
		button. The wrapper and the bar are built by the script below, so these
		rules have to be global for the same reason the prose ones are.
	*/
	.resource__body :global(.prompt) {
		margin: 1.5rem 0 0;
		border: 1px solid var(--color-line);
		border-radius: 0.75rem;
		background: color-mix(in oklab, var(--color-ink-900) 82%, transparent);
		overflow: hidden;
	}

	.resource__body :global(.prompt__bar) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 0.5rem 0.5rem 0.875rem;
		border-bottom: 1px solid var(--color-line);
		background: color-mix(in oklab, var(--color-ink-800) 60%, transparent);
	}

	.resource__body :global(.prompt__label) {
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	.resource__body :global(.prompt__copy) {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--color-line);
		border-radius: 0.4375rem;
		background: transparent;
		color: var(--color-bone-300);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition:
			border-color 0.24s var(--ease-out-quint),
			color 0.24s var(--ease-out-quint);
	}

	.resource__body :global(.prompt__copy:hover) {
		border-color: color-mix(in oklab, var(--color-arc-400) 55%, transparent);
		color: var(--color-bone-50);
	}

	/* Confirmation lives on the button itself — a toast for "copied" is a lot of
	   machinery to say something the button can say where you are already looking. */
	.resource__body :global(.prompt__copy[data-copied]) {
		border-color: color-mix(in oklab, var(--color-arc-400) 60%, transparent);
		color: var(--color-arc-300);
	}

	.resource__body :global(.prompt__copy svg) {
		width: 0.8125rem;
		height: 0.8125rem;
	}

	.resource__body :global(.prompt pre) {
		margin: 0;
		padding: 1rem 1.125rem;
		background: none !important;
		font-size: var(--text-sm);
