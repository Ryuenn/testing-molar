---
/**
 * The content library — the catalogue of carousels and reels, filterable, with
 * each item opening in a modal rather than on a page of its own.
 *
 * Why a modal and not a route per item: browsing a catalogue is a scanning
 * task. Every full page load costs you your scroll position and your filters,
 * and you come back to the top of a grid you had already narrowed. The dialog
 * keeps the grid exactly where it was underneath.
 *
 * Everything renders server-side — every item, every filter — and the script
 * only hides and shows. Without JS you get the whole catalogue as a plain grid,
 * which is the correct fallback for a library.
 *
 * The data comes from ~/data/library, which is the single place the live Softr
 * catalogue plugs into. Nothing here knows where the items came from.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import StepIcon from '~/components/ui/StepIcon.astro';
import ClosingCta from '~/components/sections/ClosingCta.astro';
import { LIBRARY_ITEMS, LIBRARY_TOPICS, LIBRARY_TYPES, facet } from '~/data/library';
import { breadcrumbSchema } from '~/data/schema';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const items = LIBRARY_ITEMS;

/* The hub's social card, reused. The library has no art of its own, and a
   sibling page sharing the hub's card is better than one with none. */
const OG = {
	src: '/images/og/resources.png',
	alt: 'MOLAR AI video library — patient education videos for dental practices',
	width: 1200,
	height: 630,
};

/*
	One descriptor per filter, so the markup below is a loop rather than four
	near-identical blocks. `values` is derived from the catalogue, which is what
	lets Month disappear entirely until the live data brings months with it — an
	empty <select> is worse than no control. The same test drops any facet the
	catalogue only has one value for: a filter that cannot narrow anything is
	furniture.
*/
const FILTERS = [
	{ key: 'topic', label: t('library.topic'), values: facet(items, 'topic', LIBRARY_TOPICS) },
	{ key: 'type', label: t('library.type'), values: facet(items, 'type', LIBRARY_TYPES) },
	{ key: 'month', label: t('library.month'), values: facet(items, 'month') },
	{ key: 'language', label: t('library.language'), values: facet(items, 'language') },
].filter((f) => f.values.length > 1);

/* Sentences the client script builds — same reasoning as the resource hub: a
   module script is bundled once for every page that uses it and cannot see
   this component's `t`. Templates, not fragments. */
const scriptStrings = JSON.stringify({
	showing: t('library.showing'),
	videoFailed: t('library.videoFailed'),
	openTab: t('library.openTab'),
});
---

<BaseLayout
	title={t('pages.libraryTitle')}
	description={t('pages.libraryDesc')}
	ogImage={OG}
	schema={[
		breadcrumbSchema([
			{ name: t('crumbs.home'), path: '/' },
			{ name: t('nav.resources'), path: '/resources/' },
			{ name: t('library.crumb'), path: '/resources/video-library/' },
		]),
	]}
>
	<section class="hero-lite" aria-labelledby="lib-heading">
		<div class="container-content">
			<nav aria-label="Breadcrumb" class="crumbs">
				<ol class="crumbs__list">
					<li><a href={localizePath('/', locale)}>{t('crumbs.home')}</a></li>
					<li><a href={localizePath('/resources/', locale)}>{t('nav.resources')}</a></li>
					<li aria-current="page">{t('library.crumb')}</li>
				</ol>
			</nav>

			<p class="eyebrow">{t('library.eyebrow')}</p>
			<h1 id="lib-heading" class="hero-lite__title">{t('library.heading')}</h1>
			<p class="hero-lite__lede measure-wide">{t('library.lede')}</p>
		</div>
	</section>

	{/* The band's light, carried past its bottom edge — see .band-falloff. */}
	<div class="band-falloff" aria-hidden="true"></div>

	<section class="library section-rule" aria-labelledby="lib-grid-heading">
		<div class="library__aurora" aria-hidden="true"></div>
		<div class="grain" aria-hidden="true"></div>
		<div class="container-content library__inner">
			<h2 id="lib-grid-heading" class="sr-only">{t('library.crumb')}</h2>

			<div class="filters" data-filters data-strings={scriptStrings}>
				<div class="toolbar">
					<form class="search" role="search" data-search-form>
						<label for="lib-search" class="sr-only">{t('library.search')}</label>
						<svg
							class="search__icon"
							viewBox="0 0 16 16"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"
						>
							<circle cx="7" cy="7" r="4.5"></circle>
							<path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
						</svg>
						<input
							type="search"
							id="lib-search"
							class="search__input"
							placeholder={t('library.searchPlaceholder')}
							autocomplete="off"
							data-search
						/>
					</form>

					{
						FILTERS.map((filter) => (
							<div class="sort">
								<label class="sort__label" for={'lib-' + filter.key}>
									{filter.label}
								</label>
								<select id={'lib-' + filter.key} class="sort__select" data-facet={filter.key}>
									<option value="">{t('library.all')}</option>
									{filter.values.map((value) => (
										<option value={value}>{value}</option>
									))}
								</select>
							</div>
						))
					}
				</div>

				<p class="filters__status" data-status role="status" aria-live="polite">
					{t('library.showing', { n: items.length, total: items.length })}
				</p>
			</div>

			<ul class="library__grid" data-grid role="list">
				{
					items.map((item) => (
						<li>
							{/*
								A button, not a link: the destination is a dialog on this
								page. Carousels still carry their Canva URL in a data
								attribute and the dialog turns it into a real anchor, so
								the outbound link exists where it is useful rather than on
								every card in the grid.
							*/}
							<button
								type="button"
								class="lib-card"
								data-card
								data-title={item.title}
								data-topic={item.topic}
								data-type={item.type}
								data-language={item.language}
								data-month={item.month}
								data-video={item.video}
								data-vimeo={item.vimeo}
								data-summary={item.summary}
								data-explainer={item.explainer}
								data-code={item.code}
								aria-haspopup="dialog"
							>
								<span class="lib-card__media">
									{/*
										The mark under the clip, so a card that has not painted
										its poster frame yet still reads as a video rather than as
										an empty tile. The <video> covers it the moment the seek
										lands.
									*/}
									<span class="lib-card__placeholder" aria-hidden="true">
										<StepIcon name="video" />
									</span>

									{/*
										Two kinds of item, two ways to show a still.

										Local clips seek their own: `#t=0.1` is a media fragment
										that makes the browser paint that frame, which costs a
										range request instead of a poster we would have to
										generate, commit, and keep in sync with the clip.

										Hosted ones have no local file to seek, so they take
										Vimeo's own thumbnail. Lazy, because sixty-odd of them on
										one page is the difference between a grid that paints
										immediately and one that waits on images nobody has
										scrolled to yet.
									*/}
									{item.video ? (
										<video
											class="lib-card__video"
											src={item.video + '#t=0.1'}
											preload="metadata"
											muted
											playsinline
										/>
									) : (
										<img
											class="lib-card__video"
											src={item.poster}
											alt=""
											loading="lazy"
											decoding="async"
											width="360"
											height="640"
										/>
									)}

									<span class="lib-card__badge">{item.type}</span>

									<span class="lib-card__play" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path d="M9 6.5v11l9-5.5-9-5.5Z" fill="currentColor" />
										</svg>
									</span>
								</span>

								<span class="lib-card__body">
									<span class="lib-card__title">{item.title}</span>
									<span class="lib-card__meta">
										<span class="lib-card__tag">{item.language}</span>
										<span class="lib-card__tag">{item.topic}</span>
										{item.code && <span class="lib-card__code">{item.code}</span>}
									</span>

									{/*
										A span, not a button. The card is already the button, and
										a button inside a button is invalid markup that browsers
										resolve by discarding one of them — usually not the one
										you wanted. This is the affordance; the card takes the
										click.
									*/}
									<span class="lib-card__cta">
										<svg viewBox="0 0 16 16" aria-hidden="true">
											<path d="M6 4.5v7l6-3.5-6-3.5Z" fill="currentColor" />
										</svg>
										{t('library.watch')}
									</span>
								</span>
							</button>
						</li>
					))
				}
			</ul>

			<p class="library__empty" data-empty hidden>
				<span>{t('library.nothing')}</span>
				<button type="button" class="btn btn-quiet" data-reset>{t('library.clearFilters')}</button>
			</p>
		</div>
	</section>

	{/*
		One dialog, populated from whichever card was clicked — not one per item.
		A catalogue grown to three hundred entries would otherwise ship three
		hundred <dialog> elements, and three hundred <video> tags inside them.
	*/}
	<dialog class="lib-dialog" data-dialog aria-labelledby="lib-dialog-title">
		<div class="lib-dialog__frame">
			<div class="lib-dialog__stage">
				<video class="lib-dialog__video" data-dialog-video controls playsinline preload="metadata"
				></video>

				{/*
					The hosted player. A second element rather than one that switches
					`src` between a file and an embed: they are different elements with
					different controls, and swapping the tag under one name is how you
					end up with a <video> wearing an iframe's attributes.

					No `src` in the markup. An iframe carrying a Vimeo URL would load a
					player on page load, and the whole point of one dialog for the grid
					is that it costs one player rather than sixty-seven.
				*/}
				<iframe
					class="lib-dialog__embed"
					data-dialog-embed
					title=""
					hidden
					allow="autoplay; fullscreen; picture-in-picture"
					allowfullscreen
					referrerpolicy="strict-origin-when-cross-origin"></iframe>

				{/*
					The escape hatch, and the reason the modal is safe to reach for: it
					is shown whenever the frame cannot play the item — a codec the
					browser refuses, a blocked cross-origin asset — and for carousels,
					which have no video to show at all. Either way the visitor gets a
					real link out rather than a black box.
				*/}
				<div class="lib-dialog__fallback" data-fallback hidden>
					<p class="lib-dialog__fallback-text" data-fallback-text></p>
					<a class="btn btn-primary" data-fallback-link target="_blank" rel="noopener noreferrer"
					></a>
				</div>
			</div>

			{/*
				The reading side. It scrolls on its own rather than scrolling the
				dialog: a script can run long, and the video should stay put while
				you read past the fold of it.
			*/}
			<div class="lib-dialog__panel">
				<h2 id="lib-dialog-title" class="lib-dialog__title" data-dialog-title></h2>
				<p class="lib-dialog__meta" data-dialog-meta></p>

				<section class="lib-dialog__field" data-summary-field hidden>
					<p class="lib-dialog__caption" data-dialog-summary></p>
				</section>

				<section class="lib-dialog__field" data-explainer-field hidden>
					<h3 class="lib-dialog__field-label">{t('library.about')}</h3>
					<div class="lib-dialog__script" data-dialog-explainer></div>
				</section>

				{/* Shown only when neither field is filled — an empty right-hand
				    column reads as a rendering fault rather than as missing copy. */}
				<p class="lib-dialog__empty" data-dialog-empty hidden>{t('library.noScript')}</p>
			</div>

			<button class="lib-dialog__close" type="button" data-close>
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="m7 7 10 10M17 7 7 17"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"></path>
				</svg>
				<span class="sr-only">{t('library.close')}</span>
			</button>
		</div>
	</dialog>

	<ClosingCta />
</BaseLayout>

<script>
	/**
	 * Two jobs: narrowing the grid, and the modal.
	 *
	 * The filters compose — the visible set is the intersection of the search
	 * box and every facet select that has a value — so choosing a topic and then
	 * typing narrows within that topic instead of resetting it.
	 *
	 * The modal is one dialog reused for every card. `showModal()` gives us the
	 * top layer, an inert page behind, a focus trap and Escape; what is left is
	 * loading the right clip into it, the scroll lock, and the fallback link.
	 */
	const root = document.querySelector<HTMLElement>('[data-filters]');
	const grid = document.querySelector<HTMLElement>('[data-grid]');
	const status = document.querySelector<HTMLElement>('[data-status]');
	const empty = document.querySelector<HTMLElement>('[data-empty]');
	const search = document.querySelector<HTMLInputElement>('[data-search]');
	const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');
	const reset = document.querySelector<HTMLButtonElement>('[data-reset]');
	const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]');

	if (root && grid && status && empty && search && dialog) {
		const S = JSON.parse(root.dataset.strings || '{}') as Record<string, string>;

		/** `{n}` / `{total}`. Escaped properly — a bare `{(w+)}` matches nothing. */
		const fill = (tpl: string, vars: Record<string, string | number>) =>
			(tpl || '').replace(/\{(\w+)\}/g, (whole, key) =>
				key in vars ? String(vars[key]) : whole,
			);

		const selects = Array.from(root.querySelectorAll<HTMLSelectElement>('[data-facet]'));
		const cards = Array.from(grid.querySelectorAll<HTMLButtonElement>('[data-card]'));

		// ── Narrowing ──────────────────────────────────────────────────────────
		const haystack = (card: HTMLElement) =>
			[card.dataset.title, card.dataset.topic, card.dataset.type, card.dataset.language, card.dataset.code]
				.join(' ')
				.toLowerCase();

		const apply = () => {
			const query = search.value.trim().toLowerCase();
			let visible = 0;

			for (const card of cards) {
				const facetsMatch = selects.every((select) => {
					if (!select.value) return true;
					return card.dataset[select.dataset.facet as string] === select.value;
				});
				const match = facetsMatch && (!query || haystack(card).includes(query));
				/* The <li> carries the hiding, not the button — hiding the button
				   alone would leave the grid holding an empty cell. */
				(card.parentElement as HTMLElement).hidden = !match;
				if (match) visible++;
			}

			status.textContent = fill(S.showing, { n: visible, total: cards.length });
			empty.hidden = visible > 0;
		};

		search.addEventListener('input', apply);
		/* Nothing is posted — filtering happens on input. The handler exists only
		   so Enter does not navigate. */
		searchForm?.addEventListener('submit', (event) => event.preventDefault());
		for (const select of selects) select.addEventListener('change', apply);

		reset?.addEventListener('click', () => {
			search.value = '';
			for (const select of selects) select.value = '';
			apply();
			search.focus();
		});

		// ── The modal ──────────────────────────────────────────────────────────
		const video = dialog.querySelector<HTMLVideoElement>('[data-dialog-video]')!;
		const embed = dialog.querySelector<HTMLIFrameElement>('[data-dialog-embed]')!;
		const title = dialog.querySelector<HTMLElement>('[data-dialog-title]')!;
		const meta = dialog.querySelector<HTMLElement>('[data-dialog-meta]')!;
		const fallback = dialog.querySelector<HTMLElement>('[data-fallback]')!;
		const fallbackText = dialog.querySelector<HTMLElement>('[data-fallback-text]')!;
		const fallbackLink = dialog.querySelector<HTMLAnchorElement>('[data-fallback-link]')!;
		const closer = dialog.querySelector<HTMLButtonElement>('[data-close]')!;
		const panel = dialog.querySelector<HTMLElement>('.lib-dialog__panel')!;
		const summaryField = dialog.querySelector<HTMLElement>('[data-summary-field]')!;
		const summaryText = dialog.querySelector<HTMLElement>('[data-dialog-summary]')!;
		const explainerField = dialog.querySelector<HTMLElement>('[data-explainer-field]')!;
		const explainerBody = dialog.querySelector<HTMLElement>('[data-dialog-explainer]')!;
		const empty = dialog.querySelector<HTMLElement>('[data-dialog-empty]')!;

		/** Whatever opened it, so focus has somewhere honest to go back to. */
		let opener: HTMLButtonElement | null = null;

		/*
			Lenis owns the scroll, so `overflow: hidden` alone would not stop the
			page moving under the dialog — it has to be told. The attribute covers
			the reduced-motion path, where Lenis never loaded to hear the event.
		*/
		const lock = (on: boolean) => {
			document.documentElement.toggleAttribute('data-modal-open', on);
			window.dispatchEvent(new CustomEvent(on ? 'molar:lock-scroll' : 'molar:unlock-scroll'));
		};

		const showFallback = (text: string, label: string, href: string) => {
			video.hidden = true;
			fallback.hidden = false;
			fallbackText.textContent = text;
			fallbackLink.textContent = label;
			fallbackLink.href = href;
		};

		/* A clip the browser will not decode. This is the only place the fallback
		   is reached for a reason other than "it was never a video". */
		video.addEventListener('error', () => {
			if (!video.src) return;
			showFallback(S.videoFailed, S.openTab, video.src);
		});

		const open = (card: HTMLButtonElement) => {
			opener = card;
			const data = card.dataset;

			title.textContent = data.title ?? '';
			meta.textContent = [data.type, data.topic, data.language, data.month, data.code]
				.filter(Boolean)
				.join(' · ');

			const summary = (data.summary ?? '').trim();
			summaryField.hidden = !summary;
			summaryText.textContent = summary;

			const explainer = (data.explainer ?? '').trim();
			explainerField.hidden = !explainer;
			explainerBody.replaceChildren(
				/* Blank-line separated, so it can be pasted out of Softr unchanged.
				   Built as real paragraphs rather than dropped in as innerHTML —
				   this is content, and content does not get to inject markup. */
				...explainer
					.split(/\n\s*\n/)
					.map((para) => para.trim())
					.filter(Boolean)
					.map((para) => {
						const el = document.createElement('p');
						el.textContent = para;
						return el;
					}),
			);

			empty.hidden = Boolean(summary || explainer);
			panel.scrollTop = 0;

			fallback.hidden = true;

			/* Both torn down first, whichever is about to be used. Leaving the other
			   one loaded means a hosted clip keeps playing behind a local one. */
			video.hidden = true;
			video.removeAttribute('src');
			embed.hidden = true;
			embed.removeAttribute('src');

			if (data.vimeo) {
				embed.hidden = false;
				embed.title = data.title ?? '';
				/*
					`autoplay` because the visitor clicked a card to watch something —
					the click is the gesture that permits it. `dnt` keeps Vimeo from
					setting tracking cookies on our visitors, which is ours to decide
					and not something a video needs.
				*/
				embed.src = `https://player.vimeo.com/video/${encodeURIComponent(data.vimeo)}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`;
			} else {
				video.hidden = false;
				video.src = data.video ?? '';
				video.load();
			}

			dialog.showModal();
			lock(true);
			/* Inside the click, so it is allowed to play. The hosted player starts
			   itself from `autoplay=1` above. */
			if (!data.vimeo) void video.play().catch(() => {});
		};

		for (const card of cards) {
			card.addEventListener('click', () => open(card));
		}

		closer.addEventListener('click', () => dialog.close());

		/* A click that lands on the dialog itself landed on the backdrop — the
		   frame is a child and would have been the target otherwise. */
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		/* Fires for the close button, the backdrop and Escape alike, which is why
		   the teardown lives here rather than in three handlers. Dropping the src
		   stops the download too — closing a modal should not leave a clip
		   streaming in the background. */
		dialog.addEventListener('close', () => {
			video.pause();
			video.removeAttribute('src');
			video.load();
			/* Same reasoning for the hosted player, and it is not optional there:
			   an iframe left with its `src` set keeps playing — and keeps its audio
			   going — behind a closed dialog. Dropping the attribute unloads the
			   document inside it. */
			embed.hidden = true;
			embed.removeAttribute('src');
			fallbackLink.hidden = false;
			lock(false);
			opener?.focus();
		});
	}
</script>

<style>
	/* ── Page chrome ─────────────────────────────────────────────────────── */
	/*
		Deliberately the same values as the resource hub's. The two pages are
		siblings and a visitor moves between them; anything that drifted here
		would read as a different site rather than a different page.
	*/
	/* The banner, matching PageIntro's — see the note there. */
	.hero-lite {
		position: relative;
		isolation: isolate;
		overflow: clip;
		padding-block: calc(var(--nav-h, 4.5rem) + clamp(3rem, 8vw, 6rem)) clamp(2.5rem, 5vw, 4rem);
		background:
			radial-gradient(
				128% 92% at 50% 108%,
				color-mix(in oklab, var(--color-arc-500) 32%, transparent) 0%,
				color-mix(in oklab, var(--color-arc-600) 24%, transparent) 30%,
				color-mix(in oklab, var(--color-arc-700) 14%, transparent) 54%,
				color-mix(in oklab, var(--color-arc-700) 5%, transparent) 72%,
				transparent 88%
			),
			radial-gradient(
				96% 74% at 50% -12%,
				color-mix(in oklab, var(--color-arc-700) 18%, transparent) 0%,
				transparent 70%
			),
			linear-gradient(
				180deg,
				var(--color-ink-950) 0%,
				var(--color-ink-900) 46%,
				var(--color-ink-950) 100%
			);
		border-block-end: 1px solid var(--color-line);
	}

	/* The still, over the field. Lifted: the PNG is exposed for a full-bleed
	   hero and reads a stop under that at band height. */
	.hero-lite::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: url('/page_banner_r.png') 50% 64% / cover no-repeat;
		filter: brightness(1.75) saturate(1.2);
		/* Screen, so the wave adds its light to the field instead of covering
		   it — the dark half of the still then costs nothing. */
		mix-blend-mode: screen;
		/* And it fades out to the left, where the heading and lede sit. */
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.3) 28%,
			rgba(0, 0, 0, 0.74) 50%,
			#000 72%
		);
		mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.3) 28%,
			rgba(0, 0, 0, 0.74) 50%,
			#000 72%
		);
		pointer-events: none;
	}

