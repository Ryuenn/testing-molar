---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResourceCard from '~/components/ResourceCard.astro';
import NewsletterSignup from '~/components/NewsletterSignup.astro';
import { RESOURCE_CATEGORIES } from '~/data/resources';
import { EDUCATION_CHECKOUT } from '~/data/site';
import { EDUCATION_PRICE } from '~/data/education';
import { breadcrumbSchema } from '~/data/schema';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const all = (await getCollection('resources', ({ data }) => !data.draft)).sort((a, b) => {
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return a.data.order - b.data.order;
});

// Only offer a filter for categories that actually have something in them.
const used = RESOURCE_CATEGORIES.filter((category) =>
	all.some((entry) => entry.data.category === category),
);

const counts = new Map(used.map((c) => [c, all.filter((e) => e.data.category === c).length]));

/*
	Strings the client script builds sentences from. Serialised onto the element
	rather than inlined into the script, because a module script tag is bundled once
	for every page that uses it and cannot see this component's "t". Templates,
	not fragments — see the note on interpolation in ~/i18n/utils.
*/
const scriptStrings = JSON.stringify({
	showingAll: t('resources.showingAll'),
	showingIn: t('resources.showingIn'),
	nothingYet: t('resources.nothingYet'),
	matching: t('resources.searchPlaceholder'),
});
---

<BaseLayout
	title={t('pages.resourcesTitle')}
	description={t('pages.resourcesDesc')}
	ogImage={{
		src: '/images/og/resources.png',
		alt: 'MOLAR AI resource library — free guides for dental practices',
		width: 1200,
		height: 630,
	}}
	schema={[
		breadcrumbSchema([
			{ name: t('crumbs.home'), path: '/' },
			{ name: t('nav.resources'), path: '/resources/' },
		]),
	]}
>
	<section class="hero-lite" aria-labelledby="library-heading">
		<div class="container-content">
			<nav aria-label="Breadcrumb" class="crumbs">
				<ol class="crumbs__list">
					<li><a href={localizePath('/', locale)}>{t('crumbs.home')}</a></li>
					<li aria-current="page">{t('nav.resources')}</li>
				</ol>
			</nav>

			<p class="eyebrow">{t('resources.eyebrow')}</p>
			<h1 id="library-heading" class="hero-lite__title">{t('resources.heading')}</h1>
			<p class="hero-lite__lede measure-wide">
				{t('resources.lede')}{' '}
				{locale !== 'en' && <span class="hero-lite__note">{t('resources.englishNote')}</span>}
			</p>
			<p class="hero-lite__lede measure-wide">{t('resources.lede2')}</p>

			{/*
				The video library's doorway, above the grid.

				This slot held the Dental AI Brief sign-up for one pass. The 09/01
				brief's line for this page was "Remove the $97 offer. No selling
				here", and this panel is the only thing on the page that asks for
				money — so it came off and the email capture took its place.

				It is back by request. The library IS the page's strongest asset and
				burying its only entrance at the foot of the grid was the wrong trade;
				the brief's own list also asks for a lead capture, and that still runs,
				at the bottom under "Stay Ahead Of What's Changing".

				⚠️ So this page sells again, which contradicts that line of the brief.
				Deliberate, and worth knowing if the brief is the reference later.

				The grid below is PDFs and every card in it downloads one. The library
				is a different kind of thing and behaves differently when clicked, so
				it sits outside the grid rather than pretending to be the thirteenth
				document.
			*/}
			<div class="lib-promo">
				<div class="lib-promo__head">
					<p class="lib-promo__brand">
						MOLAR<span class="lib-promo__brand-ai">.AI</span> {t('library.hubTitle')}
					</p>
					<p class="lib-promo__badge">
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<rect x="3.5" y="7" width="9" height="6" rx="1.4"></rect>
							<path d="M5.75 7V5.25a2.25 2.25 0 0 1 4.5 0V7" stroke-linecap="round"></path>
						</svg>
						{t('library.hubAccess')}
					</p>
				</div>

				<p class="lib-promo__blurb">{t('library.hubBlurb')}</p>

				{/*
					Two doors, and both are needed.

					The library is gated, so the obvious button is "subscribe" — but a
					practice that already pays has a password and was being sent to a
					pricing page to buy something they own. The second button is for
					them: it goes to the library, hits the password screen, and they
					are in.

					Order is by audience size rather than by preference: most people
					reading this have not subscribed.
				*/}
				<div class="lib-promo__actions">
					<a class="btn btn-primary" href={EDUCATION_CHECKOUT} rel="noopener">
						{t('library.hubUnlock')}
						<span class="lib-promo__price">{EDUCATION_PRICE}/{t('edu.perMonth').replace('/', '')}</span>
					</a>
					<a class="btn btn-quiet" href={localizePath('/resources/video-library/', locale)}>
						{t('library.hubCta')}
					</a>
				</div>
			</div>
		</div>
	</section>

	{/* The band's light, carried past its bottom edge — see .band-falloff. */}
	<div class="band-falloff" aria-hidden="true"></div>

	<section class="library section-rule" aria-labelledby="library-grid-heading">
		{/* The field the cards and chips blur — without it, translucency is just
		    a paler grey. */}
		<div class="library__aurora" aria-hidden="true"></div>
		<div class="grain" aria-hidden="true"></div>
		<div class="container-content library__inner">
			{/*
				A real heading, not an sr-only one.

				It was hidden because the page's <h1> already said "the MOLAR resource
				library" and the grid needed a landmark name rather than a second
				title. The <h1> is about AI in dentistry now, so the grid is a section
				of its own and gets to be introduced like one.
			*/}
			<header class="library__head">
				<p class="eyebrow">{t('resources.libraryTitle')}</p>
				<h2 id="library-grid-heading" class="library__title">{t('resources.libraryHeading')}</h2>
				<p class="library__lede measure-wide">{t('resources.libraryLede')}</p>
			</header>

			{/*
				The $97 card that stood here is gone. It was a "Unlock the library —
				$97/mo" button plus a "paid access" padlock badge, at the top of a page
				whose whole promise is that everything on it is free — and the brief is
				explicit: no selling here.

				The gated video library is still reachable. It is one quiet link at the
				foot of the grid rather than a merchandised panel at the head of it,
				and the four places on this site that DO sell — the hero, the MOLAR TV
				section, the plan grid and the closing CTA — are where that argument
				belongs.
			*/}
			<div class="filters" data-filters data-strings={scriptStrings}>
				{/*
					Search and sort sit above the chips because they act on everything;
					the chips narrow what those two are working over. All three compose —
					a search inside a category, sorted — rather than overriding each other.
				*/}
				<div class="toolbar">
					{/*
						A real <form> with role="search", so the field is a landmark and
						Enter does not wander off looking for a submit. Nothing is posted:
						filtering happens on input, and the submit handler exists only to
						stop the browser navigating.
					*/}
					<form class="search" role="search" data-search-form>
						<label for="resource-search" class="sr-only">{t('resources.search')}</label>
						<svg
							class="search__icon"
							viewBox="0 0 16 16"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"
						>
							<circle cx="7" cy="7" r="4.5"></circle>
							<path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
						</svg>
						<input
							type="search"
							id="resource-search"
							class="search__input"
							placeholder={t('resources.searchPlaceholder')}
							autocomplete="off"
							data-search
						/>
						<button type="button" class="search__clear" data-search-clear hidden>
							<span class="sr-only">{t('resources.clearSearch')}</span>
							<svg
								viewBox="0 0 16 16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								aria-hidden="true"
							>
								<path d="m5 5 6 6M11 5l-6 6"></path>
							</svg>
						</button>
					</form>

					<div class="sort">
						<label for="resource-sort" class="sort__label">{t('resources.sort')}</label>
						{/*
							A native <select>. A custom listbox here would be a keyboard-trap
							risk and a mobile regression for the sake of matching the chips,
							and the chips are already the styled control on this row.
						*/}
						<select id="resource-sort" class="sort__select" data-sort>
							<option value="featured">{t('resources.sortFeatured')}</option>
							<option value="newest">{t('resources.sortNewest')}</option>
							<option value="title">{t('resources.sortTitle')}</option>
							<option value="shortest">{t('resources.sortShortest')}</option>
						</select>
					</div>
				</div>

				<div class="filters__group" role="group" aria-label={t('resources.filterBy')}>
					<button type="button" class="chip" data-filter="all" aria-pressed="true">
						{t('resources.all')} <span class="chip__count">{all.length}</span>
					</button>
					{
						used.map((category) => (
							<button type="button" class="chip" data-filter={category} aria-pressed="false">
								{category} <span class="chip__count">{counts.get(category)}</span>
							</button>
						))
					}
				</div>

				<p class="filters__status" data-filter-status role="status" aria-live="polite">
					{t('resources.showingAll', { n: all.length })}
				</p>
			</div>

			<div class="library__grid" data-resource-grid>
				{all.map((entry) => <ResourceCard entry={entry} headingLevel="h3" />)}
			</div>

			{/*
				The message is rewritten by the script to name whatever actually caused
				the empty result — a search, a category, or both. This is the no-JS
				wording, and with no JS the grid is never empty, so it never shows.
			*/}
			<p class="library__empty" data-empty hidden>
				<span data-empty-text>{t('resources.nothingYet')}</span>
				<button type="button" class="btn btn-quiet" data-reset>{t('resources.clearFilters')}</button>
			</p>

			{/* No "Access the library" button down here. It stood in for the promo
			    panel while that was off the page; the panel is back at the top with
			    the same door in it, and two identical buttons on one page is one
			    too many. */}
		</div>
	</section>

	{/* ── Community ───────────────────────────────────────────────────────── */}
	<section class="section section-rule hub-community" aria-labelledby="community-heading">
		<div class="container-content hub-community__inner">
			<h2 id="community-heading" class="hub-community__title">{t('resources.communityHeading')}</h2>
			<p class="hub-community__body measure-wide">{t('resources.communityBody')}</p>
			<p class="hub-community__kicker">{t('resources.communityKicker')}</p>
		</div>
	</section>

	{/* ── The closing ask ─────────────────────────────────────────────────── */}
	{/*
		`ClosingCta` used to run here. It is the site's standard sales close —
		plans, prices, "talk to MOLAR" — which is exactly what this page is not
		for. The close is the same free brief the top of the page offers, asking
		for one field instead of two because by now the reader has seen what is
		on offer.
	*/}
	<section class="section hub-ahead" aria-labelledby="ahead-heading">
		<div class="container-content hub-ahead__inner">
			<h2 id="ahead-heading" class="hub-ahead__title">{t('resources.aheadHeading')}</h2>
			<p class="hub-ahead__lede measure-wide">{t('resources.aheadLede')}</p>

			<NewsletterSignup
				id="hub-foot"
				submitLabel={t('resources.aheadCta')}
				note={t('resources.aheadNote')}
			/>
		</div>
	</section>
</BaseLayout>

<script>
	/**
	 * The hub's three controls: category chips, a search field and a sort select.
	 *
	 * They compose rather than override — the visible set is
	 * (category ∩ search), ordered by sort — so narrowing by category and then
	 * typing does what you would expect instead of resetting the other control.
	 *
	 * Progressive throughout. The grid renders every resource server-side and the
	 * controls simply do nothing without JS, which is why the markup ships
	 * complete rather than being built here. Filtering is attribute-based and
	 * O(n) per keystroke, which at library scale is nothing.
	 *
	 * Sorting reorders actual DOM nodes rather than setting CSS `order`. Flex and
	 * grid `order` moves a card visually while leaving it where it was in the tab
	 * sequence, so a keyboard user would tab through the cards in an order that no
	 * longer matches the page. Reordering the nodes keeps the two the same thing.
	 */
	const root = document.querySelector<HTMLElement>('[data-filters]');
	const grid = document.querySelector<HTMLElement>('[data-resource-grid]');
	const status = document.querySelector<HTMLElement>('[data-filter-status]');
	const empty = document.querySelector<HTMLElement>('[data-empty]');
	const emptyText = document.querySelector<HTMLElement>('[data-empty-text]');
	const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');
	const search = document.querySelector<HTMLInputElement>('[data-search]');
	const clear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
	const sort = document.querySelector<HTMLSelectElement>('[data-sort]');

	if (root && grid && status && empty && emptyText && search && sort) {
		/* Sentences the server rendered for this page's locale — see data-strings. */
		const S = JSON.parse(root.dataset.strings || '{}') as Record<string, string>;
		const fill = (tpl: string, vars: Record<string, string | number>) =>
			(tpl || '').replace(/{(w+)}/g, (w, k) => (k in vars ? String(vars[k]) : w));

		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
		const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-resource]'));

		/*
			The server-rendered order is the "Featured" sort — featured entries first,
			then by curated `order`. Captured once, because sorting is about to move
			these nodes around and the original sequence is not recoverable after that.
		*/
		const curated = new Map(cards.map((card, i) => [card, i]));

		const text = (card: HTMLElement) =>
			`${card.dataset.title ?? ''} ${card.dataset.blurb ?? ''} ${(
				card.dataset.category ?? ''
			).toLowerCase()}`;

		const comparators: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
			featured: (a, b) => (curated.get(a) ?? 0) - (curated.get(b) ?? 0),
			/* Ties fall back to the curated order rather than to whatever the sort
			   happened to leave behind — every entry added on the same day would
			   otherwise shuffle between sorts. */
			newest: (a, b) =>
				(b.dataset.updated ?? '').localeCompare(a.dataset.updated ?? '') ||
				comparators.featured(a, b),
			title: (a, b) => (a.dataset.title ?? '').localeCompare(b.dataset.title ?? ''),
			shortest: (a, b) =>
				Number(a.dataset.pages ?? 0) - Number(b.dataset.pages ?? 0) ||
				comparators.featured(a, b),
		};

		let category = 'all';
		let query = '';

		const apply = () => {
			const q = query.trim().toLowerCase();
			let visible = 0;

			for (const card of cards) {
				const inCategory = category === 'all' || card.dataset.category === category;
				const inSearch = !q || text(card).includes(q);
				const match = inCategory && inSearch;
				card.hidden = !match;
				if (match) visible++;
			}

			for (const chip of chips) {
				chip.setAttribute('aria-pressed', String(chip.dataset.filter === category));
			}

			/* Reorder only what is on screen. Hidden cards keep their nodes in the
			   container and are re-sorted the moment they come back. */
			const order = comparators[sort.value] ?? comparators.featured;
			for (const card of [...cards].sort(order)) grid.append(card);

			empty.hidden = visible > 0;
			clear?.toggleAttribute('hidden', q.length === 0);

			const q2 = query.trim();
			if (q && category !== 'all') {
				status.textContent = fill(S.showingIn, { n: visible, category }) + " — " + q2;
				emptyText.textContent = fill(S.showingIn, { n: 0, category }) + " — " + q2;
			} else if (q) {
				status.textContent = fill(S.showingAll, { n: visible }) + " — " + q2;
				emptyText.textContent = S.nothingYet;
			} else if (category !== 'all') {
				status.textContent = fill(S.showingIn, { n: visible, category });
				emptyText.textContent = S.nothingYet;
			} else {
				status.textContent = fill(S.showingAll, { n: visible });
				emptyText.textContent = S.nothingYet;
			}

			/*
				Shareable state. `replaceState`, not `pushState` — a filter is not a
				page, and pushing one per keystroke would bury the back button under a
				hundred entries.
			*/
			const url = new URL(window.location.href);
			category === 'all'
				? url.searchParams.delete('category')
				: url.searchParams.set('category', category);
			q ? url.searchParams.set('q', query.trim()) : url.searchParams.delete('q');
			sort.value === 'featured'
				? url.searchParams.delete('sort')
				: url.searchParams.set('sort', sort.value);
			history.replaceState(null, '', url);
		};

		root.addEventListener('click', (event) => {
			const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
			if (!chip?.dataset.filter) return;
			category = chip.dataset.filter;
			apply();
		});

		search.addEventListener('input', () => {
			query = search.value;
			apply();
		});

		/* Nothing to submit — the results are already live. */
		searchForm?.addEventListener('submit', (event) => event.preventDefault());

		/* Escape clears the field, which is what a search input is expected to do
		   and what the native clear button does not do for keyboard users. */
		search.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !search.value) return;
			search.value = '';
			query = '';
			apply();
		});

		clear?.addEventListener('click', () => {
			search.value = '';
			query = '';
			search.focus();
			apply();
		});

		sort.addEventListener('change', apply);

		document.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
			category = 'all';
			query = '';
			search.value = '';
			apply();
			search.focus();
		});

		/* A shared link like /resources/?category=Operations&q=chatgpt&sort=newest
		   lands with all three already applied. */
		const params = new URL(window.location.href).searchParams;
		const initialCategory = params.get('category');
		const initialSort = params.get('sort');
		if (initialCategory && chips.some((chip) => chip.dataset.filter === initialCategory)) {
			category = initialCategory;
		}
		if (initialSort && initialSort in comparators) sort.value = initialSort;
		query = params.get('q') ?? '';
		search.value = query;
		if (category !== 'all' || query || sort.value !== 'featured') apply();
	}
</script>

<style>
	/* The banner, matching PageIntro's — see the note there. */
	.hero-lite {
		position: relative;
		isolation: isolate;
		overflow: clip;
		padding-block: calc(var(--nav-h, 4.5rem) + clamp(3rem, 8vw, 6rem)) clamp(2.5rem, 5vw, 4rem);
		background:
			radial-gradient(
				128% 92% at 50% 108%,
				color-mix(in oklab, var(--color-arc-500) 32%, transparent) 0%,
				color-mix(in oklab, var(--color-arc-600) 24%, transparent) 30%,
				color-mix(in oklab, var(--color-arc-700) 14%, transparent) 54%,
				color-mix(in oklab, var(--color-arc-700) 5%, transparent) 72%,
				transparent 88%
			),
			radial-gradient(
				96% 74% at 50% -12%,
				color-mix(in oklab, var(--color-arc-700) 18%, transparent) 0%,
				transparent 70%
			),
			linear-gradient(
				180deg,
				var(--color-ink-950) 0%,
				var(--color-ink-900) 46%,
				var(--color-ink-950) 100%
			);
		border-block-end: 1px solid var(--color-line);
	}

	/* The still, over the field. Lifted: the PNG is exposed for a full-bleed
	   hero and reads a stop under that at band height. */
	.hero-lite::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: url('/page_banner_r.png') 50% 64% / cover no-repeat;
		filter: brightness(1.75) saturate(1.2);
		/* Screen, so the wave adds its light to the field instead of covering
		   it — the dark half of the still then costs nothing. */
		mix-blend-mode: screen;
		/* And it fades out to the left, where the heading and lede sit. */
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.3) 28%,
			rgba(0, 0, 0, 0.74) 50%,
			#000 72%
		);
		mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.3) 28%,
			rgba(0, 0, 0, 0.74) 50%,
			#000 72%
		);
		pointer-events: none;
	}

	/* The two seams: under the nav at the top, into the next section below. */
	.hero-lite::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			180deg,
			var(--color-ink-950) 0%,
			color-mix(in oklab, var(--color-ink-950) 40%, transparent) 16%,
			transparent 40%,
			transparent 78%,
			color-mix(in oklab, var(--color-ink-950) 45%, transparent) 100%
		);
		pointer-events: none;
	}

	.band-falloff {
		position: relative;
		z-index: 1;
		height: clamp(5rem, 10vw, 8.5rem);
		margin-block-end: calc(-1 * clamp(5rem, 10vw, 8.5rem));
		pointer-events: none;
		background: linear-gradient(
			180deg,
			color-mix(in oklab, var(--color-arc-700) 30%, transparent) 0%,
			color-mix(in oklab, var(--color-arc-700) 14%, transparent) 34%,
			color-mix(in oklab, var(--color-arc-700) 5%, transparent) 62%,
			transparent 100%
		);
	}

	.hero-lite__title {
		margin: 0.75rem 0 0;
		font-size: var(--text-4xl);
		/* Display sizes want their own leading; the inherited body value opens a
		   hole between the lines this wraps to. */
		line-height: 1.06;
		/* 18ch when the headline was "The MOLAR resource library." The line is two
		   sentences now, and 18ch broke it into five very short ones. */
		max-width: 26ch;
	}

	.hero-lite__lede {
		margin: 1.25rem 0 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	.crumbs {
		margin-bottom: 1.75rem;
	}

	.crumbs__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.12em;
