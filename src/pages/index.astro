---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getLocale, useTranslations } from '~/i18n/utils';

import Hero from '~/components/sections/Hero.astro';
import TrustBand from '~/components/sections/TrustBand.astro';
import Ecosystem from '~/components/sections/Ecosystem.astro';
import SocialPlans from '~/components/sections/SocialPlans.astro';
import ContentShowcase from '~/components/sections/ContentShowcase.astro';
import ClientProof from '~/components/sections/ClientProof.astro';
import GlobalReach from '~/components/sections/GlobalReach.astro';
import GeoBand from '~/components/sections/GeoBand.astro';
import EducationLibrary from '~/components/sections/EducationLibrary.astro';
import MolarTv from '~/components/sections/MolarTv.astro';
import PatientJourney from '~/components/sections/PatientJourney.astro';
import CustomerStories from '~/components/sections/CustomerStories.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import ResourceHub from '~/components/sections/ResourceHub.astro';
import WhyMolar from '~/components/sections/WhyMolar.astro';
import Faq from '~/components/sections/Faq.astro';
import ProductSelector from '~/components/sections/ProductSelector.astro';
import FinalCta from '~/components/sections/FinalCta.astro';

import { faqSchema, productSchema } from '~/data/schema';

/*
	The home page is the hub of the funnel, in the order the master strategy
	sets out: state the category, prove it, offer the three ways in, then walk
	the whole ecosystem product by product and close.

	Every section below is a stop a visitor can be routed to. Four of them are
	the products — social, education, TV, complete — and each has a page of its
	own; the sections here are the argument for clicking through, not a
	replacement for the page.

	Two things are on this page that the strategy's section list does not name,
	and both are deliberate:

	  Faq         it already existed, it is linked from the Resources menu as
	              /#faq, and netlify.toml redirects /faq to that fragment. The
	              FAQPage structured data below is generated from the same array
	              the section renders, so the two cannot drift.
	  productSchema  the social plans are now on this page, with their prices
	              visible, so Product/Offer markup describes something a visitor
	              can actually see. That was not true of the old home page,
	              which is why the schema used to live only on /pricing/.

	What is NOT here: the agency comparison, the testimonial film, and the
	three-doors `ChoosePath` band. The comparison is a pricing argument and runs
	on /pricing/; the film runs on /social-media/, where the claim it makes
	belongs; and ChoosePath was a second price list stacked directly on top of
	the real one — two grids of figures back to back, the first of them a
	summary of the second. The page states its prices once, in `SocialPlans`,
	and `ProductSelector` further down still asks the three-doors question at the
	point where a visitor is choosing. ChoosePath itself still runs on
	/molar-complete/, where nothing else carries a price.
*/
const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<BaseLayout
	title={t('pages.homeTitle')}
	description={t('pages.homeDesc')}
	ogImage={{
		src: '/images/og/home.png',
		alt: 'MOLAR — the content engine for modern dental practices',
		width: 1200,
		height: 630,
	}}
	type="website"
	transparentNav
	schema={[productSchema(locale), faqSchema()]}
>
	<Hero />
	<TrustBand />
	<Ecosystem />
	<SocialPlans />
	<ContentShowcase />
	<ClientProof />
	<GlobalReach />
	<GeoBand />
	<EducationLibrary />
	<MolarTv />
	<PatientJourney />
	<CustomerStories />
	<Testimonials />
	<ResourceHub />
	<WhyMolar />
	<Faq />
	<ProductSelector />
	<FinalCta />
</BaseLayout>
