---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getLocale, useTranslations } from '~/i18n/utils';

import Hero from '~/components/sections/Hero.astro';
import VideoReel from '~/components/sections/VideoReel.astro';
import GlobalReach from '~/components/sections/GlobalReach.astro';
import AssetFilm from '~/components/sections/AssetFilm.astro';
import Comparison from '~/components/sections/Comparison.astro';
import Faq from '~/components/sections/Faq.astro';
import { faqSchema } from '~/data/schema';
import ClosingCta from '~/components/sections/ClosingCta.astro';


/*
	The page is the hero, the reel, the reach band, the film, the agency
	comparison and the footer — nothing else.
	The sections that used to run below them still exist under
	`src/components/sections/`, unimported; the scaffold routes left in the nav
	are where that material is headed.

	No outcome claim on this page any more. The proof band that used to sit under
	the reel has been removed — the numbers and the screenshots live on /results/,
	which the nav already points at, and the home page is the work rather than the
	argument about it.

	No `productSchema()` or `faqSchema()` here any more. Both describe content —
	prices, offers, questions and answers — that is no longer on the page, and
	structured data that a visitor cannot see is a manual action waiting to
	happen. Organization and WebSite are still added by the layout, for every
	page, and neither depends on what the body holds.
*/
const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<BaseLayout
	title={t('pages.homeTitle')}
	description={t('site.description')}
	ogImage={{
		src: '/images/og/home.png',
		alt: 'MOLAR AI — the easiest way to educate patients online',
		width: 1200,
		height: 630,
	}}
	type="website"
	transparentNav
	schema={[faqSchema()]}
>
	<Hero />
	<VideoReel />
	<GlobalReach />
	<AssetFilm />
	<Comparison />
	<Faq />
	<ClosingCta />
</BaseLayout>
