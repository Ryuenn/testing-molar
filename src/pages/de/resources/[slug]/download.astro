---
/*
	German route for the resource pages.

	Unlike the static mirrors beside it this one also re-exports getStaticPaths:
	a dynamic route generates nothing without it, so /de/resources/<slug>/ would
	simply not exist and every card on the German hub would link to a 404 — which
	is exactly what the link audit caught.

	The page itself is the English component; its chrome localises from
	Astro.currentLocale. The document titles and blurbs stay English on purpose —
	the PDFs behind them are English. See the note at the top of ~/i18n/ui.
*/
import Page, { getStaticPaths as paths } from '../../../resources/[slug]/download.astro';

export const getStaticPaths = paths;
---

<Page {...Astro.props} />
