---
/**
 * The three social marks, drawn.
 *
 * Brand logos, so unlike `StepIcon` these are not all one stroke weight — each
 * is the shape its owner actually uses. Instagram is a line drawing, YouTube and
 * TikTok are solid. They are matched by optical weight instead: the solid marks
 * sit slightly inside the 24px box so they do not read heavier than the outlined
 * one beside them.
 *
 * YouTube's play triangle is a hole punched with `fill-rule: evenodd`, not a
 * second path filled with the page colour. A knockout painted in the background
 * colour is a bug waiting for the day something else sits behind it.
 *
 * Everything is `currentColor`, so the row is tinted by the link that holds it.
 * Decorative: each of these is wrapped by a link that carries its own name.
 */
export interface Props {
	name: 'instagram' | 'tiktok' | 'youtube';
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
	{
		name === 'instagram' && (
			<>
				<rect
					x="3.2"
					y="3.2"
					width="17.6"
					height="17.6"
					rx="5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
				/>
				<circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.7" />
				<circle cx="17.1" cy="6.9" r="1.15" />
			</>
		)
	}

	{
		name === 'youtube' && (
			<path
				fill-rule="evenodd"
				d="M21.6 7.2a2.6 2.6 0 0 0-1.83-1.84C18.15 4.92 12 4.92 12 4.92s-6.15 0-7.77.44A2.6 2.6 0 0 0 2.4 7.2 27.2 27.2 0 0 0 1.97 12a27.2 27.2 0 0 0 .43 4.8 2.6 2.6 0 0 0 1.83 1.84c1.62.44 7.77.44 7.77.44s6.15 0 7.77-.44a2.6 2.6 0 0 0 1.83-1.84A27.2 27.2 0 0 0 22.03 12a27.2 27.2 0 0 0-.43-4.8ZM10.15 15.02V8.98L15.28 12l-5.13 3.02Z"
			/>
		)
	}

	{
		name === 'tiktok' && (
			<path d="M16.62 3h-2.98v12.05a2.43 2.43 0 0 1-2.43 2.4 2.43 2.43 0 1 1 .66-4.77V9.6a5.6 5.6 0 0 0-.66-.04 5.72 5.72 0 1 0 5.72 5.72V9.06a7.04 7.04 0 0 0 4.11 1.32V7.4a4.14 4.14 0 0 1-4.42-4.4Z" />
		)
	}
</svg>

<style>
	/*
		Fills whatever box the caller gives it. Sizing this from the parent would
		not work: Astro scopes styles per component, so a `.footer__social svg`
		rule written in Footer compiles to a selector this element can never match.
	*/
	svg {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
