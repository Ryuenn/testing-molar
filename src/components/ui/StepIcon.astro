---
/**
 * The marks on the hero's flow cards and on the how-it-works rail.
 *
 * Drawn rather than imported: at the size these render, a stroked path with the
 * site's own weight and cap style reads cleaner than any icon set, and it keeps
 * the page free of another asset request. One shape each — the reference
 * stacked two glyphs per card, which turns to mush below about 40px.
 *
 * All of them are built on the same 24px box with the same 1.4 stroke, so they
 * sit at one optical weight when a row of them is seen together. That is the
 * whole reason for keeping them in one file instead of inlining each where it
 * is used.
 */
export interface Props {
	name: 'bell' | 'link' | 'megaphone' | 'card' | 'sliders' | 'video';
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.4"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'bell' && (
			<>
				<path d="M6.4 15.2V9.8a5.6 5.6 0 0 1 11.2 0v5.4l1.6 2.6H4.8l1.6-2.6Z" />
				<path d="M10 20.4a2.2 2.2 0 0 0 4 0" />
				<path d="M12 4.2V2.6" />
			</>
		)
	}

	{
		name === 'link' && (
			<>
				<path d="M9.6 14.4 14.4 9.6" />
				<path d="M10.6 7.4 12.5 5.5a3.7 3.7 0 0 1 5.2 5.2l-1.9 1.9" />
				<path d="M13.4 16.6l-1.9 1.9a3.7 3.7 0 0 1-5.2-5.2l1.9-1.9" />
			</>
		)
	}

	{
		name === 'card' && (
			<>
				<rect x="2.6" y="5.4" width="18.8" height="13.2" rx="2.4" />
				<path d="M2.6 10.2h18.8" />
				<path d="M6.2 14.8h3.4" />
			</>
		)
	}

	{
		name === 'sliders' && (
			<>
				<path d="M4.4 7.2h15.2M4.4 12h15.2M4.4 16.8h15.2" />
				<circle cx="9.2" cy="7.2" r="2" />
				<circle cx="15.4" cy="12" r="2" />
				<circle cx="7.6" cy="16.8" r="2" />
			</>
		)
	}

	{
		name === 'video' && (
			<>
				<rect x="2.6" y="5" width="18.8" height="14" rx="2.4" />
				<path d="M2.6 9.4h18.8" />
				<path d="M7.1 5.2 5.6 9.3M12 5.2l-1.5 4.1M16.9 5.2l-1.5 4.1" />
				<path d="M10.4 12.4v3.6l3.4-1.8-3.4-1.8Z" fill="currentColor" stroke="none" />
			</>
		)
	}

	{
		name === 'megaphone' && (
			<>
				<path d="M4.2 9.6h2.9l8.6-3.8v12.4L7.1 14.4H4.2a1.6 1.6 0 0 1-1.6-1.6v-1.6a1.6 1.6 0 0 1 1.6-1.6Z" />
				<path d="M7.6 14.6 8.7 19.4h2.2l-1.1-4.8" />
				<path d="M18.6 9.4a4 4 0 0 1 0 5.2" />
			</>
		)
	}
</svg>

<style>
	/*
		Fills whatever box the caller gives it. Sizing this from the parent would
		not work: Astro scopes styles per component, so a `.flow__icon svg` rule
		written in Hero compiles to a selector this element can never match.
	*/
	svg {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
