---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

/**
 * Repeatable — every case study renders through this. More are coming, so the
 * only thing a new one needs is a markdown file in `src/content/case-studies/`.
 */
export interface Props {
	entry: CollectionEntry<'caseStudies'>;
	/** First one on the page gets the h2; the rest are h3 under it. */
	headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<article class="case" data-reveal>
	<div class="case__meta">
		<p class="eyebrow">{data.practice}</p>
		<p class="case__place">{data.location} &middot; {data.specialty}</p>
	</div>

	<Heading class="case__headline">{data.headline}</Heading>

	<div class="case__narrative">
		<Content />
	</div>

	{
		data.image && (
			<div class="case__figure">
				<Image
					src={data.image}
					alt={data.imageAlt ?? `${data.practice} — case study`}
					widths={[300, 450, 600]}
					sizes="(min-width: 960px) 300px, (min-width: 640px) 40vw, 80vw"
					loading="lazy"
					decoding="async"
					class="case__image"
				/>
			</div>
		)
	}

	<div class="case__contrast">
		<section class="case__col case__col--before" aria-labelledby={`${entry.id}-before`}>
			<h4 class="case__col-title" id={`${entry.id}-before`}>
				<span class="case__col-tag">Before</span>
			</h4>
			<ul class="case__list">
				{data.before.map((item) => <li class="case__item">{item}</li>)}
			</ul>
		</section>

		<div class="case__divider" aria-hidden="true">
			<svg viewBox="0 0 20 12" fill="none" stroke="currentColor" stroke-width="1.3">
				<path d="M0 6h17M13 2l4 4-4 4"></path>
			</svg>
		</div>

		<section class="case__col case__col--after" aria-labelledby={`${entry.id}-after`}>
			<h4 class="case__col-title" id={`${entry.id}-after`}>
				<span class="case__col-tag case__col-tag--after">After</span>
			</h4>
			<ul class="case__list">
				{
					data.after.map((item) => (
						<li class="case__item case__item--after">{item}</li>
					))
				}
			</ul>
		</section>
	</div>

	<p class="case__stat">
		<span class="case__stat-value">{data.stat.value}</span>
		<span class="case__stat-label">{data.stat.label}</span>
	</p>
</article>

<style>
	.case {
		display: grid;
		gap: clamp(1.75rem, 3vw, 2.5rem);
		padding: clamp(1.75rem, 4vw, 3rem);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-lg);
		background: linear-gradient(180deg, var(--color-ink-850), var(--color-ink-950));
	}

	.case__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}

	.case__meta .eyebrow {
		margin: 0;
	}

	.case__place {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	.case__headline {
		margin: 0;
		font-size: var(--text-2xl);
		max-width: 24ch;
	}

	.case__narrative :global(p) {
		margin: 0;
		max-width: 58ch;
		color: var(--color-bone-400);
	}

	.case__figure {
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-ink-900);
	}

	.case__image {
		width: 100%;
		height: auto;
	}

	/* ── Before / after ───────────────────────────────────────────────────── */
	.case__contrast {
		display: grid;
		gap: 1.5rem;
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--color-line);
	}

	.case__col-title {
		margin: 0 0 1rem;
	}

	.case__col-tag {
		display: inline-block;
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--color-line-strong);
		border-radius: var(--radius-xs);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	.case__col-tag--after {
		border-color: color-mix(in oklab, var(--color-arc-400) 45%, transparent);
		color: var(--color-arc-300);
	}

	.case__list {
		display: grid;
		gap: 0.7rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.case__item {
		position: relative;
		padding-inline-start: 1.1rem;
		font-size: var(--text-sm);
		color: var(--color-bone-500);
	}

	.case__item::before {
		content: '';
		position: absolute;
		inset-block-start: 0.62em;
		inset-inline-start: 0;
		width: 0.3rem;
		height: 1px;
		background: currentColor;
	}

	.case__item--after {
		color: var(--color-bone-100);
	}

	.case__item--after::before {
		width: 0.375rem;
		height: 0.375rem;
		inset-block-start: 0.5em;
		border-radius: 50%;
		background: var(--color-arc-400);
	}

	.case__divider {
		display: none;
		align-self: center;
		width: 1.5rem;
		color: var(--color-arc-500);
	}

	/* ── Stat ─────────────────────────────────────────────────────────────── */
	.case__stat {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.85rem;
		margin: 0;
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--color-line);
	}

	.case__stat-value {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--color-arc-300);
	}

	.case__stat-label {
		font-size: var(--text-sm);
		color: var(--color-bone-400);
	}

	@media (min-width: 700px) {
		.case__contrast {
			grid-template-columns: 1fr auto 1fr;
			gap: clamp(1.5rem, 3vw, 2.5rem);
		}

		.case__divider {
			display: block;
		}
	}

	@media (min-width: 960px) {
		/*
			The still is portrait — it is a reel frame, and cropping it to landscape
			would throw that away. So instead of pairing it with the narrative alone
			(a short paragraph beside a tall image leaves a column of dead space), it
			runs as a rail down the side of the headline, narrative and before/after
			together, where its height is doing work.
		*/
		.case {
			grid-template-columns: minmax(0, 1fr) 300px;
			column-gap: clamp(2rem, 4vw, 3.5rem);
			grid-template-areas:
				'meta     meta'
				'headline figure'
				'story    figure'
				'contrast figure'
				'stat     stat';
			align-content: start;
		}

		.case__meta {
			grid-area: meta;
		}
		.case__headline {
			grid-area: headline;
		}
		.case__narrative {
			grid-area: story;
		}
		.case__figure {
			grid-area: figure;
			align-self: stretch;
		}
		.case__contrast {
			grid-area: contrast;
		}
		.case__stat {
			grid-area: stat;
		}

		/* Fill the rail however tall the left column ends up. */
		.case__image {
			height: 100%;
			object-fit: cover;
			object-position: 50% 35%;
		}
	}
</style>
