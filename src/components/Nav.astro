---
/**
 * Primary navigation — one floating bar.
 *
 *   <Nav transparent />
 *
 * A single rounded bar held off the window's edges, carrying the brand lockup
 * at one end, the links across the middle, and the right-hand cluster
 * (language switcher + blue CTA) at the other. The bar is frosted
 * glass: a wash of cool grey over translucent ink with the page blurred behind
 * it, thickening once the hero has scrolled past.
 *
 * The material is defined once, as the `--pill-*` custom properties on `.nav`,
 * and worn by the bar, the language switcher and the mobile toggle, so all
 * three read as cut from the same sheet.
 *
 * ── The mega panels ────────────────────────────────────────────────────────
 * Two of the five stops open a panel: Products and Resources. Both are still
 * links to a real page — the panel is an expansion of the stop, not a
 * replacement for it — so a crawler, a keyboard user who never opens it, and
 * anyone with JS off all still reach the page underneath.
 *
 * The disclosure is a separate <button> beside the link rather than the link
 * itself, because one control cannot both navigate and toggle. That split is
 * what makes the whole thing work without JavaScript for the common case: CSS
 * opens the panel on hover and on `:focus-within`, so a mouse user and a
 * keyboard user both get it. The button and its `aria-expanded` exist for touch,
 * where there is no hover to open it with, and the script below is the only
 * thing that reads them.
 *
 * Slots
 *   brand    logo lockup (defaults to the mark + wordmark below)
 *   links    full replacement for the generated link list
 *   actions  right-hand cluster (defaults to language + CTA + toggle)
 *
 * Contract the rest of the site relies on:
 *   - renders a landmark <header> containing a labelled <nav>
 *   - `--nav-h` is published on :root; `scroll-padding-top` in global.css and
 *     the hero's `min-height` both read from it
 *   - `data-nav-transparent` is toggled off once the page scrolls past the hero,
 *     driven by the ScrollTrigger in `src/scripts/motion.ts`
 *
 * Below 1100px the same link list becomes a dropdown panel behind the toggle
 * button. One list, restyled — never two copies of the links in the DOM.
 */
import { Image } from 'astro:assets';
/*
	The trimmed derivative, not the master.

	`logo-molar.png` is the delivered art and carries ~8% empty margin on every
	side. At the 30px this renders at, that margin is three pixels of nothing on
	each edge — enough to make the mark read visibly smaller than the wordmark
	beside it, and no amount of CSS can see padding baked into a raster.
	`scripts/generate-icons.mjs` trims the master into `logo-mark.png` for
	exactly this; re-run `npm run icons` after replacing the master.
*/
import logoTooth from '~/assets/brand/logo-mark.png';
import Glyph from '~/components/ui/Glyph.astro';
import { CTA, NAV_LINKS } from '~/data/site';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

export interface Props {
	/** Hero pages start transparent and solidify on scroll. */
	transparent?: boolean;
	class?: string;
}

const locale = getLocale(Astro);
const t = useTranslations(locale);

const { transparent = false, class: className = '' } = Astro.props;

/*
	Built per render rather than imported ready-made: both the label and the href
	depend on the locale, and a shared constant could only ever carry one of
	each. `localizePath` is what keeps a German visitor inside German when they
	click through the nav.
*/
const links = NAV_LINKS.map((entry) => ({
	key: entry.key,
	label: t(`nav.${entry.key}` as 'nav.home'),
	/* Undefined stays undefined — a menu-only stop has no destination to
	   localise, and the markup below branches on exactly that. */
	href: entry.href ? localizePath(entry.href, locale) : undefined,
	menu: entry.menu?.map((item) => ({
		icon: item.icon,
		label: t(`nav.${item.key}` as 'nav.menuSocial'),
		sub: t(`nav.${item.key}Sub` as 'nav.menuSocialSub'),
		/*
			`localizePath` is path-only and leaves a query string alone, which is
			what the resource-hub deep links need — `/resources/?category=…` has to
			survive into `/de/resources/?category=…` with the query intact.
		*/
		href: localizePath(item.href, locale),
	})),
	menuFoot: entry.menuFoot
		? {
				label: t(`nav.${entry.menuFoot.key}` as 'nav.menuHow'),
				href: localizePath(entry.menuFoot.href, locale),
			}
		: undefined,
}));

/*
	Which link is the page you are on.

	`trailingSlash: 'always'`, so both sides normally arrive with one — but a
	hand-typed or dev-server URL can turn up without, and a link that fails to
	light up over a missing slash is worse than no highlight at all.
*/
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const here = withSlash(Astro.url.pathname);
const homeHref = withSlash(localizePath('/', locale));

/*
	A section lights for its children too — reading /resources/qr-follow-kit/
	still means you are in Resources. Home is exempt from the prefix test for the
	obvious reason: every path on the site starts with it.

	A stop with a panel also lights for anything inside the panel, so Products
	lights on /social-media/ and on /molar-tv/ even though neither is a prefix of
	its own href.
*/
const matches = (href: string) => {
	/* Query strings are filters on a page, not pages. Strip before comparing or
	   `/resources/?category=…` never matches `/resources/`. */
	const target = withSlash(href.split('?')[0]);
	if (here === target) return true;
	return target !== homeHref && here.startsWith(target);
};

/* A menu-only stop has no href of its own, so it lights for its children alone
   — which is the behaviour the section already had, minus the parent page. */
const isCurrent = (link: (typeof links)[number]) =>
	(link.href ? matches(link.href) : false) ||
	(link.menu?.some((item) => matches(item.href)) ?? false);

---

<header
	class:list={['nav', className]}
	data-nav
	data-nav-transparent={transparent ? '' : undefined}
>
	{/*
		Deliberately not a .container-content. The nav runs wider than the page's
		76rem measure so the brand sits out at the window's edge and the actions
		sit out at the other — see .nav__inner.
	*/}
	<div class="nav__inner">
		<slot name="brand">
			{/*
				No aria-label here. An aria-label would override the visible wordmark
				with a string that does not contain it, which fails the
				label-in-name check — a real problem for anyone driving the page by
				voice. The name is built from content instead, with the destination
				appended for screen readers only.
			*/}
			<a href={localizePath('/', locale)} class="nav__brand">
				{/*
					The tooth, ahead of the wordmark. Decorative: the wordmark beside it
					already names the company, and an alt here would have a screen reader
					say "MOLAR MOLAR".
				*/}
				<Image
					src={logoTooth}
					alt=""
					height={30}
					densities={[1, 2]}
					loading="eager"
					decoding="sync"
					class="nav__tooth"
				/>

				{/*
					Live text, not the wordmark PNG.

					The image was a raster of the same five letters: soft at every size
					the nav is not, carrying visible compression artefacts around the
					glyph edges, and an extra request for something the page already has
					the typeface for. As text it is sharp at any zoom, recolours with the
					theme, and IS the link's accessible name — which is why the
					`.nav__brand` carries no aria-label.

					MOLARAI — one word, no space and no point.

					It has been three things: `MOLAR.AI` originally, then `MOLAR TV` per
					the 09/01 brief ("Should say MOLAR TV instead of MOLAR.AI on the top
					next to the logo"), and now this. The brand is the company again
					rather than the product; the footer says `MOLAR` and the copyright
					line says `MOLAR AI`, which is the legal name.

					`AI` is a span rather than a second element so the whole thing stays
					one selectable, copyable string — `MOLARAI`, not `MOLAR` + `AI` with
					a break the clipboard can find. Only its colour differs. No `&nbsp;`
					and no separator of any kind: a space here is what the brief called
					out the first time round.
				*/}
				<span class="nav__wordmark">MOLAR<span class="nav__wordmark-ai">AI</span></span>
				<span class="sr-only">{t('nav.toHome')}</span>
			</a>
		</slot>

		<nav aria-label={t('nav.label')} class="nav__nav" id="nav-menu" data-nav-menu>
			<slot name="links">
				<ul class="nav__links">
					{
						links.map((link) => (
							<li class:list={['nav__item', link.menu && 'nav__item--menu']} data-nav-item>
								<div class="nav__row">
									{/*
										A link only where there is somewhere to go. A menu-only stop
										renders its label as plain text — the chevron beside it is
										the control, and on desktop the panel opens on hover and on
										focus-within anyway, so nothing is lost by the word itself
										not being clickable.
									*/}
									{link.href ? (
										<a
											href={link.href}
											class="nav__link"
											aria-current={isCurrent(link) ? 'page' : undefined}
										>
											{link.label}
										</a>
									) : (
										<span class="nav__link nav__link--static">{link.label}</span>
									)}

									{link.menu && (
										<button
											type="button"
											class="nav__disc"
											aria-expanded="false"
											aria-controls={`nav-panel-${link.key}`}
											aria-label={t('nav.openMenu', { name: link.label })}
											data-nav-disc
										>
											<svg
												viewBox="0 0 12 12"
												fill="none"
												stroke="currentColor"
												stroke-width="1.6"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<path d="m3 4.75 3 3 3-3" />
											</svg>
										</button>
									)}
								</div>

								{link.menu && (
									<div class="mega" id={`nav-panel-${link.key}`} data-nav-panel>
										<ul class="mega__list">
											{link.menu.map((item) => (
												<li>
													<a class="mega__item" href={item.href}>
														<span class="mega__icon" aria-hidden="true">
															<Glyph name={item.icon} />
														</span>
														<span class="mega__body">
															<span class="mega__label">{item.label}</span>
															<span class="mega__sub">{item.sub}</span>
														</span>
													</a>
												</li>
											))}
										</ul>

										{link.menuFoot && (
											<a class="mega__foot" href={link.menuFoot.href}>
												{link.menuFoot.label} <span aria-hidden="true">→</span>
											</a>
										)}
									</div>
								)}
							</li>
						))
					}
				</ul>
			</slot>

			{/*
				No language control, in either of the two homes this nav used to give
				one. The En/De chips went with the German route tree; the Google
				Translate widget that briefly replaced them is gone too. The site is
				published in English and says so with `<html lang="en">` — a browser
				that wants to translate it already offers to.
			*/}
		</nav>

		<div class="nav__actions">
			<slot name="actions">
				{/*
					Rendered only once there is somewhere for it to go. `PORTAL_LOGIN`
					is empty in this repo and the client portal's URL is not in it — a
					header link to a page that does not load is worse than no link at
					all. See the note on the constant in ~/data/site.
				*/}
				<a href={localizePath(CTA.primary.href, locale)} class="nav__cta">
					<span>{t('cta.start')}</span>
					{/* Decorative twin of the label — the link already reads "Start now". */}
					<span class="nav__cta-badge" aria-hidden="true">
						<svg
							viewBox="0 0 14 14"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M2.5 7h8M7 3.5 10.5 7 7 10.5" />
						</svg>
					</span>
				</a>

				{/*
					Only reachable below 1100px, where CSS collapses the link pill into
					a dropdown. Above that it is display:none and out of the a11y tree,
					so its aria-expanded can never contradict a permanently open menu.
				*/}
				<button
					type="button"
					class="nav__toggle"
					aria-expanded="false"
					aria-controls="nav-menu"
					aria-label={t('nav.menu')}
					data-nav-toggle
				>
					<span class="nav__toggle-bars" aria-hidden="true">
						<span></span>
						<span></span>
					</span>
				</button>
			</slot>
		</div>
	</div>
</header>

<script>
	/*
		Two disclosures, and they are separate mechanisms on purpose.

		  · the mobile dropdown — `data-nav-open` on the header
		  · the two mega panels — `data-open` on their own <li>

		Both are single sources of truth that CSS reads and `aria-expanded` is
		mirrored from, so markup and state cannot drift apart. Neither is required
		for the panels to work with a mouse or a keyboard: `:hover` and
		`:focus-within` already open them above the breakpoint. This is what makes
		them reachable by touch, where there is no hover.
	*/
	const nav = document.querySelector<HTMLElement>('[data-nav]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-nav-menu]');
	const items = [...document.querySelectorAll<HTMLElement>('[data-nav-item]')].filter((item) =>
		item.querySelector('[data-nav-disc]'),
	);

	const closeAllPanels = (except?: HTMLElement) => {
		items.forEach((item) => {
			if (item === except) return;
			item.removeAttribute('data-open');
			item.querySelector('[data-nav-disc]')?.setAttribute('aria-expanded', 'false');
		});
	};

	items.forEach((item) => {
		const disc = item.querySelector<HTMLButtonElement>('[data-nav-disc]');
		if (!disc) return;

		disc.addEventListener('click', () => {
			const open = !item.hasAttribute('data-open');
			/* One panel at a time. Two open at once overlap on a narrow desktop. */
			closeAllPanels(item);
			item.toggleAttribute('data-open', open);
			disc.setAttribute('aria-expanded', String(open));
		});
	});

	if (nav && toggle && menu) {
		const desktop = window.matchMedia('(min-width: 1100px)');

		const setOpen = (open: boolean) => {
			nav.toggleAttribute('data-nav-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			if (!open) closeAllPanels();
		};

		toggle.addEventListener('click', () => {
			setOpen(!nav.hasAttribute('data-nav-open'));
		});

		/* Following a link closes everything. The disclosure buttons are not
		   links, so their clicks must not trip this. */
		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;

			/* An open mega panel is the innermost thing, so it closes first — and
			   focus goes back to the button that opened it rather than being
			   stranded inside a panel that just vanished. */
			const openItem = items.find((item) => item.hasAttribute('data-open'));
			if (openItem) {
				closeAllPanels();
				openItem.querySelector<HTMLButtonElement>('[data-nav-disc]')?.focus();
				return;
			}

			if (!nav.hasAttribute('data-nav-open')) return;
			setOpen(false);
			toggle.focus();
		});

		document.addEventListener('pointerdown', (event) => {
			if (nav.contains(event.target as Node)) return;
			closeAllPanels();
			if (nav.hasAttribute('data-nav-open')) setOpen(false);
		});

		/*
			Crossing into the desktop layout un-collapses the links on its own. Drop
			the state too, or the toggle comes back claiming an open menu.
		*/
		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>

<style>
	/* `--nav-h` is declared on :root in global.css — a :root rule inside a scoped
	   <style> block would be scoped along with everything else and never match. */
	.nav {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		z-index: 50;
		height: var(--nav-h);
		display: flex;
		align-items: center;
		/*
			The header is empty air. The glass is the pill behind the links, not a
			band across the window — so only the pills should swallow a click, or
			an invisible full-width strip sits on top of the page at every scroll
			position.
		*/
		pointer-events: none;
		/*
			The glass, defined once and worn by every pill so they read as one
			material. Three parts:

			  --pill-bg     the ground. Only enough ink to keep light copy legible
			                over moving video; the blur does most of that work.
			  --pill-sheen  a wash of cool grey. This is what makes the pill read
			                as grey glass rather than as tinted navy — ink alone
			                only ever goes darker, and glass catches light.
			  --pill-edge   the lit top edge, at the threshold of visible.
		*/
		--pill-bg: color-mix(in oklab, var(--color-ink-950) 8%, transparent);
		--pill-sheen: linear-gradient(
			180deg,
			color-mix(in oklab, #cfe0f5 10%, transparent) 0%,
			color-mix(in oklab, #a3adbd 4%, transparent) 58%,
			color-mix(in oklab, #7aa2d8 7%, transparent) 100%
		);
		--pill-edge: inset 0 1px 0 color-mix(in oklab, #e6ecf5 16%, transparent);
		/* Heavier than before, and it has to be: with this little ink left, the
		   blur is the only thing keeping light copy off a moving frame. */
		--pill-blur: blur(10px) saturate(150%);
	}

	/*
		Over the hero only the ground thins, so the footage reads through it. The
		sheen and the blur stay — between them they keep the links legible over
		moving video without darkening the pill until it reads as a solid chip.
	*/
	.nav[data-nav-transparent] {
		--pill-bg: color-mix(in oklab, var(--color-ink-950) 10%, transparent);
	}

	/*
		Legibility scrim, and only once the hero is behind us — over the hero it
		is at zero, which is what keeps the header clear.

		It has to hang below the header. Ending it at `bottom: 0` slices whatever
		is passing underneath clean in half at the 84px mark — a heading cut
		through the middle, worse than no scrim at all. The extra 3.5rem is where
		the page fades back in.
	*/
	.nav::before {
		content: '';
		position: absolute;
		inset: 0 0 -3.5rem;
		pointer-events: none;
		background: linear-gradient(
			180deg,
			var(--color-ink-950) 0%,
			color-mix(in oklab, var(--color-ink-950) 97%, transparent) 44%,
			color-mix(in oklab, var(--color-ink-950) 84%, transparent) 62%,
			color-mix(in oklab, var(--color-ink-950) 46%, transparent) 82%,
			transparent 100%
		);
		transition: opacity 0.4s var(--ease-out-quint);
	}

	.nav[data-nav-transparent]::before {
		opacity: 0;
	}

	/*
		Its own measure, wider than .container-content's 76rem. The page's copy is
		held to a readable column; the nav is furniture and belongs at the window's
		edges, which is where the brand and the actions end up. The cap keeps an
		ultrawide monitor from pushing them a foot apart.

		Symmetric by construction — equal gutters, auto margins — so the centred
		grid track below still lands on the page's centre line.
	*/
	.nav__inner {
		position: relative;
		/* The bar is the only thing up here that takes a click — the air either
		   side of it stays transparent to the page. */
		pointer-events: auto;
		/*
			The same box as `.container-content`, so the bar's EDGE lands exactly
			where the page's content edge does.

			It used to run to 112rem against the page's 76rem, which put the wordmark
			about three hundred pixels left of the first letter of every <h1> — the bar
			and the page read as two grids rather than one. Matching the measure is what
			lines them up.

			── The inset is the bar's, not the page's ─────────────────────────────
			`padding-inline` was `var(--gutter)` — up to 3.5rem, the same padding
			`.container-content` carries. That is the right inset for a container
			that is invisible, and the wrong one for a pill you can see: it put 56px
			of empty glass between the rounded edge and the wordmark, against 9px
			above and below the button. Air on one axis and none on the other reads
			as a mistake, because it is one.

			So the pill keeps the container's WIDTH — its edge still lines up with
			the page — and takes its own inset, sized to clear the 1rem corner
			radius and to sit near the button's own vertical breathing room. The
			brand no longer starts on the <h1>'s first letter; the bar it lives in
			does, which is the alignment a reader can actually see.
		*/
		width: 100%;
		max-width: var(--container-content);
		margin-inline: auto;
		height: 3.5rem;
		padding-inline: clamp(0.75rem, 1.2vw, 1rem);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-radius: 1rem;
		border: 1px solid color-mix(in oklab, #cfe0f5 11%, transparent);
		background-color: var(--pill-bg);
		background-image: var(--pill-sheen);
		backdrop-filter: var(--pill-blur);
		box-shadow:
			var(--pill-edge),
			/* The underside, so the sheet reads as having a thickness. */ inset 0 -1px 0
				color-mix(in oklab, #05070d 30%, transparent),
			0 24px 60px -34px #000;
		transition: background-color 0.4s var(--ease-out-quint);
	}

	/* ── Brand ───────────────────────────────────────────────────────────── */
	.nav__brand {
		pointer-events: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.0625rem;
		letter-spacing: 0.02em;
		color: var(--color-bone-50);
	}

	/*
		No tile behind it. The lockup is white type on transparency — box it in
		frosted glass and it reads as an app icon rather than as a logo. It sits
		bare, and a soft glow is what separates it from the hero video running
		underneath the transparent nav.

		1.375rem, not the 2.25rem the old tooth mark took. That mark was a square
		object whose height was its whole size; this is a 7.2:1 wordmark, and at
		2.25rem it would run 260px wide and crowd the links.
	*/
	/*
		The wordmark, set rather than drawn. `.nav__brand` already carries the
		display face and the weight; this is the size and the tracking that make it
		read as a mark instead of as a nav link.
	*/
	.nav__wordmark {
		font-size: 1.375rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1;
		white-space: nowrap;
		color: var(--color-bone-50);
	}

	/* The one difference between the two halves. Arc-400 rather than the brighter
	   300: it sits beside white at the same weight, and 300 reads as a highlight
	   rather than as part of the same word. */
	.nav__wordmark-ai {
		color: var(--color-arc-400);
		transition: color 0.24s var(--ease-out-quint);
	}

	/*
		The tooth, ahead of the wordmark.

		Taller than the wordmark rather than matched to it: this is a near-square
		object whose height IS its size, and at the wordmark's 1.375rem it would
		read as a smaller thing than the letters beside it. It carries its own glow
		already, so it takes a lighter drop-shadow than the wordmark does.
	*/
	.nav__tooth {
		flex: none;
		width: auto;
		height: 1.875rem;
		filter: drop-shadow(0 0 12px color-mix(in oklab, var(--color-arc-500) 55%, transparent));
		transition: filter 0.24s var(--ease-out-quint);
	}

	/* Hover feedback lives on the glow, since there is no longer a border to
	   pick up. */
	.nav__brand:hover .nav__tooth {
		filter: drop-shadow(0 0 18px color-mix(in oklab, var(--color-arc-400) 80%, transparent));
	}

	/* The lettering answers in colour rather than in glow — a drop-shadow on live
