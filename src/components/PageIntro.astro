---
/**
 * The top of an inner page: breadcrumb, eyebrow, h1, lede.
 *
 *   <PageIntro eyebrow="Our work" title="…" lede="…" crumb="Our work" />
 *
 * The nav is opaque on these pages (no `transparentNav`), so this band only has
 * to clear it rather than sit under it — the padding accounts for `--nav-h`
 * either way, because the nav is fixed and out of flow on every page.
 *
 * Breadcrumb markup only; the matching JSON-LD is `breadcrumbSchema()` in
 * `~/data/schema`, which the page passes to BaseLayout separately. The two are
 * deliberately not coupled: a visible breadcrumb without structured data is
 * fine, structured data describing a breadcrumb that is not on the page is not.
 */
export interface Props {
	/** Small mono line above the heading. */
	eyebrow?: string;
	title: string;
	lede?: string;
	/** Trailing crumb label. Defaults to the title. */
	crumb?: string;
}

import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const { eyebrow, title, lede, crumb } = Astro.props;
---

<section class="intro lit-band" aria-labelledby="page-heading">
	<div class="container-content">
		<nav aria-label="Breadcrumb" class="crumbs">
			<ol class="crumbs__list">
				<li><a href={localizePath('/', locale)}>{t('crumbs.home')}</a></li>
				<li aria-current="page">{crumb ?? title}</li>
			</ol>
		</nav>

		{eyebrow && <p class="eyebrow intro__eyebrow">{eyebrow}</p>}
		<h1 id="page-heading" class="intro__title">{title}</h1>
		{lede && <p class="intro__lede">{lede}</p>}
	</div>
</section>

<slot />

<style>
	/* The light comes from `.lit-band` in global.css, which this section also
	   wears — see the note there. Only the band's own metrics live here. */
	.intro {
		padding-block: calc(var(--nav-h, 5.25rem) + clamp(2.5rem, 6vw, 4.5rem))
			clamp(2rem, 4vw, 3rem);
	}

	.crumbs {
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}

	.crumbs__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-bone-500);
	}

	.crumbs__list li + li::before {
		content: '/';
		margin-inline-end: 0.5rem;
		color: var(--color-ink-600);
	}

	.crumbs__list a {
		color: var(--color-bone-400);
		text-decoration: none;
	}

	.crumbs__list a:hover {
		color: var(--color-arc-300);
	}

	.intro__eyebrow {
		margin: 0 0 0.85rem;
	}

	.intro__title {
		margin: 0;
		max-width: 20ch;
		font-size: var(--text-4xl);
		/* Display sizes want their own leading. Left to the inherited body value
		   a two-line heading opens a hole between the lines. */
		line-height: 1.06;
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.intro__lede {
		margin: 1.1rem 0 0;
		max-width: 56ch;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}
</style>
