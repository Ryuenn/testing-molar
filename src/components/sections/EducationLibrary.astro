---
/**
 * Section 09 — the Patient Education Library. The $97 offer.
 *
 * The centrepiece is a working-looking search: a query, a hit, and four related
 * videos. Every one of those is a REAL entry from `~/data/library` — the same
 * records the live /resources/video-library/ page renders — so the panel is the
 * product rather than a drawing of it. That is the strategy's "real product UI"
 * requirement, and it is the only way to meet it without inventing a screen.
 *
 * The films come from the catalogue too, by whichever route the entry carries:
 * a file in `public/videos/library/` plays in a bare <video>, and the rest —
 * most of the catalogue — play in a Vimeo embed with the title, byline and
 * portrait switched off. Either way the frame holds the video and nothing else.
 * An Instagram embed sat here briefly and came out; the note on the stage says
 * why.
 *
 * The search box is not a search box. It is a static rendering of one, with the
 * query already typed and the result already shown: a real input here would be
 * a control that does nothing, which is worse than a picture of one. It is
 * marked `aria-hidden` and the whole panel is described by the copy around it.
 *
 * The related thumbnails are the first frame of the real files, drawn by the
 * browser from `preload="metadata"` rather than shipped as images — a few
 * kilobytes of metadata against a JPEG each. They do not autoplay: this is a
 * screenshot of a library, and a section with five clips playing behind the
 * price is a section nobody reads.
 *
 * ⚠️ The four figures come from the strategy document, not from this repo.
 * See the warning at the top of `~/data/education` before publishing.
 */
import Glyph from '~/components/ui/Glyph.astro';
import {
	EDUCATION_STATS,
	EDUCATION_PRICE,
	EDUCATION_DEMO,
	EDUCATION_USES,
} from '~/data/education';
import { LIBRARY_ITEMS, type LibraryItem } from '~/data/library';
import { EDUCATION_CHECKOUT } from '~/data/site';
import { productById } from '~/data/products';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

export interface Props {
	/**
	 * Render the eyebrow, headline and lede. Off where the page already carries
	 * them — /patient-education/ puts this exact line in its <h1> and would
	 * otherwise say it twice, once as an h1 and once as an h2 directly below.
	 */
	head?: boolean;
	/**
	 * Render the price strip at the foot. Off on /patient-education/, where
	 * `EducationPricing` carries the full plan card further down and two price
	 * blocks on one page invite a reader to wonder which one is the real offer.
	 */
	buy?: boolean;
	/**
	 * Render the ghost "Explore the Library" button beside "Start Free Trial".
	 * Off on the home page, by request — one button, the trial, rather than a
	 * second one beside it pointing at the same product's own page.
	 */
	exploreCta?: boolean;
}

const { head = true, buy = true, exploreCta = true } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);

const item = (id: string): LibraryItem => {
	const found = LIBRARY_ITEMS.find((entry) => entry.id === id);
	/* Build-time, and loud: the demo is only honest while every id in it is a
	   real catalogue entry. Renaming one in `library.ts` must break this. */
	if (!found) throw new Error(`Education demo references unknown library item "${id}".`);
	return found;
};

const result = item(EDUCATION_DEMO.resultId);
const related = EDUCATION_DEMO.relatedIds.map(item);

/*
	The hit's player URL, where the entry is Vimeo-hosted rather than a file.

	`title`, `byline` and `portrait` all off, and `dnt=1` so Vimeo sets no
	tracking cookies on our visitors — what is left in the frame is the video.
	The same query `~/pages/resources/video-library` opens its dialog with, so the
	demo and the real library play a clip the same way.
*/
const hitEmbed = result.vimeo
	? `https://player.vimeo.com/video/${result.vimeo}?dnt=1&title=0&byline=0&portrait=0`
	: undefined;

/** The first paragraph of the write-up. The panel is a preview, not the page. */
const summary = result.summary ?? result.explainer?.split('\n\n')[0] ?? '';

const STATS = EDUCATION_STATS.map((stat) => ({
	value: stat.value ?? t('edu.statDevicesValue'),
	label: t(`edu.stat${stat.key.charAt(0).toUpperCase()}${stat.key.slice(1)}Label` as 'edu.statVideosLabel'),
}));

const USES = EDUCATION_USES.map((use) => ({
	name: t(`edu.use${use.charAt(0).toUpperCase()}${use.slice(1)}` as 'edu.useChairside'),
	sub: t(`edu.use${use.charAt(0).toUpperCase()}${use.slice(1)}Sub` as 'edu.useChairsideSub'),
}));

const href = localizePath(productById('education').href, locale);

/*
	The live Stripe Payment Link — it opens the free month and takes a card. It
	leaves the site, so it carries `rel="noopener"` and says where it goes.
	Still localised defensively: if it is ever swapped back to an internal path,
	a German visitor should not be dropped onto the English page.
*/
const buyHref = EDUCATION_CHECKOUT.startsWith('/')
	? localizePath(EDUCATION_CHECKOUT, locale)
	: EDUCATION_CHECKOUT;
const buyIsExternal = !buyHref.startsWith('/');
---

<section
	id="education"
	class="section section-rule lib"
	aria-labelledby={head ? 'lib-heading' : undefined}
	aria-label={head ? undefined : t('edu.eyebrow')}
>
	<div class="lib__aurora" aria-hidden="true"></div>
	<div class="grain" aria-hidden="true"></div>

	<div class="container-content lib__inner">
		{
			head && (
				<header class="lib__head">
					<p class="eyebrow" data-reveal="fade">
						{t('edu.eyebrow')}
					</p>
					<h2 id="lib-heading" class="lib__title" data-reveal>
						{t('edu.heading')}
					</h2>
					<p class="lib__lede" data-reveal>
						{t('edu.lede')}
					</p>
				</header>
			)
		}

		{/* ── The product panel ───────────────────────────────────────────── */}
		<div class="app" data-reveal>
			<div class="app__bar">
				{/*
					A rendering of the search field, with the query already in it.
					Hidden from assistive tech because a fake control announced as a
					control is a promise the page cannot keep; the heading and the
					lede above already say what this is.
				*/}
				<span class="app__search" aria-hidden="true">
					<span class="app__search-icon"><Glyph name="search" /></span>
					<span class="app__query">{t('edu.demoQuery')}</span>
					<span class="app__caret"></span>
				</span>
				{/*
					`.app__hint` is gone — "A real entry from the library, shown exactly as
					the page renders it."

					It was a caption explaining that the panel was not a mock-up, set in
					mono beside the search field. A panel that has to say it is real is
					arguing with a doubt the reader had not had yet; the panel is real,
					and saying so out loud only invites the question.

					`edu.demoNote` stays in the dictionary; nothing renders it.
				*/}
			</div>

			<div class="app__body">
				<article class="hit">
					<p class="hit__label">{t('edu.topResult')}</p>

					<div class="hit__stage">
						{/*
							Two ways a catalogue entry carries its film, and the panel paints
							whichever this one has — the same fork the real library page makes
							on its cards.

							  video   a file in `public/videos/library/`. A bare <video>: no
							          chrome, no third party, nothing between the reader and
							          the clip. Preferred wherever it exists.
							  vimeo   embed-only and domain-restricted, which is most of the
							          catalogue. The player, with everything Vimeo puts around
							          a video switched off in `hitEmbed`.

							This slot briefly held an Instagram embed. It came out: their
							markup is a whole Instagram card — avatar, "View profile", the
							like and comment bar, "Add a comment…" — and none of it is
							optional. A panel selling the library was showing Instagram's UI
							instead of the product's.

							`preload="none"` on the file, upgraded to `metadata` by the script
							below once the section is near. `preload="metadata"` reaches into
							every clip the moment the page loads, and the clips on this
							section come to tens of megabytes between them; on a landing page
							that is bandwidth spent on a section most visitors never scroll
							to. No `autoplay` either way: this is a screenshot of a library,
							not a section with video running behind the price.
						*/}
						{result.video ? (
							<video
								class="hit__video"
								src={result.video}
								preload="none"
								data-preload="metadata"
								playsinline
								controls
								disablepictureinpicture
							/>
						) : (
							<iframe
								class="hit__video"
								src={hitEmbed}
								title={result.title}
								loading="lazy"
								allow="fullscreen; picture-in-picture"
								allowfullscreen
							/>
						)}
					</div>

					<div class="hit__meta">
						<span class="hit__topic">{result.topic}</span>
						<h3 class="hit__title">{result.title}</h3>
						<p class="hit__summary">{summary}</p>
					</div>
				</article>

				<aside class="rel" aria-labelledby="lib-related">
					<h3 id="lib-related" class="rel__label">{t('edu.related')}</h3>
					<ul class="rel__list">
						{
							related.map((entry) => (
								<li class="rel__item">
									<span class="rel__thumb">
										{/*
											Same fork as the hit above, and it is load-bearing: most
											of the catalogue is Vimeo-hosted, where `entry.video` is
											undefined. A <video> with no src is an empty black box,
											which is what this list rendered for every hosted entry
											until the thumbnails learned the difference.

											Local files seek their own first frame; hosted ones take
											Vimeo's thumbnail, which `img-src https://i.vimeocdn.com`
											in the CSP already allows.
										*/}
										{entry.video ? (
											<video src={entry.video} preload="none" data-preload="metadata" muted playsinline tabindex="-1" aria-hidden="true" />
										) : (
											<img src={entry.poster} alt="" loading="lazy" decoding="async" width="120" height="214" />
										)}
										<span class="rel__play" aria-hidden="true">
											<Glyph name="play" />
										</span>
									</span>
									<span class="rel__body">
										<span class="rel__title">{entry.title}</span>
										<span class="rel__topic">{entry.topic}</span>
									</span>
								</li>
							))
						}
					</ul>

					{/*
						`.rel__all` is gone — "Access the library →", which pointed at
						/resources/video-library/.

						This panel sits directly above the price and the free-trial button,
						and it was offering a way off the page at the point a reader is
						closest to buying. The library is in the Resources menu and on the
						product page for anyone who wants to browse first; it does not need
						a door here.
					*/}
				</aside>
			</div>
		</div>

		{/* ── The figures ─────────────────────────────────────────────────── */}
		<dl class="lib__stats" data-reveal-stagger>
			{
				STATS.map((stat) => (
					<div class="lib__stat" data-reveal data-reveal-group>
						<dt class="lib__stat-label">{stat.label}</dt>
						<dd class="lib__stat-value">{stat.value}</dd>
					</div>
				))
			}
		</dl>

		{/* ── Where it gets used ──────────────────────────────────────────── */}
		<ul class="lib__uses" data-reveal-stagger>
			{
				USES.map((use) => (
					<li class="use" data-reveal data-reveal-group>
						<span class="use__name">{use.name}</span>
						<span class="use__sub">{use.sub}</span>
					</li>
				))
			}
		</ul>

		{/* ── Price and the way in ────────────────────────────────────────── */}
		{
			buy && (
		<div class="lib__buy" data-reveal>
			<div class="lib__price-block">
				{/*
					The free month leads, because it is the offer — the price is what
					the offer becomes. Reversing the two would bury the only reason to
					act today behind a number that invites a decision.
				*/}
				<p class="lib__trial">{t('edu.trial')}</p>
				<p class="lib__price">
					<span class="lib__price-value">{EDUCATION_PRICE}</span>
					<span class="lib__price-unit">{t('edu.perMonth')}</span>
					<span class="lib__price-note">{t('edu.billedFrom')}</span>
				</p>
			</div>

			<div class="lib__actions">
				<a class="btn btn-primary" href={buyHref} target="_blank" rel="noopener">
					{t('edu.startFree')}
					{/* Says where the button goes without putting it in the label twice
					    for anyone who can see the button. */}
					{buyIsExternal && (
						<span class="sr-only"> — opens Stripe Checkout {t('footer.newTab')}</span>
					)}
					<span aria-hidden="true">→</span>
				</a>
				{exploreCta && (
					<a class="btn btn-ghost" href={href}>{t('products.educationCta')}</a>
				)}
			</div>

			<p class="lib__fine">{t('edu.cancelBefore')}</p>
		</div>
			)
		}
	</div>
</section>

<script>
	/*
		Hands each clip back the `preload` it wants, once the section is within a
		screen of the viewport.

		The markup ships `preload="none"` so the browser reaches into nothing on
		load; this restores `metadata` in time for the poster frame to be painted
		before anyone reads this far. Net effect is the section looks exactly as it
		did, and a visitor who never scrolls to it pays nothing for it.

		No observer support, or no JS at all: the clips keep `preload="none"` and
		show their first frame the moment someone presses play. Later than before,
		never broken.
	*/
	const deferred = document.querySelectorAll<HTMLVideoElement>('video[data-preload]');

	if (deferred.length) {
		const wake = (video: HTMLVideoElement) => {
			video.preload = (video.dataset.preload ?? 'metadata') as HTMLVideoElement['preload'];
			video.removeAttribute('data-preload');
			video.load();
		};

		if (!('IntersectionObserver' in window)) {
			for (const video of deferred) wake(video);
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						wake(entry.target as HTMLVideoElement);
						observer.unobserve(entry.target);
					}
				},
				/* A screen's worth of warning, so the frame is there by the time the
				   section is. */
				{ rootMargin: '100% 0px' },
			);

			for (const video of deferred) observer.observe(video);
		}
	}
</script>

<style>
	.lib {
		position: relative;
		isolation: isolate;
		overflow: clip;
	}

	/* Glass needs something behind it or it is a translucent grey box. Two wide
	   arc blooms, low enough to read as light in the room. */
	.lib__aurora {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			radial-gradient(
				48% 46% at 22% 22%,
				color-mix(in oklab, var(--color-arc-600) 24%, transparent),
				transparent 70%
			),
			radial-gradient(
				56% 50% at 84% 76%,
				color-mix(in oklab, var(--color-arc-700) 22%, transparent),
				transparent 72%
			);
		filter: blur(50px);
	}

	.lib__inner {
		position: relative;
	}

	.lib__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
		max-width: 46ch;
	}

	.lib__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.lib__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	/* ── The panel ───────────────────────────────────────────────────────── */
	.app {
		border-radius: 0.875rem;
		border: 1px solid var(--color-line-strong);
		background: color-mix(in oklab, var(--color-ink-900) 82%, transparent);
		backdrop-filter: blur(16px) saturate(140%);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #dbeaff 12%, transparent),
			0 40px 90px -50px #000;
		overflow: clip;
	}

	.app__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		padding: 0.875rem clamp(0.875rem, 2vw, 1.25rem);
		border-block-end: 1px solid var(--color-line);
		background: color-mix(in oklab, var(--color-ink-950) 45%, transparent);
	}

	.app__search {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		flex: 1 1 16rem;
		height: 2.75rem;
		padding-inline: 0.875rem;
		border-radius: 0.625rem;
		border: 1px solid var(--color-line-strong);
		background: color-mix(in oklab, var(--color-ink-950) 70%, transparent);
	}

	.app__search-icon {
		flex: none;
		width: 1.0625rem;
		height: 1.0625rem;
		color: var(--color-bone-500);
	}

	.app__query {
		font-size: var(--text-sm);
		color: var(--color-bone-50);
	}

	/*
		The cursor after the query. It blinks, which is the one piece of motion in
		this panel and the thing that makes a static picture read as a live field.
		Reduced motion kills the animation globally — see global.css — and leaves
		a solid bar, which is exactly right.
	*/
	.app__caret {
		width: 1px;
		height: 1.1em;
		background: var(--color-arc-300);
		animation: caret 1.1s steps(1) infinite;
	}

	@keyframes caret {
		50% {
			opacity: 0;
		}
	}

	.app__hint {
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.06em;
		color: var(--color-bone-500);
	}

	.app__body {
		display: grid;
		gap: clamp(1.25rem, 2.5vw, 2rem);
		padding: clamp(1.125rem, 2.5vw, 1.75rem);
	}

	@media (min-width: 56rem) {
		.app__body {
			grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
		}
	}

	/* ── The hit ─────────────────────────────────────────────────────────── */
	.hit {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	.hit__label,
	.rel__label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-arc-300);
	}

	/*
		9:16 capped by height. The clips are portrait phone video; letting one run
		to its natural aspect inside a two-column panel makes a column half a
		metre tall on a laptop.
	*/
	.hit__stage {
		display: grid;
		place-items: center;
		padding: clamp(0.75rem, 1.5vw, 1.125rem);
		border-radius: 0.75rem;
		border: 1px solid var(--color-line);
		background: var(--color-ink-950);
	}


	/*
		One box for both players — the local <video> and the Vimeo <iframe> — so
		the stage is the same size whichever route the entry carries its film by,
		and swapping one for the other never reflows the section.

		`border: 0` is for the iframe, which brings one by default. `object-fit`
		does nothing to an iframe and is harmless there.
	*/
	.hit__video {
		width: auto;
		max-width: 100%;
		height: min(52vh, 26rem);
		aspect-ratio: 9 / 16;
		border: 0;
		border-radius: 0.5rem;
		background: #000;
		object-fit: cover;
	}

	.hit__meta {
		display: grid;
		gap: 0.5rem;
	}

	.hit__topic {
		justify-self: start;
		padding: 0.25rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--color-line);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-bone-400);
	}

	.hit__title {
		margin: 0;
		font-size: var(--text-xl);
		line-height: 1.3;
	}

	.hit__summary {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.65;
		color: var(--color-bone-300);
	}

	/* ── Related ─────────────────────────────────────────────────────────── */
	.rel {
		display: grid;
		gap: 0.875rem;
		align-content: start;
	}

	.rel__list {
		display: grid;
		gap: 0.625rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.rel__item {
		display: grid;
		grid-template-columns: 4.25rem minmax(0, 1fr);
		gap: 0.75rem;
		padding: 0.5rem;
		border-radius: 0.625rem;
		border: 1px solid var(--color-line);
		background: color-mix(in oklab, var(--color-ink-950) 55%, transparent);
	}

	.rel__thumb {
		position: relative;
		display: block;
		aspect-ratio: 3 / 4;
		border-radius: 0.4375rem;
		background: #000;
		overflow: clip;
	}

	.rel__thumb video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Not a control here — it is a still. Pointer events off so the row does
		   not turn into a video player nobody asked for. */
		pointer-events: none;
	}

	.rel__play {
		position: absolute;
		inset-block-end: 0.25rem;
		inset-inline-end: 0.25rem;
		width: 1.125rem;
		height: 1.125rem;
		color: #fff;
		filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.8));
	}

	.rel__body {
		display: grid;
		align-content: center;
		gap: 0.25rem;
	}

	.rel__title {
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: 1.35;
		color: var(--color-bone-100);
	}

	.rel__topic {
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	.rel__all {
		font-size: var(--text-sm);
		color: var(--color-arc-300);
		text-decoration: none;
	}

	.rel__all:hover {
		color: var(--color-arc-200);
		text-decoration: underline;
	}

	/* ── Figures ─────────────────────────────────────────────────────────── */
	.lib__stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
		gap: clamp(1rem, 2.5vw, 2rem);
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		padding: 0;
	}

	.lib__stat {
		display: flex;
		/* Number first visually; <dt> before <dd> in the markup, which is what a
		   description list means. */
		flex-direction: column-reverse;
		gap: 0.375rem;
		padding-inline-start: 1.125rem;
		border-inline-start: 1px solid var(--color-line);
	}

	.lib__stat-value {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-3xl);
