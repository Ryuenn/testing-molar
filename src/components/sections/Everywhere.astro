---
/**
 * Where the education actually runs — three moments, in the order a patient
 * meets them.
 *
 *   Throughout the practice   MOLAR TV on any screen, plus iPads with the full
 *                             library.
 *   During the conversation   search 300+ videos and show the right
 *                             explanation instantly.
 *   After they leave          MOLAR Social keeps the practice in the feed and
 *                             brings unscheduled treatment back.
 *
 * The third is the only place on the home page that argues for MOLAR Social
 * before the plan grid, and it is deliberately the last of the three: the page
 * sells the $97 screen, and social is what that turns into once it is running.
 *
 * ⚠️ The artwork this section wants — the real TV design, the library
 * interface, an iPad and a monitor — is not in this repo. There is one asset
 * that fits (`public/videos/Drpatricia_updated_video-web.mp4`, already running inside the
 * screen in `MolarTv`) and no library-interface shot, no iPad and no monitor.
 * Rather than pad the section with a stock device mockup, each row carries its
 * mark and its copy and the layout leaves the picture column free. Drop the
 * stills into `src/assets/showcase/` and give each row an `art` and this
 * becomes a three-row bento without touching the copy.
 */
import Glyph from '~/components/ui/Glyph.astro';
import type { GlyphName } from '~/data/glyphs';
import { EDUCATION_CHECKOUT } from '~/data/site';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

/* Key into `everywhere.*` for the moment and the sentence under it. */
const MOMENTS = [
	{ key: 'practice', icon: 'screens' },
	{ key: 'consult', icon: 'search' },
	{ key: 'after', icon: 'share' },
] as const satisfies readonly { key: string; icon: GlyphName }[];

const ROWS = MOMENTS.map((moment) => ({
	icon: moment.icon,
	when: t(`everywhere.${moment.key}When` as 'everywhere.practiceWhen'),
	what: t(`everywhere.${moment.key}What` as 'everywhere.practiceWhat'),
}));
---

<section id="everywhere" class="section section-rule ev" aria-labelledby="ev-heading">
	<div class="grain" aria-hidden="true"></div>

	<div class="container-content">
		<header class="ev__head">
			<p class="eyebrow" data-reveal="fade">{t('everywhere.eyebrow')}</p>
			<h2 id="ev-heading" class="ev__title" data-reveal>{t('everywhere.heading')}</h2>
		</header>

		<ul class="ev__list" data-reveal-stagger>
			{
				ROWS.map((row) => (
					<li class="ev__row panel" data-reveal data-reveal-group>
						<span class="ev__icon" aria-hidden="true">
							<Glyph name={row.icon} />
						</span>
						<div class="ev__body">
							{/*
								The moment, then what happens in it. A <p> pair rather than a
								heading and a paragraph: these are three parallel statements,
								not three subsections, and an h3 here would put three stops in
								the document outline for a list.
							*/}
							<p class="ev__when">{row.when}</p>
							<p class="ev__what">{row.what}</p>
						</div>
					</li>
				))
			}
		</ul>

		<div class="ev__actions" data-reveal>
			<a class="btn btn-primary" href={EDUCATION_CHECKOUT} target="_blank" rel="noopener">
				{t('tv.ctaTrial')}
				<span class="sr-only"> {t('footer.newTab')}</span>
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</section>

<style>
	.ev {
		position: relative;
		isolation: isolate;
	}

	.ev__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	.ev__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.ev__list {
		display: grid;
		gap: clamp(0.75rem, 2vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ev__row {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: clamp(1rem, 2.5vw, 1.5rem);
		padding: clamp(1.25rem, 3vw, 1.75rem);
	}

	/* The mark carries its own light, the way the MOLAR TV tiles do — one
	   drop-shadow following the strokes rather than a disc behind the box. */
	.ev__icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.25rem;
		height: 2.25rem;
		color: var(--color-arc-300);
		filter: drop-shadow(0 0 9px color-mix(in oklab, var(--color-arc-400) 65%, transparent));
	}

	.ev__icon :global(svg) {
		width: 2.25rem;
		height: 2.25rem;
	}

	.ev__body {
		display: grid;
		gap: 0.375rem;
	}

	.ev__when {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-bone-50);
	}

	.ev__what {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.55;
		color: var(--color-bone-300);
	}

	.ev__actions {
		display: flex;
		justify-content: center;
		margin-top: clamp(2rem, 4vw, 3rem);
	}
</style>
