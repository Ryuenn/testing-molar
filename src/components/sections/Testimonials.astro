---
/**
 * What clients have said, from `~/data/testimonials`.
 *
 * The quotes are verbatim and untranslated — see the note at the top of that
 * file. Everything around them is translated, which is the same line the site
 * already draws for the work grids and the inbound DMs: a real artefact is
 * reproduced, its framing is localised.
 *
 * Attribution is the whole reliability of this section. One of the three
 * carries a name because the live funnel attributes it; the other two run
 * anonymous and SAY SO, with a line explaining that the name is withheld rather
 * than leaving a reader to wonder whether there was ever a person. Never invent
 * an attribution to fill that gap.
 *
 * No Review or aggregateRating JSON-LD, deliberately, and for the same reason
 * /results/ has none: Google's review-snippet guidelines exclude reviews a
 * business collects about itself. The section is honest without the markup;
 * with it, it would be a manual action waiting to happen.
 */
import { TESTIMONIALS } from '~/data/testimonials';
import { WORK } from '~/data/work';
import { EDUCATION_CHECKOUT } from '~/data/site';
import Placeholder from '~/components/ui/VideoPlaceholder.astro';
import { getLocale, useTranslations } from '~/i18n/utils';

export interface Props {
	/** Heading level. Pages that run this under their own h1 pass 'h3'. */
	as?: 'h2' | 'h3';
	/**
	 * Render the section as films alone.
	 *
	 * The home page's version is a video wall: one big film and two more beneath
	 * it. Prose under each card makes them top-heavy, and three quotations under
	 * three frames is a page asking to be read when it is offering to be watched.
	 *
	 * So the whole section is trimmed to the footage: no quotations anywhere, the
	 * lead captioned with a name and nothing else, and the two under it captioned
	 * not at all — they are unattributed, so their caption was a disclaimer rather
	 * than a name. See the notes at each.
	 *
	 * OFF by default, and /patient-education/ relies on that. Nothing there is
	 * filmed, so films-only would leave it with two placeholder frames and no
	 * testimonial at all. The quotes stay in `~/data/testimonials` either way —
	 * this switches whether they are drawn, not whether they exist.
	 */
	filmsOnly?: boolean;
}

const { as: Heading = 'h2', filmsOnly = false } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);

/*
	Where a quote names its practice, pull that practice's own record so the
	card can show the market and the specialty rather than a bare name. Matched
	by slug, so a renamed account in `work.ts` breaks the link visibly rather
	than silently attaching the quote to nothing.
*/
const QUOTES = TESTIMONIALS.map((entry) => {
	/*
		Three states, in precedence order, and every card is in exactly one:

		  vimeo        a hosted player. Wins wherever an id is set.
		  self-hosted  a file in public/videos with a poster beside it. A <video>
		               with no poster is a black rectangle on a marketing page, so
		               both are required before this counts.
		  placeholder  neither. A frame at the right size and aspect, so the
		               layout is finished before the footage is.
	*/
	const vimeo = entry.vimeo?.trim() || undefined;
	const selfHosted = !vimeo && Boolean(entry.video && entry.poster);

	/*
		The frame's shape, and whether it is a tall one.

		`aspect` goes to CSS as-is. `portrait` is read off it here rather than in a
		stylesheet, because CSS cannot branch on the value of a custom property —
		and the lead needs the branch: a full-width 9 / 16 film is a card three
		screens tall, so a portrait lead is capped by width instead.
	*/
	const aspect = entry.aspect?.trim() || '16 / 9';
	const [w, h] = aspect.split('/').map((n) => Number(n.trim()));
	const portrait = Number.isFinite(w) && Number.isFinite(h) && h > w;

	return {
		...entry,
		vimeo,
		selfHosted,
		aspect,
		portrait,
		placeholder: !vimeo && !selfHosted,
		account: entry.accountSlug ? WORK.find((a) => a.slug === entry.accountSlug) : undefined,
	};
});

/*
	One card leads and the rest follow it, smaller.

	The lead is whichever entry is marked `featured`; failing that, the first —
	so the section cannot end up without a highlight however the data is edited.

	All three are hosted now — the placeholder path below is dead code kept for
	the next entry rather than a state anything on the site is in. A fourth
	testimonial arrives as a frame at the right size until its id is pasted in.
*/
const lead = QUOTES.find((entry) => entry.featured) ?? QUOTES[0];
const rest = QUOTES.filter((entry) => entry !== lead);

/*
	Who the lead card names.

	Two different people can be involved in one entry — the dentist who said the
	sentence and the dentist in the film — so which name belongs under the card
	depends on which of the two is on screen. With the quotation drawn, the
	caption attributes it and is `name`. Films-only draws no quotation, so it
	names whoever is in the film. See `speaker` in `~/data/testimonials`.
*/
const leadCaption = (filmsOnly && lead.speaker) || lead.name;

/*
	The player URL.

	`dnt=1` keeps Vimeo from setting tracking cookies on our visitors, which is
	ours to decide and not something a video needs. No `autoplay`: this is a
	person talking, in a section a reader is scrolling past.

	An unlisted link's hash arrives glued to the id as `123456?h=abc` — see the
	note on the field — so the query is appended with the right separator rather
	than assuming there is none.
*/
const playerSrc = (id: string) =>
	`https://player.vimeo.com/video/${id}${id.includes('?') ? '&' : '?'}dnt=1&title=0&byline=0&portrait=0`;

/*
	The attributes that open the modal.

	Films-only turns every tile into a button: the inline player becomes a
	thumbnail and pressing it opens the clip full size over the page. The script
	at the foot reads these three off the button rather than keeping a parallel
	list in JavaScript, so adding a testimonial cannot desynchronise the two.

	`autoplay=1` belongs to the modal and only to the modal — a visitor who
	presses play has asked for it, which is the one condition under which a
	person talking should start talking.

	`muted=1` rides along with it, and that is not a contradiction of "with
	sound" — it is the only way to GET sound. No browser allows a cross-origin
	iframe to start playing audio the instant its `src` is set, gesture or not;
	autoplay is only ever granted muted. The script at the foot starts it this
	way and then calls the Player SDK's `setMuted(false)` immediately after,
	inside the same click handler — that unmute is what the click's user
	gesture actually buys, and it is the standard pattern for this exact case.
*/
const openAttrs = (entry: (typeof QUOTES)[number], label: string) =>
	filmsOnly && entry.vimeo
		? {
				'data-film-open': '',
				'data-film-src': `${playerSrc(entry.vimeo)}&autoplay=1&muted=1`,
				'data-film-aspect': entry.aspect,
				'data-film-label': label,
			}
		: {};
---

<section
	id="testimonials"
	class:list={['section section-rule tm', filmsOnly && 'tm--films']}
	aria-labelledby="tm-heading"
>
	<div class="container-content">
		<header class="tm__head">
			<p class="eyebrow" data-reveal="fade">{t('testimonials.eyebrow')}</p>
			<Heading id="tm-heading" class="tm__title" data-reveal>{t('testimonials.heading')}</Heading>
		</header>

		{/*
			The highlight, full width, with the film beside the quote.

			Three ways a frame can be filled — see `QUOTES` in the frontmatter. The
			hosted player is `loading="lazy"`, so an iframe below the fold costs
			nothing until it is scrolled to; the self-hosted one is `preload="none"`
			behind a poster and fetches nothing until play; the placeholder is markup
			only. `controls` rather than a custom button, because this is a person
			speaking and the viewer needs a scrubber and a volume control — unlike
			the muted decorative loops elsewhere on the site, which have neither.
		*/}
		{/*
			`panel` only when there is prose to hold.

			In films-only the card has nothing in it but the film and a name, and a
			bordered, padded, filled box around a portrait video is a frame around a
			frame — it leaves a broad margin of empty panel on either side of a tall
			clip and makes the film look like an illustration dropped into a card.
			Without it the film IS the card, and the frame it already carries is the
			only edge in the composition.
		*/}
		<div class="tm__films">
		<article
			class:list={['quote quote--lead', !filmsOnly && 'panel', filmsOnly && 'quote--lead-film']}
			data-reveal
		>
			<div
				class:list={['quote__film', lead.portrait && 'quote__film--portrait']}
				style={`--quote-aspect:${lead.aspect};${lead.filmShift ? `--film-shift:${lead.filmShift};` : ''}`}
			>
				{/*
					The tile's control, in films-only only.

					The <iframe> underneath is Vimeo's own thumbnail — which is why the
					tile is not a poster image: there is no still for these clips in the
					repo, and the player already draws one. It is made inert with
					`pointer-events: none` and this button takes the press instead, so a
					click opens the modal rather than starting a small silent video in a
					corner of the page.
				*/}
				{filmsOnly && lead.vimeo && (
					<button
						class="quote__play"
						type="button"
						{...openAttrs(lead, leadCaption ?? t('testimonials.anonymous'))}
					>
						<span class="sr-only">
							{t('testimonials.watch', { name: leadCaption ?? t('testimonials.anonymous') })}
						</span>
						<span class="quote__play-disc" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="currentColor">
								<path d="M9 6.5v11l9-5.5-9-5.5Z" />
							</svg>
						</span>
					</button>
				)}

				{/*
					The picture, and the box the crop happens in.

					The player is CROPPED in the films-only wall — taller than its frame and
					clipped by it, see the note in the stylesheet — and an absolutely
					positioned child is laid out against its ancestor's PADDING box. Clipping
					on `.quote__film` would therefore run the picture out over the bezel top
					and bottom and leave the frame with an edge on two sides only. This box is
					the frame's content area: inset by the bezel because it is in flow, and
					the clip belongs to it.
				*/}
				<div class="quote__pic">
					{lead.vimeo ? (
						<iframe
							class="quote__embed"
							src={playerSrc(lead.vimeo)}
							title={t('testimonials.watch', { name: leadCaption ?? t('testimonials.anonymous') })}
							loading="lazy"
							allow="fullscreen; picture-in-picture"
							allowfullscreen
						/>
					) : lead.selfHosted ? (
						<video
							class="quote__video"
							src={lead.video}
							poster={lead.poster}
							preload="none"
							playsinline
							controls
							disablepictureinpicture
						/>
					) : (
						<Placeholder name={leadCaption} />
					)}
				</div>
			</div>

			{/*
				<blockquote> with the attribution OUTSIDE it, in a <figcaption>. A
				<cite> inside the blockquote would make the person's name part of the
				quotation, which is not what they said.

				In films-only mode the quotation goes and the caption is cut to the
				name alone — no role, no city. The lead used to be the exception: the
				film beside a pull-quote set at `--text-xl`, over a role and a place.
				That reads as a poster for the testimonial rather than the testimonial,
				and the quote is the sentence she says out loud in the first ten
				seconds of the film anyway. Who she is stays; the rest is left to her
				to say.
			*/}
			<figure class="quote__fig">
				{!filmsOnly && (
					<>
						<span class="quote__mark" aria-hidden="true">
							&ldquo;
						</span>
						<blockquote class="quote__body">
							<p>{lead.quote}</p>
						</blockquote>
					</>
				)}

				<figcaption class:list={['quote__by', filmsOnly && 'quote__by--film']}>
					{leadCaption ? (
						<>
							{/* "Featured Testimonial:" only where there is no quotation to
							    label it — with the quote drawn, the caption is an
							    attribution and a label in front of it reads as a heading. */}
							{filmsOnly && <span class="quote__kicker">{t('testimonials.featured')}</span>}
							<span class="quote__name">{leadCaption}</span>
							{!filmsOnly && lead.role && <span class="quote__role">{lead.role}</span>}
							{!filmsOnly && lead.account?.place && (
								<span class="quote__place">{lead.account.place}</span>
							)}
						</>
					) : (
						<>
							<span class="quote__name quote__name--anon">{t('testimonials.anonymous')}</span>
							<span class="quote__role">{t('testimonials.nameWithheld')}</span>
						</>
					)}
				</figcaption>
			</figure>
		</article>

		<ul class="tm__grid" data-reveal-stagger>
			{
				rest.map((entry) => (
					<li class:list={['quote', !filmsOnly && 'panel']} data-reveal data-reveal-group>
						{/*
							A <figure> either way, and in films-only mode it is the honest
							markup rather than a compromise: the film is the figure and the
							name is its caption. With the quotation present the <blockquote>
							is the figure's content and the caption attributes it — which is
							why the name has never been inside the <blockquote>. A <cite>
							there would make the person's name part of what they said.
						*/}
						<figure class="quote__fig">
							<div
								class:list={['quote__film', entry.portrait && 'quote__film--portrait']}
								style={`--quote-aspect:${entry.aspect};${entry.filmShift ? `--film-shift:${entry.filmShift};` : ''}`}
							>
								{/* Same control as the highlight — see the note there. */}
								{filmsOnly && entry.vimeo && (
									<button
										class="quote__play"
										type="button"
										{...openAttrs(entry, entry.name ?? t('testimonials.anonymous'))}
									>
										<span class="sr-only">
											{t('testimonials.watch', {
												name: entry.name ?? t('testimonials.anonymous'),
											})}
										</span>
										<span class="quote__play-disc" aria-hidden="true">
											<svg viewBox="0 0 24 24" fill="currentColor">
												<path d="M9 6.5v11l9-5.5-9-5.5Z" />
											</svg>
										</span>
									</button>
								)}

								{/*
									The picture, and the box the crop happens in — see the note on the
									highlight's.
								*/}
								<div class="quote__pic">
									{entry.vimeo ? (
										<iframe
											class="quote__embed"
											src={playerSrc(entry.vimeo)}
											title={t('testimonials.watch', {
												name: entry.name ?? t('testimonials.anonymous'),
											})}
											loading="lazy"
											allow="fullscreen; picture-in-picture"
											allowfullscreen
										/>
									) : entry.selfHosted ? (
										<video
											class="quote__video"
											src={entry.video}
											poster={entry.poster}
											preload="none"
											playsinline
											controls
											disablepictureinpicture
										/>
									) : (
										<Placeholder name={entry.name} />
									)}
								</div>
							</div>

							{!filmsOnly && (
								<>
									<span class="quote__mark" aria-hidden="true">
										&ldquo;
									</span>
									<blockquote class="quote__body">
										<p>{entry.quote}</p>
									</blockquote>
								</>
							)}

							{/*
								Films-only: the frame and nothing else.

								These two run anonymous — the live funnel does not attribute
								them — so the caption here was never a name. It was
								"Anonymous / name withheld", which is a disclaimer, and three
								lines of disclaimer under two silent frames is louder than the
								films they sit under. The honesty it was protecting is still
								protected: nothing here claims a source, because nothing here
								says anything. The moment one of these is attributed, drop the
								`filmsOnly` guard and the name renders.
							*/}
							{!filmsOnly && (
								<figcaption class="quote__by">
									{entry.name ? (
										<>
											<span class="quote__name">{entry.name}</span>
											{entry.role && <span class="quote__role">{entry.role}</span>}
											{entry.account?.place && (
												<span class="quote__place">{entry.account.place}</span>
											)}
										</>
									) : (
										<>
											<span class="quote__name quote__name--anon">
												{t('testimonials.anonymous')}
											</span>
											<span class="quote__role">{t('testimonials.nameWithheld')}</span>
										</>
									)}
								</figcaption>
							)}
						</figure>
					</li>
				))
			}
		</ul>
		</div>

		{/*
			The player, in the top layer.

			A real <dialog> opened with `showModal()`: the page behind it goes
			inert, focus is trapped, Escape closes it and the backdrop is the
			browser's own — none of which is worth hand-writing. What the script
			adds is the part the platform does not do: swapping the film in, holding
			the frame at the clip's own aspect, and emptying the src on close so a
			closed modal is not still playing.

			Rendered only in films-only, where the tiles are buttons that need
			somewhere to open.
		*/}
		{filmsOnly && (
			<dialog class="tmdlg" data-film-dialog aria-label={t('testimonials.heading')}>
				<div class="tmdlg__frame">
					<iframe
						class="tmdlg__embed"
						data-film-frame
						title={t('testimonials.heading')}
						allow="autoplay; fullscreen; picture-in-picture"
						allowfullscreen
					/>
					<button class="tmdlg__close" type="button" data-film-close>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="m7 7 10 10M17 7 7 17"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"
							/>
						</svg>
						<span class="sr-only">{t('testimonials.close')}</span>
					</button>
				</div>
			</dialog>
		)}

		<div class="tm__actions" data-reveal>
			<a class="btn btn-primary" href={EDUCATION_CHECKOUT} target="_blank" rel="noopener">
				{t('testimonials.cta')}
				<span class="sr-only"> {t('footer.newTab')}</span>
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</section>

<style>
	.tm__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.tm__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.tm__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
		gap: clamp(1rem, 2.5vw, 1.5rem);
		margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
		padding: 0;
		list-style: none;
	}

	/* A column, so the frame sits over the quote on the two smaller cards. */
	.quote {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, 2.5vw, 1.25rem);
		padding: clamp(1.5rem, 3vw, 2rem);
	}

	/*
		The highlight. Wider than the two under it, and above 52rem it runs the
		film BESIDE the quote rather than over it — a 16:9 frame stacked on a
		sentence in a full-width card leaves the quote stranded at the bottom of a
		very tall box.

		The film takes the larger track: it is the thing this section exists to
		play, and the quote beside it is the caption that decides whether anyone
		presses it.
	*/
	.quote--lead {
		display: grid;
		gap: clamp(1.25rem, 3vw, 2rem);
		padding: clamp(1.5rem, 3vw, 2.25rem);
	}

	@media (min-width: 52rem) {
		.quote--lead {
			grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
			align-items: center;
		}

		/*
			Films-only: one column, not two. The second track existed to hold the
			pull-quote; with the quotation gone all that is left beside the film is
			a name and a role, and stretching those across 40% of a full-width card
			makes the film look like an illustration of a caption.
		*/
		.quote--lead-film {
			grid-template-columns: minmax(0, 1fr);
			justify-items: center;
		}
	}

	.quote__film {
		border-radius: 0.875rem;
		border: 1px solid var(--color-line);
		background: var(--color-ink-950);
		overflow: hidden;
	}

	/*
		A tall film gets capped by width, because height is the dimension that runs
		away: at a card's full width a 9 / 16 frame is most of a laptop screen on
		its own, and a 43 / 20 one — which is what Vimeo hands back for some of
		these phone cuts — is more than all of it. Width is the only handle that
		bounds the height without breaking the aspect, so it is the one used, and
		the frame is centred in the space it gives back.
	*/
	.quote__film--portrait {
		width: min(100%, clamp(11rem, 34vw, 15rem));
		margin-inline: auto;
	}

	/*
		The highlight gets a bigger cap than the cards under it. It should still
		read as the highlight — taller than the 16 / 9 frames below, covering more
		of the page — without being the only thing on screen.
	*/
	.quote--lead .quote__film--portrait {
		width: min(100%, clamp(15rem, 46vw, 20rem));
	}

	/*
		One box for all three states — hosted player, self-hosted file, placeholder
		— so swapping between them never changes the card's height. The aspect is
		declared here rather than on the iframe alone because an <iframe> has no
		intrinsic size and would otherwise collapse to its default 150px.

		`--quote-aspect` is set per card from the entry's `aspect`, so a portrait
		film gets a portrait box instead of being letterboxed inside a landscape
		one. The fallback is the 16 / 9 this rule used to hard-code.
	*/
	.quote__embed,
	.quote__video {
		display: block;
		width: 100%;
		aspect-ratio: var(--quote-aspect, 16 / 9);
		background: var(--color-ink-950);
	}

	.quote__embed {
		border: 0;
	}

	.quote__video {
		/* `contain`, not `cover`: this is a person talking to camera and a crop
		   that takes the top of their head off is worse than a letterbox. */
		object-fit: contain;
	}

	/* The lead's quote is the loudest line in the section — it is the one a
	   visitor reads before deciding whether to press play. Films-only has no
	   quote to set; see the note in the markup. */
	.quote--lead .quote__body p {
		font-size: var(--text-xl);
	}

	/* Under a centred film, a left-aligned name reads as the start of a column
	   that is not there. */
	.quote--lead-film .quote__fig {
		flex: none;
		align-items: center;
		text-align: center;
	}

	.tm__actions {
		display: flex;
		justify-content: center;
		margin-top: clamp(2rem, 4vw, 3rem);
	}

	/* ── Films-only: the wall ────────────────────────────────────────────── */
	/*
		Three clips, and nothing around them.

		The quoted version of this section is a set of cards — bordered, padded,
		filled — because a card is what a sentence needs to sit in. A film does
		not: it arrives with its own hard edge, and a panel behind it only shows
		as a margin of empty ground around the frame. What was on the page was a
		frame inside a frame inside a section, three times over.

		So in films-only the panels come off (see the note in the markup) and the
		films carry the whole composition: one large, two smaller beside it, each
		with the same edge and the same shadow.
	*/
	.tm--films .quote {
		padding: 0;
		gap: clamp(0.75rem, 1.5vw, 1rem);
	}

	.tm--films .quote--lead {
		padding: 0;
		width: 100%;
	}

	/*
		Two, side by side, until the pair moves beside the highlight at 46rem.

		Equal `1fr` tracks rather than `auto` ones: the frames state a shape and
		fill their track now, so a track sized from the frame and a frame sized
		from the track would have had nothing to resolve against.
	*/
	.tm--films .tm__grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		justify-content: center;
		align-items: stretch;
		gap: var(--wall-gap, 1rem);
		margin-block-start: var(--wall-gap, 1rem);
	}

	/* Two films side by side stop fitting somewhere around here. */
	@media (max-width: 30rem) {
		.tm--films .tm__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/*
		The frame, one per film — and the only edge in the section.

		A light bezel rather than a border: the padding IS the frame, so the ring
		has a width you can see and the film inside keeps a radius of its own
		instead of butting against a hairline. Lit from the top, shadowed at the
		bottom, the way a physical mount catches a room.

		`border: 0` because the shared `.quote__film` rule sets one, and a hairline
		outside a bezel reads as a second frame around the first.
	*/
	.tm--films .quote__film {
		padding: clamp(0.3rem, 0.7vw, 0.45rem);
		border: 0;
		border-radius: clamp(0.85rem, 1.6vw, 1.15rem);
		background:
			linear-gradient(
				170deg,
				color-mix(in oklab, #eaf2ff 92%, transparent) 0%,
				color-mix(in oklab, #b9cbe4 88%, transparent) 48%,
				color-mix(in oklab, #7e93b3 90%, transparent) 100%
			);
		box-shadow:
			inset 0 1px 0 #fff,
			inset 0 -1px 0 color-mix(in oklab, #0b1020 22%, transparent),
			0 26px 52px -26px #000;
	}

	/*
		The wall: one large film with two smaller ones stacked beside it.

		Every measurement comes off `--wall-lead`. The pair's column is that width
		over 1.7 and the gap is 3% of it — the proportions of the reference
		composition, derived rather than clamped independently, so the three tiles
		hold that arrangement at every width instead of drifting apart as separate
		clamps resolve at different rates.

		`align-items: start`, with the pair given the highlight's FILM height
		below. Stretching instead measures the lead's whole column — the film plus
		the caption under it — and pushes the pair that much taller than the film
		it is supposed to line up with.
	*/
	.tm--films .tm__films {
		/*
			The two frame shapes, as ratios rather than pairs so the heights below
			can be calculated from them. 1.35 is the reference's own proportion, a
			shade wider than 4:3; 1.65 is whatever the smaller frame has to be for
			two of them plus a gap to come out level with the tall one.
		*/
		--wall-lead-ar: 1.35;
		--wall-side-ar: 1.65;
		--wall-lead: clamp(18rem, 52vw, 36rem);
		--wall-side: calc(var(--wall-lead) / 1.7);
		--wall-gap: calc(var(--wall-lead) * 0.03);
		/* How far up the source the visible band sits. See the crop, below. */
		--film-shift: 16%;
		display: grid;
		grid-template-columns: min(100%, 34rem);
		gap: var(--wall-gap);
		justify-content: center;
		align-items: start;
	}

	/*
		Landscape frames, portrait footage.

		Every one of these clips came off a phone — two at 9:16 and one at 20:43,
		taller still — and the wall is built of wide frames. Dropped in at their
		own aspect they pillarbox: a stamp of video with dead ground either side,
		which the old wall avoided by making the FRAMES tall instead and got a
		column of three phone screens for it.

		So the frame states the shape the composition wants and the player COVERS
		it — full width, its own height, overflowing the frame and clipped by it.
		More than half the height of a 9:16 source goes that way, which is why the
		band is anchored (`--film-focus`) rather than simply centred. Nothing is
		lost by the crop: the tile is a button, and the modal it opens plays the
		film whole at its own aspect.

		The portrait wall's width cap comes off in here — the film fills its
		track, and the track is the layout.
	*/
	.tm--films .quote__film--portrait {
		width: 100%;
	}

	.tm--films .quote--lead .quote__film {
		aspect-ratio: var(--wall-lead-ar);
	}

	.tm--films .tm__grid .quote__film {
		aspect-ratio: var(--wall-side-ar);
	}

	/* The content area, and the clip — see the note in the markup. */
	.tm--films .quote__pic {
		position: relative;
		height: 100%;
		border-radius: clamp(0.55rem, 1.1vw, 0.75rem);
		background: #0b1020;
		overflow: hidden;
	}

	.tm--films .quote__embed,
	.tm--films .quote__video {
		position: absolute;
		top: 50%;
		left: 0;
		/*
			Centred in the frame, then nudged down by a slice of its OWN height —
			`translate` resolves percentages against the element, so this is a shift
			through the source and means the same thing to a 9:16 clip as to a 20:43
			one. Down by 16% shows a band 16% further up the film: a face sits above
			the middle of a phone video, and a straight centre crop puts it at the
			frame's top edge.
		*/
		translate: 0 calc(-50% + var(--film-shift, 0%));
		width: 100%;
		height: auto;
		aspect-ratio: var(--quote-aspect, 9 / 16);
	}

	/*
		The pair beside the highlight rather than under it.

		Under it, the section was a tall column with the whole right half of the
		band empty. Beside it they read as what they are: one film being offered
		and two more available.
	*/
	@media (min-width: 46rem) {
		.tm--films .tm__films {
			grid-template-columns: var(--wall-lead) var(--wall-side);
		}

		/*
			The pair, exactly as tall as the film beside them.

			The height is stated and split into two equal rows rather than left to
			two aspect-ratios and a gap to add up. Those can be made to come out
			close, and close is a visible step at the foot of the wall.
		*/
		.tm--films .tm__grid {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: 1fr 1fr;
			height: calc(var(--wall-lead) / var(--wall-lead-ar));
			margin-block-start: 0;
		}

		/* Down the chain — row, card, figure, frame — so the row IS the film. */
		.tm--films .tm__grid > .quote,
		.tm--films .tm__grid .quote__fig,
		.tm--films .tm__grid .quote__film {
			height: 100%;
		}

		.tm--films .tm__grid .quote__film {
			aspect-ratio: auto;
		}
	}

	/* ── The tile's control ──────────────────────────────────────────────── */
	/*
		Covers the whole tile. The player underneath is the picture and this is the
		press — see the note in the markup.
	*/
	.tm--films .quote__film {
		position: relative;
		isolation: isolate;
		transition:
			transform 0.4s var(--ease-out-quint),
			box-shadow 0.4s var(--ease-out-quint),
			border-color 0.4s var(--ease-out-quint);
	}

	.tm--films .quote__embed,
	.tm--films .quote__video {
		/* The tile is the control. Nothing inside it takes a click. */
		pointer-events: none;
	}

	.quote__play {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: grid;
		place-items: center;
		padding: 0;
		border: 0;
		background: radial-gradient(
			54% 42% at 50% 50%,
			color-mix(in oklab, var(--color-ink-950) 40%, transparent),
			transparent 78%
		);
		cursor: pointer;
		opacity: 0.92;
		transition: opacity 0.35s var(--ease-out-quint);
	}

	/*
		Glass, over moving footage — the one place on this site where a backdrop
		blur has something real to work with.
	*/
	.quote__play-disc {
		display: grid;
		place-items: center;
		width: clamp(2.5rem, 4.5vw, 3.5rem);
		height: clamp(2.5rem, 4.5vw, 3.5rem);
		border: 1px solid color-mix(in oklab, #e6ecf5 30%, transparent);
		border-radius: 50%;
		background-color: color-mix(in oklab, var(--color-ink-950) 38%, transparent);
		backdrop-filter: blur(10px) saturate(150%);
		color: var(--color-bone-50);
		box-shadow: 0 14px 34px -18px #000;
		transition: transform 0.35s var(--ease-out-quint);
	}

	.quote__play-disc svg {
		width: 42%;
		height: 42%;
		/* The triangle sits visually left of centre in its own box. */
		translate: 8% 0;
	}

	.quote__play:hover,
	.quote__play:focus-visible {
		opacity: 1;
	}

	.quote__play:hover .quote__play-disc,
	.quote__play:focus-visible .quote__play-disc {
		transform: scale(1.08);
	}

	.tm--films .quote__film:has(.quote__play:hover),
	.tm--films .quote__film:has(.quote__play:focus-visible) {
		transform: translateY(-3px);
		border-color: color-mix(in oklab, var(--color-arc-400) 45%, transparent);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #e6ecf5 14%, transparent),
			0 40px 80px -34px color-mix(in oklab, var(--color-arc-600) 70%, transparent);
	}

	/*
		The caption.

		"Featured Testimonial:" then the name, on one line and centred under the
		highlight. The label is quieter and the name carries the emphasis, so the
		line reads as one sentence rather than as a heading over a value.
	*/
	.tm--films .quote__by--film {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 0.35rem;
		padding-block-start: clamp(0.55rem, 1.2vw, 0.85rem);
	}

	.tm--films .quote__kicker {
		font-size: var(--text-sm);
		color: var(--color-bone-300);
	}

	.tm--films .quote__name {
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	/* ── The modal ───────────────────────────────────────────────────────── */
	/*
		Fills the viewport and centres its own frame, so a click that lands on the
		dialog itself is a click on the backdrop and can close it. A dialog sized
		to its contents has no such area.
	*/
	.tmdlg {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		overflow: hidden;
	}

	.tmdlg::backdrop {
		background: color-mix(in oklab, #02040a 82%, transparent);
		backdrop-filter: blur(6px);
	}

	/*
		The entrance.

		`display` is discrete, so a dialog cannot normally be transitioned in — it
		is either in the top layer or it is not. `allow-discrete` plus a
		`@starting-style` block is what makes the two ends animatable: the browser
		holds the element visible through the exit and reads the starting values on
		the way in. Engines without it get the modal instantly, which is the
		correct fallback for a control rather than a decoration.
	*/
	.tmdlg,
	.tmdlg::backdrop {
		opacity: 0;
		transition:
			opacity 0.28s var(--ease-out-quint),
			display 0.28s allow-discrete,
			overlay 0.28s allow-discrete;
	}

	.tmdlg[open],
	.tmdlg[open]::backdrop {
		opacity: 1;
	}

	@starting-style {
		.tmdlg[open],
		.tmdlg[open]::backdrop {
			opacity: 0;
		}
	}

	.tmdlg__frame {
		--tmdlg-pad: clamp(1rem, 4vw, 2.5rem);
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		padding: var(--tmdlg-pad);
	}

	/*
		Sized from the ratio, not from a percentage.

		This was `height: min(100%, 46rem)` with `width: auto`, and it collapsed:
		the iframe is a centred grid item, so its row is auto-sized, so a
		percentage height had nothing definite to resolve against — the player came
		out at its intrinsic 300x150 or smaller and the modal looked empty.

		So the WIDTH is computed and the aspect ratio derives the height from it.
		Three bounds, whichever is smallest: the window's width less the padding,
		a 46rem cap so the film does not fill a cinema display, and the height the
		window can actually give converted into a width by the clip's own ratio.
		That last one is what keeps a 9:16 film's bottom on screen, and because it
		is a width rather than a height cap the aspect ratio is never violated.

		`--film-w` / `--film-h` are set by the script off the pressed tile, so each
		clip gets its own proportions and nothing letterboxes inside anything.
	*/
	.tmdlg__embed {
		--film-w: 9;
		--film-h: 16;
		inline-size: min(
			calc(100vw - var(--tmdlg-pad) * 2),
			46rem,
			calc((100dvh - var(--tmdlg-pad) * 2) * var(--film-w) / var(--film-h))
		);
		block-size: auto;
		aspect-ratio: var(--film-w) / var(--film-h);
		border: 0;
		border-radius: clamp(0.75rem, 1.5vw, 1.125rem);
		background: #000;
		box-shadow: 0 60px 120px -50px #000;
		/* Rises the last few pixels as the backdrop fades in. */
		transition: translate 0.32s var(--ease-out-quint);
	}

	@starting-style {
		.tmdlg[open] .tmdlg__embed {
			translate: 0 1.5rem;
		}
	}

	.tmdlg__close {
		position: absolute;
		inset-block-start: clamp(0.75rem, 2vw, 1.25rem);
		inset-inline-end: clamp(0.75rem, 2vw, 1.25rem);
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid color-mix(in oklab, #e6ecf5 20%, transparent);
		border-radius: 50%;
		background: color-mix(in oklab, var(--color-ink-950) 60%, transparent);
		backdrop-filter: blur(10px);
		color: var(--color-bone-50);
		cursor: pointer;
		transition:
			background-color 0.28s var(--ease-out-quint),
			border-color 0.28s var(--ease-out-quint);
	}

	.tmdlg__close:hover,
	.tmdlg__close:focus-visible {
		border-color: color-mix(in oklab, var(--color-arc-400) 60%, transparent);
		background: color-mix(in oklab, var(--color-ink-900) 82%, transparent);
	}

	.tmdlg__close svg {
		width: 1.125rem;
		height: 1.125rem;
	}

	/* The lift and the entrance are motion; the modal itself is not. */
	@media (prefers-reduced-motion: reduce) {
		.tm--films .quote__film,
		.quote__play,
		.quote__play-disc,
		.tmdlg,
		.tmdlg::backdrop,
		.tmdlg__embed {
			transition: none;
		}
	}

	/*
		`flex: 1` so the figure takes the card's remaining height under the frame,
		which is what lets `margin-block-start: auto` on `.quote__by` push the
		attributions onto one line across cards whose quotes run to different
		lengths.
	*/
	.quote__fig {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 1rem;
		margin: 0;
	}

	/*
		A display quotation mark, set large and dim. Decorative — the <blockquote>
		already carries the semantics, and a screen reader announcing a stray
		double-prime before every quotation helps nobody.
	*/
	/*
		DM Serif Display, not the site's usual `--font-display` — the one place
		it runs, alongside `.quote__body p` below. It ships one weight (400)
		and no bold, so the mark's old 700 comes off; the serif's own contrast
		is what used to come from the extra weight.
	*/
	.quote__mark {
		font-family: var(--font-quote);
		font-size: 3rem;
		font-weight: 400;
		line-height: 0.6;
		color: color-mix(in oklab, var(--color-arc-400) 45%, transparent);
	}

	.quote__body {
		margin: 0;
	}

	/* The one place on the site a visitor reads a serif — see the note on
	   `.quote__mark`. Tracking comes off zero: the -0.01em was closing up
	   Archivo's counters, and a serif this size does not want it. */
	.quote__body p {
		margin: 0;
		font-family: var(--font-quote);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
		color: var(--color-bone-50);
	}

	/* Pushed to the foot so the attributions line up across cards whose quotes
	   run to different lengths. */
	.quote__by {
		display: grid;
		gap: 0.1875rem;
		margin-block-start: auto;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--color-line);
	}

	/*
		Films-only: the caption sits directly under its frame, so the rule and the
		padding above it are separating two things that belong together. The
		`margin-block-start: auto` also has nothing to push against once the quote
		is gone — every card is the same height — so it only ever added a gap.
	*/
	.quote__by--film {
		margin-block-start: 0;
		padding-block-start: 0;
		border-block-start: 0;
	}

	.quote__name {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-bone-50);
	}

	/* An unnamed source should not be dressed as a named one. */
	.quote__name--anon {
		color: var(--color-bone-300);
	}

	.quote__role,
	.quote__place {
		font-size: var(--text-xs);
		line-height: 1.45;
		color: var(--color-bone-500);
	}
</style>

<script>
	/*
		The Vimeo Player SDK's shape, for the one method this file calls.
		`@vimeo/player` ships its own types, but the SDK itself is loaded from
		Vimeo's CDN rather than bundled — see the note on `loadVimeoSdk` — so
		there is no import to hang them off. This is the minimal slice instead.
	*/
	declare global {
		interface Window {
			Vimeo?: {
				Player: new (element: HTMLIFrameElement) => {
					setMuted(muted: boolean): Promise<boolean>;
				};
			};
		}
	}

	/*
		Opens the film modal.

		Everything the platform already does is left to it: `showModal()` puts the
		dialog in the top layer, makes the page behind it inert, traps focus and
		closes on Escape. This adds the three things it does not —

		  the film     the <iframe> has no `src` until a tile is pressed, so three
		               players are never loaded for a section most visitors scroll
		               past, and one is never loaded at all if nobody presses one.
		  the shape    `--film-aspect` comes off the pressed tile, so a 43:20 clip
		               and a 9:16 clip each get a frame of their own proportions
		               rather than one letterboxing inside the other.
		  the silence  clearing `src` on close. A <dialog> that closes with a Vimeo
		               player still in it is a closed dialog that is still talking.

		No JS, or an engine without <dialog>: nothing here runs, the buttons do
		nothing, and the tiles remain the inline players they already are. That is
		why the <iframe> under each tile is a real player rather than a still.
	*/
	/*
		The Player SDK, for one call: `setMuted(false)`.

		Sound is the whole point of this modal — a testimonial with no audio is
		a silent video of someone talking — but no browser starts a cross-origin
		iframe's audio the instant `src` is set, whatever the URL asks for and
		whatever gesture asked for it. The one thing every browser DOES honour is
		unmuting an already-playing player from inside a click handler, which is
		why `data-film-src` carries `muted=1` and this SDK call is what takes it
		back off, in the same synchronous handler as the click.

		Loaded lazily, from `https://player.vimeo.com` — already in `script-src`
		in netlify.toml for exactly this — and only once the section is close
		enough to reach that a click is plausible, not on every page load. A
		visitor who never scrolls here never fetches it.
	*/
	let vimeoSdk: Promise<void> | undefined;
	function loadVimeoSdk(): Promise<void> {
		vimeoSdk ??= new Promise((resolve, reject) => {
			const script = document.createElement('script');
			script.src = 'https://player.vimeo.com/api/player.js';
			script.addEventListener('load', () => resolve());
			script.addEventListener('error', () => reject(new Error('Vimeo Player SDK failed to load')));
			document.head.append(script);
		});
		return vimeoSdk;
	}

	const section = document.querySelector<HTMLElement>('#testimonials');
	if (section) {
		const preload = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				preload.disconnect();
				void loadVimeoSdk();
			},
			{ rootMargin: '800px 0px' },
		);
		preload.observe(section);
	}

	const dialog = document.querySelector<HTMLDialogElement>('[data-film-dialog]');
	const frame = document.querySelector<HTMLIFrameElement>('[data-film-frame]');

	if (dialog && frame && typeof dialog.showModal === 'function') {
		const close = () => dialog.close();

		for (const button of document.querySelectorAll<HTMLElement>('[data-film-open]')) {
			button.addEventListener('click', () => {
				const src = button.dataset.filmSrc;
				if (!src) return;
				frame.src = src;
				/*
					The clip's shape, as two numbers.

					The stylesheet needs the ratio's terms separately — it divides them
					to turn the height the window can give into a width. `aspect-ratio`
					takes the pair as well, so one parse feeds both.
				*/
				const [w, h] = (button.dataset.filmAspect ?? '9 / 16').split('/');
				frame.style.setProperty('--film-w', (w ?? '9').trim());
				frame.style.setProperty('--film-h', (h ?? '16').trim());
				frame.title = button.dataset.filmLabel ?? frame.title;
				dialog.showModal();

				/* Un-silences the clip the moment the SDK can reach it — see the
				   note above. `frame.src` above already started it muted. */
				void loadVimeoSdk().then(() => {
					const player = new window.Vimeo!.Player(frame);
					void player.setMuted(false);
				});
			});
		}

		dialog.querySelector('[data-film-close]')?.addEventListener('click', close);

		/*
			A click on the dialog itself is a click on the backdrop: the frame fills
			it and swallows presses that land on the film or the close button, so
			anything reaching this listener came from the margin around them.
		*/
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) close();
		});

		/* Fires for the close button, the backdrop and Escape alike. */
		dialog.addEventListener('close', () => {
			frame.removeAttribute('src');
		});
	}
</script>
