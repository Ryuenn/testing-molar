---
/**
 * Section 05 — the social media plans.
 *
 * A band around the existing `Pricing` grid rather than a second copy of it.
 * Those three cards carry live Stripe Payment Links; there must only ever be
 * one component rendering them, or the day a price changes there are two
 * places to change it and one of them will be missed.
 *
 * `head={false}` because this section supplies its own eyebrow and headline —
 * the strategy's, which is about the practice rather than about the price
 * list. Pricing's own heading ("Pick your level") still runs on /pricing/.
 */
import PlansField from '~/components/ui/PlansField.astro';
import Pricing from '~/components/sections/Pricing.astro';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<section id="social" class="section section-rule plans-band" aria-labelledby="social-heading">
	<PlansField />
	<div class="container-content">
		<header class="plans-band__head">
			<p class="eyebrow" data-reveal="fade">{t('social.eyebrow')}</p>
			<h2 id="social-heading" class="plans-band__title" data-reveal>{t('social.heading')}</h2>
			<p class="plans-band__lede measure-wide" data-reveal>{t('social.lede')}</p>
		</header>
	</div>

	<Pricing head={false} />
</section>

<style>
	/*
		The band paints the plans field, heading and all.

		Same arrangement as PageIntro's `ground="plans"` on /pricing/ and
		/social-media/, and for the same reason: the heading and the grid are
		siblings, so a ground on the grid alone starts halfway down and leaves the
		heading on the page's own — which reads as two sections rather than one.

		`PlansField` is the video; this rule is the box it fills. Positioned so its
		`inset: 0` has something to measure against, isolated so its negative
		z-index stays inside the section, and dark underneath for reduced motion,
		where the video is not rendered at all.

		Padding: `.section` gives this `--section-y` at both ends, and both ends
		were wrong. The top ran to 144px of empty sky before the eyebrow. The
		bottom stacked on the grid's own closing padding, so the ground ran on for
		the better part of 200px below the footnote — the grid's padding is the one
		that belongs to the content, this one is just the wrapper.

		`border-top` goes with it: a hairline across the top of a moving picture is
		a seam, and the footage's own dark upper edge does that job already.
	*/
	.plans-band {
		position: relative;
		isolation: isolate;
		background-color: var(--color-ink-950);
		padding-block: clamp(2.5rem, 5vw, 4rem) 0;
		border-top: 0;
	}

	.plans-band__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}

	.plans-band__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.plans-band__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}
</style>
