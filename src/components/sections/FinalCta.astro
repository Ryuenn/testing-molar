---
/**
 * Section 15 — the close.
 *
 * Two lines, one button, and the trust marks underneath. Dark, minimal, and
 * deliberately the quietest section on the page in everything except type size:
 * by the time a reader gets here they have been asked six times, and a seventh
 * loud ask reads as desperation rather than confidence.
 *
 * The second line is a separate paragraph rather than a second sentence in the
 * heading. It is the turn — "your patients are already consuming content" is an
 * observation, "make sure it is helping your practice" is the ask — and the two
 * want the beat between them that only a line break gives.
 *
 * `ClosingCta` still exists and still runs on the inner pages. This is the home
 * page's own close, because the home page is now selling an ecosystem rather
 * than a subscription and the two need different last words.
 */
import { CTA } from '~/data/site';
import { PROOF_HEADLINE } from '~/data/proof';
import { COUNTRIES, countryName } from '~/data/reach';
import { flagOf } from '~/data/customers';
import { productById } from '~/data/products';
import { WORK } from '~/data/work';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const FLAGS = COUNTRIES.map((country) => ({
	flag: flagOf(country.code),
	name: countryName(country, locale),
}));

/* The practice names run under the close as a quiet marquee — the same list
   the trust band at the top of the page carries, so the page opens and shuts
   on the same names. */
const TRACKS = [0, 1];
---

<section id="start" class="fin" aria-labelledby="fin-heading">
	<div class="container-content fin__inner">
		<h2 id="fin-heading" class="fin__title" data-reveal>{t('final.heading')}</h2>
		<p class="fin__second" data-reveal>{t('final.second')}</p>

		<div class="fin__actions" data-reveal>
			<a class="btn btn-primary fin__cta" href={localizePath(productById('complete').href, locale)}>
				{t('final.cta')} <span aria-hidden="true">→</span>
			</a>
			<a class="btn btn-ghost" href={CTA.sales.href} target="_blank" rel="noopener">
				{t('final.secondary')}
				<span class="sr-only">{t('footer.newTab')}</span>
			</a>
		</div>

		<p class="fin__note" data-reveal>{t('final.note')}</p>

		<ul class="fin__flags" data-reveal="fade">
			{
				FLAGS.map((country) => (
					<li class="fin__flag">
						<span aria-hidden="true">{country.flag}</span>
						{country.name}
					</li>
				))
			}
			<li class="fin__flag fin__flag--stat">{PROOF_HEADLINE}</li>
		</ul>
	</div>

	<div class="marquee fin__marquee" data-reveal="fade">
		{
			TRACKS.map(() => (
				<div class="marquee__track" aria-hidden="true">
					{WORK.map((account) => (
						<span class="fin__client">{account.practice}</span>
					))}
				</div>
			))
		}
	</div>

	<div class="fin__glow" aria-hidden="true"></div>
	<div class="grain" aria-hidden="true"></div>
</section>

<style>
	.fin {
		position: relative;
		padding-block: clamp(5.5rem, 11vw, 10rem) clamp(3rem, 6vw, 5rem);
		overflow: clip;
		/* No ground of its own — the lit page background shows through. */
		isolation: isolate;
		border-top: 1px solid var(--color-line);
	}

	.fin__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
	}

	.fin__title {
		margin: 0;
		max-width: 20ch;
		font-size: var(--text-4xl);
		letter-spacing: -0.03em;
	}

	/*
		The turn. Same size as the heading and the accent colour, so the two lines
		read as one statement in two beats rather than as a headline with a
		subtitle under it.
	*/
	.fin__second {
		margin: 0;
		max-width: 20ch;
		font-family: var(--font-display);
		font-size: var(--text-4xl);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.08;
		text-wrap: balance;
		color: var(--color-arc-300);
		text-shadow: 0 0 44px color-mix(in oklab, var(--color-arc-500) 40%, transparent);
	}

	.fin__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-block-start: clamp(0.75rem, 2vw, 1.5rem);
	}

	.fin__cta {
		padding-inline: 1.9rem;
	}

	.fin__note {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-bone-500);
	}

	.fin__flags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin: clamp(1.25rem, 3vw, 2rem) 0 0;
		padding: 0;
		list-style: none;
	}

	.fin__flag {
		display: inline-flex;
		align-items: center;
		gap: 0.4375rem;
		height: 2rem;
		padding-inline: 0.6875rem;
		border-radius: 999px;
		border: 1px solid var(--color-line);
		font-size: var(--text-xs);
		line-height: 1;
		white-space: nowrap;
		color: var(--color-bone-400);
	}

	.fin__flag--stat {
		border-color: color-mix(in oklab, var(--color-arc-400) 40%, transparent);
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--color-bone-50);
	}

	/*
		Decorative throughout — both tracks are aria-hidden. The names are already
		carried, as links, by the trust band at the top of the page and by
		/our-work/; down here they are a texture, and a screen reader being read
		fourteen practice names on its way out of the document is not an
		improvement.
	*/
	.fin__marquee {
		--marquee-duration: 74s;
		margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
		opacity: 0.5;
	}

	.fin__client {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 500;
		white-space: nowrap;
		color: var(--color-bone-500);
	}

	/* One wide bloom rising from behind the button. */
	.fin__glow {
		position: absolute;
		z-index: -1;
		inset-block-end: -18rem;
		inset-inline-start: 50%;
		width: min(80rem, 130%);
		height: 34rem;
		transform: translateX(-50%);
		border-radius: 50%;
		pointer-events: none;
		background: radial-gradient(
			50% 50% at 50% 50%,
			color-mix(in oklab, var(--color-arc-500) 26%, transparent),
			color-mix(in oklab, var(--color-arc-700) 15%, transparent) 45%,
			transparent 76%
		);
		filter: blur(70px);
	}
</style>
