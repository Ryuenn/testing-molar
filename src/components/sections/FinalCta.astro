---
/**
 * The close.
 *
 * The headline, the offer, the price, one button, and a band of flags. Dark,
 * minimal, and deliberately the quietest section on the page in everything
 * except type size: by the time a reader gets here they have been asked five
 * times, and a sixth loud ask reads as desperation rather than confidence.
 *
 * The bottom of this page is supposed to get SIMPLER, not busier. Three things
 * came off in the same pass:
 *
 *   the second button   "Talk to MOLAR", beside the primary. There is one
 *                       thing to do at the foot of this page and it costs $97.
 *   the country pills   eighteen named chips, each with an emoji flag, wrapped
 *                       over four lines. The claim is "18 countries, 6
 *                       continents"; the list of which eighteen is a detail
 *                       nobody reads at the end of a sales page.
 *   the practice names  a marquee of the same practices the logo wall at the
 *                       top of the page already shows, in type rather than in
 *                       marks.
 *
 * What replaced the pills is the same eighteen as a running flag band — the
 * picture the claim above it makes, without asking anyone to read it.
 */
import { EDUCATION_CHECKOUT } from '~/data/site';
import { EDUCATION_PRICE, EDUCATION_TRIAL_DAYS } from '~/data/education';
import { COUNTRIES, REGIONS, countryName } from '~/data/reach';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

/*
	Real flags, not emoji: HatScripts/circle-flags (MIT), vendored into
	`public/flags/` rather than hotlinked so the CSP stays locked to 'self'.
	They are `<img>` rather than inlined SVG on purpose — every one of those
	files carries a `mask id="a"`, and eighteen inlined on one page would be
	eighteen elements fighting over the same id.
*/
const FLAGS = COUNTRIES.map((country) => ({
	src: `/flags/${country.code}.svg`,
	name: countryName(country, locale),
}));

/* The marquee needs two identical tracks: the first scrolls a full -100% of
   its own width while the second slides in behind it, so the seam never
   shows. */
const TRACKS = [0, 1];
---

<section id="start" class="fin" aria-labelledby="fin-heading">
	<div class="container-content fin__inner">
		<h2 id="fin-heading" class="fin__title" data-reveal>{t('final.heading')}</h2>
		<p class="fin__second" data-reveal>{t('final.second')}</p>

		{/* The price, between the promise and the button. Same two constants the
		    hero and the plan card read. */}
		<p class="fin__offer" data-reveal>
			{t('final.offer', { n: EDUCATION_TRIAL_DAYS, price: EDUCATION_PRICE })}
		</p>

		<div class="fin__actions" data-reveal>
			<a class="btn btn-primary fin__cta" href={EDUCATION_CHECKOUT} rel="noopener">
				{t('final.cta')} <span aria-hidden="true">→</span>
			</a>
		</div>

		<p class="fin__note" data-reveal>
			{t('final.note', { countries: COUNTRIES.length, regions: REGIONS.length })}
		</p>
	</div>

	{/*
		The eighteen, running. Decorative as a whole — it is one list said twice
		over in two copies — so the band is hidden from assistive tech and the
		countries are named once, in order, by the sr-only list beside it.
	*/}
	<div class="marquee fin__flags" aria-hidden="true" data-reveal="fade">
		{
			TRACKS.map(() => (
				<div class="marquee__track">
					{FLAGS.map((country) => (
						<img
							class="fin__flag"
							src={country.src}
							alt=""
							width="44"
							height="44"
							loading="lazy"
							decoding="async"
						/>
					))}
				</div>
			))
		}
	</div>
	<ul class="sr-only">
		{FLAGS.map((country) => <li>{country.name}</li>)}
	</ul>

	<div class="fin__glow" aria-hidden="true"></div>
	<div class="grain" aria-hidden="true"></div>
</section>

<style>
	.fin {
		position: relative;
		padding-block: clamp(5.5rem, 11vw, 10rem) clamp(3rem, 6vw, 5rem);
		overflow: clip;
		/* No ground of its own — the lit page background shows through. */
		isolation: isolate;
		border-top: 1px solid var(--color-line);
	}

	.fin__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
	}

	.fin__title {
		margin: 0;
		max-width: 20ch;
		font-size: var(--text-4xl);
		letter-spacing: -0.03em;
	}

	/*
		The offer, under the headline. Smaller than the heading and in the body
		colour — it is the specification, not the promise, and setting it at
		display size would make the close read as two headlines.
	*/
	.fin__second {
		margin: 0;
		max-width: 44ch;
		font-size: var(--text-lg);
		line-height: 1.55;
		text-wrap: balance;
		color: var(--color-bone-300);
	}

	/* The price. The one lit thing between the headline and the button. */
	.fin__offer {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-arc-300);
		text-shadow: 0 0 40px color-mix(in oklab, var(--color-arc-500) 38%, transparent);
	}

	.fin__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-block-start: clamp(0.75rem, 2vw, 1.5rem);
	}

	.fin__cta {
		padding-inline: 1.9rem;
	}

	.fin__note {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-bone-400);
	}

	/*
		The eighteen markets, running. `.marquee` and `.marquee__track` are the
		site's own, from global.css — the loop, the hover pause and the
		reduced-motion off switch all come with them — and only the measurements
		are set here.
	*/
	.fin__flags {
		--marquee-duration: 64s;
		margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
	}

	.fin__flag {
		flex: none;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999px;
		box-shadow:
			0 0 0 1px color-mix(in oklab, #dbe8ff 20%, transparent),
			0 8px 20px -10px #000;
	}

	/* One wide bloom rising from behind the button. */
	.fin__glow {
		position: absolute;
		z-index: -1;
		inset-block-end: -18rem;
		inset-inline-start: 50%;
		width: min(80rem, 130%);
		height: 34rem;
		transform: translateX(-50%);
		border-radius: 50%;
		pointer-events: none;
		background: radial-gradient(
			50% 50% at 50% 50%,
			color-mix(in oklab, var(--color-arc-500) 26%, transparent),
			color-mix(in oklab, var(--color-arc-700) 15%, transparent) 45%,
			transparent 76%
		);
		filter: blur(70px);
	}
</style>
