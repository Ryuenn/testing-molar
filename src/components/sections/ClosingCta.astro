---
import { CTA } from '~/data/site';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<section id="start" class="close section-rule" aria-labelledby="close-heading">
	<div class="container-content close__inner">
		<h2 id="close-heading" class="close__title" data-reveal>
			{t('close.heading')}
		</h2>

		<p class="close__lede" data-reveal>
			{t('close.lede')}
		</p>

		<div class="close__actions" data-reveal>
			<a href={localizePath(CTA.primary.href, locale)} class="btn btn-primary close__cta">{t('cta.start')}</a>
			<a href={CTA.sales.href} class="btn btn-ghost">{t('cta.sales')}</a>
		</div>

		<p class="close__note" data-reveal>{t('close.note')}</p>
	</div>

	<div class="close__glow" aria-hidden="true"></div>
	<div class="grain" aria-hidden="true"></div>
</section>

<style>
	.close {
		position: relative;
		padding-block: clamp(5.5rem, 11vw, 10rem);
		overflow: clip;
		background: var(--color-ink-950);
		isolation: isolate;
	}

	.close__glow {
		position: absolute;
		inset-block-end: -40%;
		inset-inline-start: 50%;
		translate: -50% 0;
		width: min(120%, 60rem);
		aspect-ratio: 2 / 1;
		z-index: -1;
		background: radial-gradient(
			50% 50% at 50% 50%,
			color-mix(in oklab, var(--color-arc-500) 26%, transparent),
			transparent 70%
		);
		filter: blur(20px);
	}

	.close__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		text-align: center;
	}

	.close__title {
		margin: 0;
		font-size: var(--text-4xl);
		max-width: 16ch;
	}

	.close__lede {
		margin: 0;
		max-width: 52ch;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	.close__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.close__cta {
		padding-inline: 2.25rem;
	}

	.close__note {
		margin: 0.5rem 0 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		color: var(--color-bone-500);
	}
</style>
