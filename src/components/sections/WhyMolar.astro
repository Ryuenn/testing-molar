---
/**
 * Section 13 — why MOLAR. Six blocks.
 *
 * Six, and not the four or eight a grid would rather have. Each block answers a
 * different objection, and dropping two to make the rows even would drop two
 * objections. Three columns divide six exactly, which is why the wide layout is
 * three across rather than four.
 *
 * No panels. Every band above this one is cards on glass, and by this point in
 * the page another row of them reads as more of the same — these are set on the
 * ground with a hairline over each, which is the quietest way to say "six
 * facts" after a page of argument.
 */
import Glyph from '~/components/ui/Glyph.astro';
import { WHY } from '~/data/ecosystem';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const BLOCKS = WHY.map((block) => ({
	icon: block.icon,
	title: t(`why.${block.key}Title` as 'why.dentalTitle'),
	body: t(`why.${block.key}Body` as 'why.dentalBody'),
}));
---

<section id="why" class="section section-rule why" aria-labelledby="why-heading">
	<div class="container-content">
		<header class="why__head">
			<p class="eyebrow" data-reveal="fade">{t('why.eyebrow')}</p>
			<h2 id="why-heading" class="why__title" data-reveal>{t('why.heading')}</h2>
			<p class="why__lede measure-wide" data-reveal>{t('why.lede')}</p>
		</header>

		<ul class="why__grid" data-reveal-stagger>
			{
				BLOCKS.map((block) => (
					<li class="fact" data-reveal data-reveal-group>
						<span class="fact__icon" aria-hidden="true">
							<Glyph name={block.icon} />
						</span>
						<h3 class="fact__title">{block.title}</h3>
						<p class="fact__body">{block.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.why__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.why__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.why__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	/*
		`auto-fit` with a 17rem floor lands on one column on a phone, two on a
		tablet and three on a laptop — and six divides all three exactly, so no
		layout of this grid ever leaves a hole on the last row.
	*/
	.why__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
		gap: clamp(1.75rem, 3.5vw, 3rem) clamp(1.5rem, 3vw, 3rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.fact {
		display: grid;
		gap: 0.625rem;
		padding-block-start: 1.25rem;
		border-block-start: 1px solid var(--color-line);
	}

	.fact__icon {
		width: 1.5rem;
		height: 1.5rem;
		color: var(--color-arc-300);
		filter: drop-shadow(0 0 10px color-mix(in oklab, var(--color-arc-500) 40%, transparent));
	}

	.fact__title {
		margin: 0.25rem 0 0;
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.3;
	}

	.fact__body {
		margin: 0;
		max-width: 42ch;
		font-size: var(--text-sm);
		line-height: 1.65;
		color: var(--color-bone-400);
	}
</style>
