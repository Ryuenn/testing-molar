---
/**
 * Section 06 — show it, do not explain it.
 *
 * The heading, then seven categories as a bento wall of stills cut from real
 * delivered work.
 *
 * It used to close on `VideoReel` — nine of those same clips scrolling past in
 * a strip. That was the same body of work shown twice in a row, the second time
 * in motion, on a page that already autoplays a hero loop and a waiting-room
 * screen. The reel still runs on /our-work/, where it is the subject rather
 * than a reprise, and the button at the foot of this section is what sends
 * people there.
 *
 * Every category links somewhere real examples of it can be watched or
 * scrolled — see the note in `~/data/showcase`. A gallery whose tiles link to
 * descriptions of themselves is a menu, not a gallery.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SHOWCASE } from '~/data/showcase';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

/*
	The artwork, cut from delivered work by `scripts/generate-showcase.mjs` — one
	16:9 still per category, keyed by the same `key` the copy is. Eager, because
	these are build-time `ImageMetadata` records for <Image>.

	A category with no still would render as an empty tile, so it is dropped
	instead: the data file and the asset folder are edited separately, and a name
	in one without art in the other should cost a cell rather than leave a hole.
*/
const artFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/showcase/*.webp', {
	eager: true,
});

const CATEGORIES = SHOWCASE.map((category) => ({
	key: category.key,
	name: t(`showcase.${category.key}Name` as 'showcase.reelsName'),
	href: localizePath(category.href, locale),
	art: artFiles[`../../assets/showcase/${category.key}.webp`]?.default,
})).filter((c): c is typeof c & { art: ImageMetadata } => Boolean(c.art));
---

<section id="showcase" class="section section-rule show" aria-labelledby="show-heading">
	<div class="container-content">
		<header class="show__head">
			<p class="eyebrow" data-reveal="fade">{t('showcase.eyebrow')}</p>
			<h2 id="show-heading" class="show__title" data-reveal>{t('showcase.heading')}</h2>
			<p class="show__lede measure-wide" data-reveal>{t('showcase.lede')}</p>
		</header>

		{/*
			A bento wall: every category is a picture of itself with its name over
			it, and the two that carry the argument best — reels and carousels — take
			the larger cells.

			It was a row of cards with a small icon and a sentence each, which made
			the section that exists to SHOW the work into six paragraphs describing
			it. The names are the only words left; anything a sentence would have
			added, the picture says faster.

			The size of each cell is set in CSS off the category key rather than
			carried in the data, because it is a property of this layout and not of
			the category — the same seven appear as a plain list elsewhere.
		*/}
		<div class="show__panel">
			<ul class="show__wall" data-reveal-stagger>
			{
				CATEGORIES.map((category) => (
					<li class:list={['shot', `shot--${category.key}`]} data-reveal data-reveal-group>
						<a class="shot__link" href={category.href}>
							{/*
								Decorative: the name below is in the same link, so an alt here
								would have a screen reader read every tile twice.
							*/}
							<Image
								class="shot__art"
								src={category.art}
								alt=""
								widths={[400, 800, 1200]}
								sizes="(min-width: 62rem) 40vw, 90vw"
								loading="lazy"
							/>
							<span class="shot__name">{category.name}</span>
						</a>
					</li>
				))
			}
			</ul>
		</div>
	</div>

	{/*
		The reel strip is gone.

		`VideoReel` ran nine clips scrolling past under the wall — the same nine
		pieces of work the bento above is already made of stills from, moving. Two
		galleries of one body of work, one directly under the other, and the
		moving one played on top of a page that already carries an autoplaying
		hero loop and an autoplaying screen in the MOLAR TV section.

		The component is untouched and still runs on /our-work/, where the reel is
		the point rather than a second helping.
	*/}
	<div class="container-content">
		<p class="show__more" data-reveal>
			<a class="btn btn-ghost" href={localizePath('/our-work/', locale)}>{t('showcase.cta')}</a>
		</p>
	</div>
</section>

<style>
	/*
		Tighter than the shared `--section-y` at the top. The logo marquee above
		this is a strip rather than a section and closes on its own tight padding,
		so a full section rhythm between the two left the eyebrow starting a long
		way down empty ground.
	*/
	.show {
		padding-block-start: clamp(2rem, 4vw, 3.5rem);
	}

	.show__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.show__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.show__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	/*
		The panel the wall sits in — one sheet of glass, not seven.

		A backdrop-filter is expensive and this site has paid for that before, so
		there is exactly one on this page and it is here. It can afford to be: the
		ground behind it is the static page wash rather than a playing video, so
		the blur is sampled from something that does not change.
	*/
	.show__panel {
		padding: clamp(0.75rem, 1.8vw, 1.25rem);
		margin: 0 0 clamp(2rem, 4vw, 3rem);
		border: 1px solid var(--color-line);
		border-radius: clamp(1rem, 1.6vw, 1.5rem);
		background: color-mix(in oklab, var(--color-ink-900) 42%, transparent);
		backdrop-filter: blur(18px) saturate(130%);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #dbe8ff 9%, transparent),
			0 40px 90px -60px #000;
	}

	/*
		Three columns, and the spans are chosen so seven tiles fill nine cells with
		no hole: Reels is one column by two rows, Carousels is two by one, and the
		remaining five are single cells. Four columns cannot do that — seven tiles
		into eight or twelve cells always leaves one short.

		Reels being the tall cell is the point of the layout rather than a
		decoration: the clips ARE portrait, so it is the one tile that shows a whole
		frame instead of a slice of one.
	*/
	.show__wall {
		display: grid;
		grid-template-columns: 1fr;
		grid-auto-rows: 9rem;
		gap: clamp(0.5rem, 1vw, 0.75rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shot--reels {
		grid-row: span 2;
	}

	@media (min-width: 46rem) {
		.show__wall {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			grid-auto-rows: 11rem;
		}

		.shot--carousels {
			grid-column: span 2;
		}
	}

	@media (min-width: 68rem) {
		.show__wall {
			grid-auto-rows: 13rem;
		}
	}

	.shot {
		position: relative;
		overflow: clip;
		border-radius: clamp(0.625rem, 1vw, 0.875rem);
		background: var(--color-ink-950);
	}

	.shot__link {
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
	}

	/* Each still is already cut to its cell, so this is a fit rather than a crop
	   — see scripts/generate-showcase.mjs. */
	.shot__art {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s var(--ease-out-quint);
	}

	.shot__link:hover .shot__art,
	.shot__link:focus-visible .shot__art {
		transform: scale(1.04);
	}

	/*
		The name, over the picture, on a scrim of its own rather than over the whole
		tile: these are photographs of teeth and screens, and a label in white over
		an unscrimmed one is unreadable about half the time.
	*/
	.shot__name {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		padding: 2.25rem 0.85rem 0.7rem;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-bone-50);
		background: linear-gradient(
			180deg,
			transparent 0%,
			color-mix(in oklab, var(--color-ink-950) 62%, transparent) 46%,
			color-mix(in oklab, var(--color-ink-950) 90%, transparent) 100%
		);
	}

	.show__more {
		display: flex;
		justify-content: center;
		margin: clamp(2rem, 4vw, 3rem) 0 0;
	}

</style>
