	/* ── The modal ─────────────────────────────────────────── */
	/*
		Fills the viewport and centres its own frame, so a click that lands on the
		dialog itself is a click on the backdrop and can close it. A dialog sized to
		its contents has no such area.
	*/
	.fdlg {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		overflow: hidden;
	}

	.fdlg::backdrop {
		background: color-mix(in oklab, #02040a 82%, transparent);
		backdrop-filter: blur(6px);
	}

	/*
		The entrance.

		`display` is discrete, so a dialog cannot normally be transitioned in — it
		is either in the top layer or it is not. `allow-discrete` plus a
		`@starting-style` block is what makes both ends animatable: the browser
		holds the element visible through the exit and reads the starting values on
		the way in. Engines without it get the modal instantly, which is the correct
		fallback for a control rather than a decoration.
	*/
	.fdlg,
	.fdlg::backdrop {
		opacity: 0;
		transition:
			opacity 0.3s var(--ease-out-quint),
			display 0.3s allow-discrete,
			overlay 0.3s allow-discrete;
	}

	.fdlg[open],
	.fdlg[open]::backdrop {
		opacity: 1;
	}

	@starting-style {
		.fdlg[open],
		.fdlg[open]::backdrop {
			opacity: 0;
		}
	}

	.fdlg__frame {
		--fdlg-pad: clamp(1rem, 4vw, 2.5rem);
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		padding: var(--fdlg-pad);
	}

	/*
		Sized from the ratio, not from a percentage.

		The film is a centred grid item, so its row is auto-sized and a percentage
		height would have nothing definite to resolve against. The WIDTH is computed
		instead and the aspect derives the height from it: whichever is smallest of
		the window less its padding, a 64rem cap so the clip does not fill a cinema
		display, and the height the window can actually give turned into a width by
		the clip's own 16:9. That last bound is what keeps the controls on screen on
		a short window, and because it is a width cap the aspect is never violated.

		The pop is on the same element: it arrives a little small and a little low
		and settles as the backdrop fades in, then leaves the way it came — the base
		rule IS the exit state, and `@starting-style` repeats it for the frame
		before the entrance, which is the only thing a newly displayed element has
		to transition FROM.
	*/
	.fdlg__video {
		inline-size: min(
			calc(100vw - var(--fdlg-pad) * 2),
			64rem,
			calc((100dvh - var(--fdlg-pad) * 2) * 16 / 9)
		);
		block-size: auto;
		aspect-ratio: 16 / 9;
		border-radius: clamp(0.75rem, 1.5vw, 1.125rem);
		background: #000;
		box-shadow: 0 60px 120px -50px #000;
		scale: 0.94;
		translate: 0 1.5rem;
		transition:
			scale 0.36s var(--ease-out-quint),
			translate 0.36s var(--ease-out-quint);
	}

	.fdlg[open] .fdlg__video {
		scale: 1;
		translate: 0 0;
	}

	@starting-style {
		.fdlg[open] .fdlg__video {
			scale: 0.94;
			translate: 0 1.5rem;
		}
	}

	.fdlg__close {
		position: absolute;
		inset-block-start: clamp(0.75rem, 2vw, 1.25rem);
		inset-inline-end: clamp(0.75rem, 2vw, 1.25rem);
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid color-mix(in oklab, #e6ecf5 20%, transparent);
		border-radius: 50%;
		background: color-mix(in oklab, var(--color-ink-950) 60%, transparent);
		backdrop-filter: blur(10px);
		color: var(--color-bone-50);
		cursor: pointer;
		transition:
			background-color 0.28s var(--ease-out-quint),
			border-color 0.28s var(--ease-out-quint);
	}

	.fdlg__close:hover,
	.fdlg__close:focus-visible {
		border-color: color-mix(in oklab, #e6ecf5 40%, transparent);
		background: color-mix(in oklab, var(--color-ink-950) 80%, transparent);
	}

	.fdlg__close svg {
		width: 1.125rem;
		height: 1.125rem;
	}

	/* The lift and the entrance are motion; the modal itself is not. */
	@media (prefers-reduced-motion: reduce) {
		.film__frame,
		.film__play,
		.film__play-disc,
		.fdlg,
		.fdlg::backdrop,
		.fdlg__video {
			transition: none;
		}

		.film__play:hover .film__play-disc,
		.film__play:focus-visible .film__play-disc {
			transform: none;
		}

		.fdlg__video {
			scale: 1;
			translate: 0 0;
		}
	}
