	.film__label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-arc-300);
	}

	/*
		One cell, one video. It used to stack the poster and the video in the same
		grid area so swapping them could not reflow the page; there is nothing to
		swap now.
	*/
	.film__frame {
		position: relative;
		isolation: isolate;
		display: grid;
		overflow: clip;
		border: 1px solid var(--color-line);
		border-radius: clamp(0.75rem, 1.4vw, 1.125rem);
		background: var(--color-ink-950);
		transition:
			border-color 0.4s var(--ease-out-quint),
			box-shadow 0.4s var(--ease-out-quint);
	}

	.film__video {
		display: block;
		width: 100%;
		height: auto;
		/* The clip is 16:9 and this reserves its box before the metadata lands, so
		   the caption underneath does not jump when the first frame appears. */
		aspect-ratio: 16 / 9;
	}

	/*
		The press, over her first frame.

		Glass on moving footage — one of the few places on this site where a
		backdrop blur has something real to work with. It covers the whole tile
		rather than sitting in the middle of it, so the target is the film and the
		disc only marks where to look. Hidden in the markup and unhidden by the
		script; see the note there.
	*/
	.film__play {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: grid;
		place-items: center;
		padding: 0;
		border: 0;
		background: radial-gradient(
