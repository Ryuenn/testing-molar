---
/**
 * The case exhibit: one account, photographed twice.
 *
 * Two screenshots of the same public Instagram profile, the before drained of
 * colour and the after lit, with an arrow between them. Under each, what that
 * side of the picture amounts to — crosses on the left, ticks on the right, and
 * the headline figure above the ticks.
 *
 * Light source: there is exactly one, and it is behind the after frame. That is
 * the whole visual argument — nothing happens on the left, the light is on the
 * right.
 *
 * Layout note. The whole exhibit is ONE grid rather than two columns sitting
 * beside a third, and every part is placed into a named area. That is what lets
 * the arrow be `align-self: center` against the frame row specifically — the
 * columns are different heights once the lists are under them, so an arrow
 * centred on the column would sit well below the pictures it is pointing
 * between. It also keeps the two lists starting on the same line no matter how
 * many items each holds.
 *
 * The count-up is progressive enhancement and nothing more. The true figure is
 * server-rendered; the script only replaces it with a lower number and walks it
 * back up. No JS, reduced motion, or a scroll past before hydration all leave
 * the real number on screen, which is the only state that has to be correct.
 */
import { Image } from 'astro:assets';
import beforeShot from '~/assets/results/patricia-before.webp';
import afterShot from '~/assets/results/patricia-after.webp';
import { GROWTH } from '~/data/results';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

export interface Props {
	/** Heading level. The results page runs this under its own h1. */
	as?: 'h2' | 'h3';
}

const { as: Heading = 'h2' } = Astro.props;

const headline = GROWTH.metrics[0];
---

<section class="growth section section-rule" aria-labelledby="growth-heading">
	{/*
		One light source, declared on the section rather than the exhibit so it can
		bleed past the figure's box without being clipped by it.
	*/}
	<div class="growth__glow" aria-hidden="true"></div>
	<div class="grain" aria-hidden="true"></div>

	<div class="growth__inner">
		<header class="growth__head container-content">
			<p class="eyebrow" data-reveal="fade">{t('growth.eyebrow')} — {GROWTH.handle}</p>

			<Heading id="growth-heading" class="growth__title" data-reveal>
				{t('growth.heading', { after: headline.after })}
			</Heading>

			<p class="growth__lede measure-wide" data-reveal>
				{t('growth.lede', { name: GROWTH.name, place: GROWTH.place })}
			</p>
		</header>

		{/*
			The evidence runs wider than the prose. `.container-content`'s 76rem is a
			reading measure and the copy above keeps it; two screenshots side by side
			inside it leave each one about 500px wide, which is not enough to read a
			follower count out of. This band gets its own, wider measure instead.
		*/}
		<div class="growth__wide">
			<figure class="exhibit" data-reveal>
				<div class="exhibit__pair">
					<p class="shot__tag shot__tag--before">
						<span class="shot__dot" aria-hidden="true"></span>{t('growth.before')}
					</p>

					<div class="shot__frame shot__frame--before">
						<Image
							src={beforeShot}
							alt={t('growth.altBefore', { handle: GROWTH.handle })}
							widths={[420, 640, 900]}
							sizes="(min-width: 60rem) 42vw, 92vw"
							loading="lazy"
						/>
						<span class="shot__wash" aria-hidden="true"></span>
					</div>

					<p class="shot__read shot__read--before">{t('growth.beforeRead')}</p>

					<ul class="marks marks--no" aria-label={t('growth.wasLabel')}>
						{
							[t('growth.was1'), t('growth.was2'), t('growth.was3'), t('growth.was4')].map((item) => (
								<li class="mark">
									<span class="mark__badge" aria-hidden="true">
										<svg
											viewBox="0 0 16 16"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
										>
											<path d="m5 5 6 6M11 5l-6 6" />
										</svg>
									</span>
									{item}
								</li>
							))
						}
					</ul>

					{/*
						Decorative. Both sides are already labelled Before and After in text,
						so an arrow between them tells a screen reader nothing new.
					*/}
					<div class="exhibit__link" aria-hidden="true">
						<span class="exhibit__wire"></span>
						{GROWTH.period && <span class="exhibit__period">{GROWTH.period}</span>}
						<span class="exhibit__arrow">
							<svg
								viewBox="0 0 16 16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" />
							</svg>
						</span>
						<span class="exhibit__wire exhibit__wire--lit"></span>
					</div>

					<p class="shot__tag shot__tag--after">
						<span class="shot__dot" aria-hidden="true"></span>{t('growth.after')}
					</p>

					<div class="shot__frame shot__frame--after">
						<Image
							src={afterShot}
							alt={t('growth.altAfter')}
							widths={[420, 640, 900]}
							sizes="(min-width: 60rem) 42vw, 92vw"
							loading="lazy"
						/>
					</div>

					<p class="shot__read shot__read--after">{t('growth.afterRead')}</p>

					<div class="after">
						<p class="after__stat">
							{/*
								The true figure, server-rendered. `data-count-*` is the script's
								business; if it never runs, this text is already the answer.
							*/}
							<span
								class="after__value"
								data-count-from={headline.beforeValue}
								data-count-to={headline.afterValue}>{headline.after}</span
							>
							<span class="after__unit">{t('growth.followers')}</span>
						</p>

						<ul class="marks marks--yes" aria-label={t('growth.becameLabel')}>
							{
								[t('growth.became1'), t('growth.became2'), t('growth.became3')].map((item) => (
									<li class="mark">
										<span class="mark__badge" aria-hidden="true">
											<svg
												viewBox="0 0 16 16"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="m3.5 8.4 3 3 6-6.6" />
											</svg>
										</span>
										{item}
									</li>
								))
							}
						</ul>
					</div>
				</div>

				<figcaption class="exhibit__source">
					{t('growth.source', { handle: GROWTH.handle })}
				</figcaption>
			</figure>
		</div>
	</div>
</section>

<script>
	/*
		Count-up for the headline figure.

		Deliberately not GSAP. This is one number on one page, and the animation
		library is loaded by motion.ts for the scroll work — reaching for it here
		would couple this component to that module's lifetime for no gain. It also
		has to be safe to skip entirely; see the note in the frontmatter.

		Intl compact notation is what produces "10.2K", which is why the strings in
		results.ts are written the way they are: the animated frames and the
		server-rendered final frame have to agree, and they do because both come out
		of the same formatter.
	*/
	const values = document.querySelectorAll<HTMLElement>('[data-count-to]');
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (values.length && !still.matches && 'IntersectionObserver' in window) {
		const format = new Intl.NumberFormat(undefined, {
			notation: 'compact',
			maximumFractionDigits: 1,
		});

		const run = (el: HTMLElement) => {
			const from = Number(el.dataset.countFrom ?? 0);
			const to = Number(el.dataset.countTo ?? 0);
			if (!Number.isFinite(from) || !Number.isFinite(to)) return;

			/*
				The truth, kept aside so the last frame restores it exactly rather than
				trusting the formatter to land on the same string the server chose.
			*/
			const settled = el.textContent;
			const start = performance.now();
			const ms = 1400;

			const tick = (now: number) => {
				const t = Math.min((now - start) / ms, 1);
				/* Quintic ease-out — the same curve as --ease-out-quint, so the number
				   settles on the same beat as every other reveal on the page. */
				const eased = 1 - Math.pow(1 - t, 5);

				if (t < 1) {
					el.textContent = format.format(Math.round(from + (to - from) * eased));
					requestAnimationFrame(tick);
				} else {
					el.textContent = settled;
				}
			};

			requestAnimationFrame(tick);
		};

		const seen = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					/* Once each. A number that re-counts every time it scrolls back into
					   view reads as a bug rather than as an effect. */
					seen.unobserve(entry.target);
					run(entry.target as HTMLElement);
				}
			},
			{ rootMargin: '0px 0px -20% 0px' },
		);

		values.forEach((el) => seen.observe(el));
	}
</script>

<style>
	.growth {
		position: relative;
		isolation: isolate;
		overflow: clip;
	}

	/*
		Off-centre on purpose: it sits behind the right-hand frame, the one the
		section is arguing for. Nothing lights the left.
	*/
	.growth__glow {
		position: absolute;
		z-index: -1;
		inset-block: 12% -10%;
		inset-inline: 34% -14%;
		background:
			radial-gradient(
				46% 52% at 62% 42%,
				color-mix(in oklab, var(--color-arc-600) 32%, transparent),
				transparent 70%
			),
			radial-gradient(
				38% 40% at 78% 76%,
				color-mix(in oklab, var(--color-arc-700) 38%, transparent),
				transparent 72%
			);
		filter: blur(34px);
	}

	.growth__inner {
		position: relative;
	}

	/* Wider than the 76rem reading measure, same gutters — see the note in the
	   markup. */
	.growth__wide {
		width: 100%;
		max-width: 90rem;
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.growth__head {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: clamp(2.75rem, 5.5vw, 4.5rem);
	}

	.growth__title {
		margin: 0;
		max-width: 22ch;
		font-size: var(--text-4xl);
		/* Display sizes want their own leading; the inherited body value opens a
		   hole between the lines of a three-line heading. */
		line-height: 1.06;
		letter-spacing: -0.03em;
	}

	.growth__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	/* ── Exhibit ─────────────────────────────────────────────────────────── */
	.exhibit {
		margin: 0;
	}

	/*
		Stacked on narrow screens: the whole before side, then the arrow turned to
		point down the page, then the whole after side.
	*/
	.exhibit__pair {
		display: grid;
		grid-template-areas:
			'btag'
			'bshot'
			'bread'
			'blist'
			'arrow'
			'atag'
			'ashot'
			'aread'
			'alist';
		gap: 0.85rem;
	}

	.shot__tag--before {
		grid-area: btag;
	}
	.shot__frame--before {
		grid-area: bshot;
	}
	.shot__read--before {
		grid-area: bread;
	}
	.marks--no {
		grid-area: blist;
	}
	.exhibit__link {
		grid-area: arrow;
	}
	.shot__tag--after {
		grid-area: atag;
	}
	.shot__frame--after {
		grid-area: ashot;
	}
	.shot__read--after {
		grid-area: aread;
	}
	.after {
		grid-area: alist;
	}

	.shot__tag {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	.shot__dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--color-ink-600);
	}

	/*
		A light screenshot on a navy page has to read as a document set down on the
		table, not as a hole burned through the layout — hence the border, the lit
		top edge, and a drop shadow that grounds it.
	*/
	.shot__frame {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-line-strong);
		background: #fff;
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #fff 60%, transparent),
			0 24px 60px -36px #000;
		transition:
			border-color 0.5s var(--ease-out-quint),
			box-shadow 0.5s var(--ease-out-quint);
	}

	.shot__frame :global(img) {
		width: 100%;
		/*
			Both crops are authored square, so this only enforces what is already
			true — and keeps the pair the same height if either is ever re-cut.

			Square because it is Instagram's own shape, and because it leaves room
			under each profile header for the thing that actually lands the point:
			one lonely post on the left, a full grid on the right.

			The two crops are NOT the same pixel width, and that is deliberate. The
			after screenshot was captured at a lower browser zoom than the before, so
			cropping both to full width would render its follower count noticeably
			smaller than the one it is meant to be compared against. The after is
			cropped in until the two headers match on screen. If either screenshot is
			ever replaced, check that match before checking anything else.
		*/
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: top;
		transition: filter 0.5s var(--ease-out-quint);
	}

	/* Drained, not hidden. Every figure in it is still legible; it just is not
	   where the light is. */
	.shot__frame--before {
		border-color: var(--color-line);
	}

	.shot__frame--before :global(img) {
		filter: grayscale(0.7) contrast(0.95) brightness(0.74);
	}

	.shot__wash {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: color-mix(in oklab, var(--color-ink-900) 30%, transparent);
		transition: opacity 0.5s var(--ease-out-quint);
	}

	/* Reachable by pointer and by keyboard, so the drained state never withholds
	   the evidence from anyone. */
	.shot__frame--before:hover :global(img),
	.shot__frame--before:focus-within :global(img) {
		filter: none;
	}

	.shot__frame--before:hover .shot__wash,
	.shot__frame--before:focus-within .shot__wash {
		opacity: 0;
	}

	.shot__tag--after {
		color: var(--color-arc-300);
	}

	.shot__tag--after .shot__dot {
		background: var(--color-arc-400);
		box-shadow: 0 0 10px 1px color-mix(in oklab, var(--color-arc-400) 70%, transparent);
	}

	.shot__frame--after {
		border-color: color-mix(in oklab, var(--color-arc-400) 42%, transparent);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #fff 60%, transparent),
			0 0 0 1px color-mix(in oklab, var(--color-arc-500) 14%, transparent),
			0 34px 80px -40px color-mix(in oklab, var(--color-arc-600) 85%, transparent),
			0 24px 60px -36px #000;
	}

	.shot__read {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-bone-500);
	}

	.shot__read--after {
		color: var(--color-bone-300);
	}

	/* ── The link between them ───────────────────────────────────────────── */
	.exhibit__link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		color: var(--color-arc-400);
	}

	.exhibit__wire {
		flex: 1;
		height: 1px;
		max-width: 4rem;
		background: linear-gradient(90deg, transparent, var(--color-line-strong));
	}

	.exhibit__wire--lit {
		background: linear-gradient(
			90deg,
			color-mix(in oklab, var(--color-arc-400) 55%, transparent),
			transparent
		);
	}

	.exhibit__period {
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-bone-400);
		white-space: nowrap;
	}

	/*
		The arrow is a lit disc rather than a bare glyph. At the size the exhibit
		needs it, a 1.5px stroke on its own disappears against a busy screenshot
		edge; the disc gives it a ground and makes it read as the hinge of the
		whole picture.
	*/
	.exhibit__arrow {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		border: 1px solid color-mix(in oklab, var(--color-arc-400) 45%, transparent);
		background: color-mix(in oklab, var(--color-arc-600) 20%, transparent);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #cfe4ff 18%, transparent),
			0 0 26px -6px color-mix(in oklab, var(--color-arc-500) 70%, transparent);
		backdrop-filter: blur(8px);
	}

	.exhibit__arrow svg {
		width: 1rem;
	}

	.exhibit__source {
		margin-block-start: clamp(1.75rem, 3vw, 2.5rem);
		max-width: 68ch;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		line-height: 1.7;
		letter-spacing: 0.04em;
		color: var(--color-bone-500);
	}

	/* ── The two lists ───────────────────────────────────────────────────── */
	.marks {
		display: grid;
		gap: 0.75rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.mark {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: start;
		gap: 0.7rem;
		font-size: var(--text-sm);
		line-height: 1.5;
	}

	/*
		The badge is a disc with a glyph, not an icon font and not an emoji — both
		of those hand a screen reader something to say about a mark that is already
		explained by the list it sits in.
	*/
	.mark__badge {
		flex: none;
		display: grid;
		place-items: center;
		width: 1.375rem;
		height: 1.375rem;
		/* Optical alignment: the disc centres on the first line of the label rather
		   than on its box, which matters once a label wraps to two lines. */
		margin-block-start: 0.0625rem;
		border-radius: 50%;
		border: 1px solid currentColor;
		background: color-mix(in oklab, currentColor 14%, transparent);
	}

	.mark__badge svg {
		width: 0.6875rem;
	}

	/*
		Two tones, and they are not red and green. The after side of this exhibit is
		already lit in arc blue — the tag, the dot, the frame, the glow — so the
		ticks continue that rather than introducing a second positive colour the
		rest of the page never uses. The crosses get a desaturated rose: enough to
		read as the negative column, dim enough to belong on the side that has had
		the colour drained out of it.
	*/
	.marks--no {
		color: #c4737a;
	}

	.marks--no .mark {
		color: var(--color-bone-400);
	}

	.marks--yes {
		color: var(--color-arc-400);
	}

	.marks--yes .mark {
		color: var(--color-bone-100);
	}

	/* The badge takes its tone from the list; the label overrides back to text. */
	.marks--no .mark__badge {
		color: #c4737a;
	}

	.marks--yes .mark__badge {
		color: var(--color-arc-400);
	}

	/* ── The after side's headline figure ────────────────────────────────── */
	.after {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	.after__stat {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;
		padding-block-end: 1rem;
		border-bottom: 1px solid var(--color-line);
	}

	.after__value {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--color-bone-50);
		/* Tabular figures: the count-up runs through every width between "159" and
		   "10.2K" and must not shuffle the row on each frame. */
		font-variant-numeric: tabular-nums;
	}

	.after__unit {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-bone-400);
	}

	@media (min-width: 60rem) {
		/*
			One grid, four rows, an arrow column down the middle. Placing every part
			by area is what lets the arrow centre on the FRAME row rather than on its
			column — see the layout note in the frontmatter — and keeps both lists
			starting on the same line however many items each holds.
		*/
		.exhibit__pair {
			grid-template-columns: 1fr auto 1fr;
			grid-template-areas:
				'btag  .     atag'
				'bshot arrow ashot'
				'bread .     aread'
				'blist .     alist';
			gap: 0.85rem clamp(1.25rem, 3vw, 2.5rem);
			align-items: start;
		}

		.exhibit__link {
			/* The whole point of the named areas. */
			align-self: center;
			flex-direction: column;
			gap: 0.9rem;
			height: 100%;
			justify-content: center;
		}

		/* Vertical wires either side of the disc, so the arrow reads as a hinge
		   running between the two frames rather than as a floating chip. */
		.exhibit__wire {
			width: 1px;
			height: auto;
			max-width: none;
			max-height: 5rem;
			background: linear-gradient(180deg, transparent, var(--color-line-strong));
		}

		.exhibit__wire--lit {
			background: linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-arc-400) 55%, transparent),
				transparent
			);
		}

		.marks {
			margin-block-start: 0.75rem;
		}
	}

	@media (max-width: 59.99rem) {
		/* Stacked, so the arrow turns to point down the page. */
		.exhibit__link {
			padding-block: 0.5rem;
		}

		.exhibit__arrow svg {
			transform: rotate(90deg);
		}
	}
</style>
