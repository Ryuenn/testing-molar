	.marks--no {
		color: #c4737a;
	}

	/*
		The words, not the marks.

		These were bone-400 against bone-50 on the other side — the losing column
		literally set dimmer than the winning one, which reads as the page grading
		its own evidence. The cross keeps its rose and the tick keeps its arc blue,
		so the two columns still separate at a glance; what they no longer do is
		make one side's sentences harder to read than the other's.
	*/
	.marks--no .mark {
		color: var(--color-bone-100);
	}

	.marks--yes {
		color: var(--color-arc-400);
	}

	.marks--yes .mark {
