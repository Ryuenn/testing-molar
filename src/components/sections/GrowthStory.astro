---
/**
 * The case exhibit: one account, photographed twice.
 *
 * Two screenshots of the same public Instagram profile, the before drained of
 * colour and the after lit, with an arrow between them. Under each, what that
 * side of the picture amounts to — crosses on the left, ticks on the right, and
 * the headline figure above the ticks.
 *
 * Light source: there is exactly one, and it is behind the after frame. That is
 * the whole visual argument — nothing happens on the left, the light is on the
 * right.
 *
 * Layout note. The whole exhibit is ONE grid rather than two columns sitting
 * beside a third, and every part is placed into a named area. That is what lets
 * the arrow be `align-self: center` against the frame row specifically — the
 * columns are different heights once the lists are under them, so an arrow
 * centred on the column would sit well below the pictures it is pointing
 * between. It also keeps the two lists starting on the same line no matter how
 * many items each holds.
 *
 * The count-up is progressive enhancement and nothing more. The true figure is
 * server-rendered; the script only replaces it with a lower number and walks it
 * back up. No JS, reduced motion, or a scroll past before hydration all leave
 * the real number on screen, which is the only state that has to be correct.
 */
import { Image } from 'astro:assets';
import beforeShot from '~/assets/results/patricia-before.webp';
import afterShot from '~/assets/results/patricia-after.webp';
import { GROWTH } from '~/data/results';
import { getLocale, useTranslations } from '~/i18n/utils';

/*
	Her testimonial. The clip itself is not fetched until somebody presses play —
	`preload="metadata"` takes the headers and the first frame region and stops.

	The same cut `AssetFilm` runs on /social-media/, so the two surfaces play one
	file rather than two encodes of the same interview.

	⚠️ 8.4MB, and its `moov` atom sits at the tail — a browser has to range-request
	the end of the file before it can show a frame. That was free while this ran
	behind a poster at `preload="none"`; it now costs one round trip to the end of
	the file on every load of this page, and delays the frame appearing.
	`public/videos/README.md` carries the one-line remux that moves the atom to
	the front and fixes it. Worth doing — this is the home page.
*/
const FILM_SRC = '/videos/molar-testimonial-0721.mp4';

const locale = getLocale(Astro);
const t = useTranslations(locale);

export interface Props {
	/** Heading level. The results page runs this under its own h1. */
	as?: 'h2' | 'h3';
}

const { as: Heading = 'h2' } = Astro.props;

const headline = GROWTH.metrics[0];
---

<section class="growth section section-rule" aria-labelledby="growth-heading">
	{/*
		One light source, declared on the section rather than the exhibit so it can
		bleed past the figure's box without being clipped by it.
	*/}
	<div class="growth__glow" aria-hidden="true"></div>
	<div class="grain" aria-hidden="true"></div>

	<div class="growth__inner">
		<header class="growth__head container-content">
			{/*
				The handle is NOT in this line any more. `.eyebrow` uppercases, so
				"Case 01 — @drpatriciaharrosch" rendered as a real person's name in
				caps with the spaces removed. It still appears under the exhibit, in
				the figcaption, where it is provenance rather than a label.
			*/}
			<p class="eyebrow" data-reveal="fade">{t('growth.eyebrow')}</p>

			<Heading id="growth-heading" class="growth__title" data-reveal>
				{t('growth.heading')}
			</Heading>

			<p class="growth__lede measure-wide" data-reveal>{t('growth.lede')}</p>

			{/*
				The figure, as a line of its own between the promise and the evidence.
				Both halves come off `headline` rather than being typed, so it cannot
				drift from the count-up under the After screenshot.
			*/}
			<p class="growth__delta" data-reveal>
				{t('growth.delta', { before: headline.before, after: headline.after })}
			</p>

			<p class="growth__body measure-wide" data-reveal>
				{t('growth.body', { name: GROWTH.name })}
			</p>
			<p class="growth__body measure-wide" data-reveal>{t('growth.bodyTwo')}</p>
		</header>

		{/*
			The evidence runs wider than the prose. `.container-content`'s 76rem is a
			reading measure and the copy above keeps it; two screenshots side by side
			inside it leave each one about 500px wide, which is not enough to read a
			follower count out of. This band gets its own, wider measure instead.
		*/}
		<div class="growth__wide">
			<figure class="exhibit" data-reveal>
				<div class="exhibit__pair">
					<p class="shot__tag shot__tag--before">
						<span class="shot__dot" aria-hidden="true"></span>
						{t('growth.before', { n: headline.before })}
					</p>

					<div class="shot__frame shot__frame--before">
						<Image
							src={beforeShot}
							alt={t('growth.altBefore', { handle: GROWTH.handle })}
							widths={[420, 640, 900]}
							sizes="(min-width: 60rem) 42vw, 92vw"
							loading="lazy"
						/>
						<span class="shot__wash" aria-hidden="true"></span>
					</div>

					<p class="shot__read shot__read--before">{t('growth.beforeRead')}</p>

					<ul class="marks marks--no" aria-label={t('growth.wasLabel')}>
						{
							[t('growth.was1'), t('growth.was2'), t('growth.was3'), t('growth.was4')].map((item) => (
								<li class="mark">
									<span class="mark__badge" aria-hidden="true">
										<svg
											viewBox="0 0 16 16"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
										>
											<path d="m5 5 6 6M11 5l-6 6" />
										</svg>
									</span>
									{item}
								</li>
							))
						}
					</ul>

					{/*
						Decorative. Both sides are already labelled Before and After in text,
						so an arrow between them tells a screen reader nothing new.
					*/}
					<div class="exhibit__link" aria-hidden="true">
						<span class="exhibit__wire"></span>
						{GROWTH.period && <span class="exhibit__period">{GROWTH.period}</span>}
						<span class="exhibit__arrow">
							<svg
								viewBox="0 0 16 16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" />
							</svg>
						</span>
						<span class="exhibit__wire exhibit__wire--lit"></span>
					</div>

					<p class="shot__tag shot__tag--after">
						<span class="shot__dot" aria-hidden="true"></span>
						{t('growth.after', { n: headline.after })}
					</p>

					<div class="shot__frame shot__frame--after">
						<Image
							src={afterShot}
							alt={t('growth.altAfter')}
							widths={[420, 640, 900]}
							sizes="(min-width: 60rem) 42vw, 92vw"
							loading="lazy"
						/>
					</div>

					<p class="shot__read shot__read--after">{t('growth.afterRead')}</p>

					<div class="after">
						<p class="after__stat">
							{/*
								The true figure, server-rendered. `data-count-*` is the script's
								business; if it never runs, this text is already the answer.
							*/}
							<span
								class="after__value"
								data-count-from={headline.beforeValue}
								data-count-to={headline.afterValue}>{headline.after}</span
							>
							<span class="after__unit">{t('growth.followers')}</span>
						</p>

						<ul class="marks marks--yes" aria-label={t('growth.becameLabel')}>
							{
								[t('growth.became1'), t('growth.became2'), t('growth.became3')].map((item) => (
									<li class="mark">
										<span class="mark__badge" aria-hidden="true">
											<svg
												viewBox="0 0 16 16"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="m3.5 8.4 3 3 6-6.6" />
											</svg>
										</span>
										{item}
									</li>
								))
							}
						</ul>
					</div>
				</div>

				<figcaption class="exhibit__source">
					{t('growth.source', { handle: GROWTH.handle })}
				</figcaption>
			</figure>

			{/*
				Her, saying it.

				The screenshots above are evidence and the numbers are transcribed, but
				neither is a person — and the one thing a case exhibit cannot do on its
				own is sound like somebody. The film sits under the figure rather than
				beside it so the argument still reads numbers-then-voice.

				── No branded thumbnail ────────────────────────────────────────────
				`src/assets/film/thumbnail-testimonial.png` used to cover this frame:
				a designed card with the MOLAR AI lockup, a pull-quote set in display
				caps and a TESTIMONIAL badge. It is an advertisement for a testimonial
				sitting on top of the testimonial, and at this size it was the largest
				thing in the section — louder than the screenshots that carry the
				actual proof.

				What is here now is the clip's own first frame, which is her. The
				custom play button and the swap script went with the poster: with a
				real frame showing, the video's native controls are the affordance,
				and a hand-built play button over a `hidden` <video> only existed to
				keep the designed card visible until someone pressed it.

				`preload="metadata"` rather than `none` is what buys that first frame —
				headers only, not the clip. See the ⚠️ on FILM_SRC: the file's moov
				atom is at the tail, so this costs a range request to the end of the
				file on every page load until that is remuxed.
			*/}
			<div class="film">
				<p class="film__label">{t('growth.filmLabel')}</p>

				<div class="film__frame">
					{/*
						The tile is the control — once there is a script to make it one.

						The button ships `hidden` and the <video> ships with `controls`, so a
						visitor without JS gets exactly what was here before: her own first
						frame, native controls, playing in place. The script unhides the button
						and takes the controls off, and from then on a press opens the film
						large over the page rather than starting a 40rem clip in the middle of
						a case study. Nothing here degrades into a dead tile.

						Not a return of the play button that went with the branded thumbnail.
						That one existed to keep a designed card visible until somebody pressed
						it; there is no card in front of the film now, and this one exists to
						open the clip rather than to reveal it.
					*/}
					<button class="film__play" type="button" data-growth-open hidden>
						<span class="sr-only">{t('growth.filmPlay', { name: GROWTH.name })}</span>
						<span class="film__play-disc" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="currentColor">
								<path d="M9 6.5v11l9-5.5-9-5.5Z" />
							</svg>
						</span>
					</button>

					<video
						class="film__video"
						data-growth-tile
						src={FILM_SRC}
						preload="metadata"
						playsinline
						controls
						aria-label={t('growth.filmPlay', { name: GROWTH.name })}></video>
				</div>

				<p class="film__caption">
					<span class="film__name">{GROWTH.name}</span>
					<span class="film__role">{GROWTH.place}</span>
				</p>
			</div>
		</div>
	</div>

</section>
{/*
	The player, in the top layer.

	A real <dialog> opened with `showModal()`: the page behind it goes inert,
	focus is trapped, Escape closes it and the backdrop is the browser's own —
	none of which is worth hand-writing.

	Its own <video> rather than the tile's, moved. Moving a playing element
	between two parents restarts it in most engines and drops the buffer in the
	rest; a second element on the same URL costs one entry in the HTTP cache,
	and `preload="none"` means it costs nothing at all until somebody presses
	play.
*/}
<dialog class="fdlg" data-growth-dialog aria-label={`${t('growth.filmLabel')}: ${GROWTH.name}`}>
	<div class="fdlg__frame">
		<video
			class="fdlg__video"
			data-growth-video
			src={FILM_SRC}
			preload="none"
			playsinline
			controls></video>

		<button class="fdlg__close" type="button" data-growth-close>
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="m7 7 10 10M17 7 7 17"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
				/>
			</svg>
			<span class="sr-only">{t('growth.close')}</span>
		</button>
	</div>
</dialog>

<script>
	/*
		Opens the film.

		`data-growth-*` rather than `data-film-*`, which is what the testimonial
		wall upstream on this page already uses for its own modal. Both scripts
		query the whole document, so shared names would have crossed the wires:
		this one would have bound to the wall's first tile and its own button would
		never have been unhidden.

		The enhancement is the first two lines: the button is unhidden and the
		tile's controls come off, so the markup's no-JS state — a plain <video>
		playing in place — is what stands until this runs. Everything after them is
		the modal, and everything the platform already does is left to it.

		On close the film is paused and wound back rather than unloaded. A closed
		dialog with a video still talking in it is the failure this listener exists
		to prevent; dropping the `src` as well would prevent it twice and make the
		second viewing re-download the clip.
	*/
	const dialog = document.querySelector<HTMLDialogElement>('[data-growth-dialog]');
	const film = document.querySelector<HTMLVideoElement>('[data-growth-video]');
	const opener = document.querySelector<HTMLButtonElement>('[data-growth-open]');
	const tile = document.querySelector<HTMLVideoElement>('[data-growth-tile]');

	if (dialog && film && opener && typeof dialog.showModal === 'function') {
		opener.hidden = false;
		if (tile) tile.controls = false;

		/*
			Lenis owns the scroll, so the dialog's own inertness does not stop the
			page moving behind it — it has to be told. The attribute covers the
			reduced-motion path, where Lenis never loaded to hear the event.
		*/
		const lock = (on: boolean): void => {
			document.documentElement.toggleAttribute('data-modal-open', on);
			window.dispatchEvent(new CustomEvent(on ? 'molar:lock-scroll' : 'molar:unlock-scroll'));
		};

		opener.addEventListener('click', () => {
			dialog.showModal();
			lock(true);
			/*
				A rejected play is not a failure worth reporting: the controls are
				right there in the modal, and some engines refuse an unmuted autoplay
				whatever the gesture behind it.
			*/
			void film.play().catch(() => {});
		});

		const close = () => dialog.close();
		dialog.querySelector('[data-growth-close]')?.addEventListener('click', close);

		/*
			A click on the dialog itself is a click on the backdrop: the frame fills
			it and swallows presses that land on the film or the close button, so
			anything reaching this listener came from the margin around them.
		*/
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) close();
		});

		/* Fires for the close button, the backdrop and Escape alike. */
		dialog.addEventListener('close', () => {
			lock(false);
			film.pause();
			film.currentTime = 0;
		});
	}
</script>

<script>
	/*
		Count-up for the headline figure.

		Deliberately not GSAP. This is one number on one page, and the animation
		library is loaded by motion.ts for the scroll work — reaching for it here
		would couple this component to that module's lifetime for no gain. It also
		has to be safe to skip entirely; see the note in the frontmatter.

		Intl compact notation is what produces "10.2K", which is why the strings in
		results.ts are written the way they are: the animated frames and the
		server-rendered final frame have to agree, and they do because both come out
		of the same formatter.
	*/
	const values = document.querySelectorAll<HTMLElement>('[data-count-to]');
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (values.length && !still.matches && 'IntersectionObserver' in window) {
		const format = new Intl.NumberFormat(undefined, {
			notation: 'compact',
			maximumFractionDigits: 1,
		});

		const run = (el: HTMLElement) => {
			const from = Number(el.dataset.countFrom ?? 0);
			const to = Number(el.dataset.countTo ?? 0);
			if (!Number.isFinite(from) || !Number.isFinite(to)) return;

			/*
				The truth, kept aside so the last frame restores it exactly rather than
				trusting the formatter to land on the same string the server chose.
			*/
			const settled = el.textContent;
			const start = performance.now();
			const ms = 1400;

			const tick = (now: number) => {
				const t = Math.min((now - start) / ms, 1);
				/* Quintic ease-out — the same curve as --ease-out-quint, so the number
				   settles on the same beat as every other reveal on the page. */
				const eased = 1 - Math.pow(1 - t, 5);

				if (t < 1) {
					el.textContent = format.format(Math.round(from + (to - from) * eased));
					requestAnimationFrame(tick);
				} else {
					el.textContent = settled;
				}
			};

			requestAnimationFrame(tick);
		};

		const seen = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					/* Once each. A number that re-counts every time it scrolls back into
					   view reads as a bug rather than as an effect. */
					seen.unobserve(entry.target);
					run(entry.target as HTMLElement);
				}
			},
			{ rootMargin: '0px 0px -20% 0px' },
		);

		values.forEach((el) => seen.observe(el));
	}
</script>

<style>
	.growth {
		position: relative;
		isolation: isolate;
		overflow: clip;
	}

	/*
		Off-centre on purpose: it sits behind the right-hand frame, the one the
		section is arguing for. Nothing lights the left.
	*/
	.growth__glow {
		position: absolute;
		z-index: -1;
		inset-block: 12% -10%;
		inset-inline: 34% -14%;
		background:
			radial-gradient(
				46% 52% at 62% 42%,
				color-mix(in oklab, var(--color-arc-600) 32%, transparent),
				transparent 70%
			),
			radial-gradient(
				38% 40% at 78% 76%,
				color-mix(in oklab, var(--color-arc-700) 38%, transparent),
				transparent 72%
			);
		filter: blur(34px);
	}

	.growth__inner {
		position: relative;
	}

	/* Wider than the 76rem reading measure, same gutters — see the note in the
	   markup. */
	.growth__wide {
		width: 100%;
		max-width: 90rem;
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.growth__head {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: clamp(2.75rem, 5.5vw, 4.5rem);
	}

	.growth__title {
		margin: 0;
		max-width: 22ch;
		font-size: var(--text-4xl);
		/* Display sizes want their own leading; the inherited body value opens a
		   hole between the lines of a three-line heading. */
		line-height: 1.06;
		letter-spacing: -0.03em;
	}

	.growth__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	/*
		The figure, between the promise and the paragraphs that explain it. Set at
		heading weight in the accent — it is the one number this section is built
		around, and the arrow in it is doing the same work as the arrow in the
		exhibit below.
	*/
	.growth__delta {
		margin: clamp(0.5rem, 1.5vw, 1rem) 0 0;
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--color-arc-300);
	}

	.growth__body {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--color-bone-300);
	}

	/* ── Exhibit ─────────────────────────────────────────────────────────── */
	.exhibit {
		margin: 0;
	}

	/*
		Stacked on narrow screens: the whole before side, then the arrow turned to
		point down the page, then the whole after side.
	*/
	.exhibit__pair {
		display: grid;
		grid-template-areas:
			'btag'
			'bshot'
			'bread'
			'blist'
			'arrow'
			'atag'
			'ashot'
			'aread'
			'alist';
		gap: 0.85rem;
	}

	.shot__tag--before {
		grid-area: btag;
	}
	.shot__frame--before {
		grid-area: bshot;
	}
	.shot__read--before {
		grid-area: bread;
	}
	.marks--no {
		grid-area: blist;
	}
	.exhibit__link {
		grid-area: arrow;
	}
	.shot__tag--after {
		grid-area: atag;
	}
	.shot__frame--after {
		grid-area: ashot;
	}
	.shot__read--after {
		grid-area: aread;
	}
	.after {
		grid-area: alist;
	}

	.shot__tag {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		/* bone-100, not bone-500. Uppercase mono at 10px with 0.16em of tracking is
		   already the hardest thing on this exhibit to read; the dimmest grey in
		   the palette on top of that made it decoration. The dot beside it and the
		   colour it carries are what separate the two columns, not the dimming. */
		color: var(--color-bone-100);
	}

	.shot__dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--color-ink-600);
	}

	/*
		A light screenshot on a navy page has to read as a document set down on the
		table, not as a hole burned through the layout — hence the border, the lit
		top edge, and a drop shadow that grounds it.
	*/
	.shot__frame {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-line-strong);
		background: #fff;
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #fff 60%, transparent),
			0 24px 60px -36px #000;
		transition:
			border-color 0.5s var(--ease-out-quint),
			box-shadow 0.5s var(--ease-out-quint);
	}

	.shot__frame :global(img) {
		width: 100%;
		/*
			Both crops are authored square, so this only enforces what is already
			true — and keeps the pair the same height if either is ever re-cut.

			Square because it is Instagram's own shape, and because it leaves room
			under each profile header for the thing that actually lands the point:
			one lonely post on the left, a full grid on the right.

			The two crops are NOT the same pixel width, and that is deliberate. The
			after screenshot was captured at a lower browser zoom than the before, so
			cropping both to full width would render its follower count noticeably
			smaller than the one it is meant to be compared against. The after is
			cropped in until the two headers match on screen. If either screenshot is
			ever replaced, check that match before checking anything else.
		*/
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: top;
		transition: filter 0.5s var(--ease-out-quint);
	}

	/* Drained, not hidden. Every figure in it is still legible; it just is not
	   where the light is. */
	.shot__frame--before {
		border-color: var(--color-line);
	}

	.shot__frame--before :global(img) {
		filter: grayscale(0.7) contrast(0.95) brightness(0.74);
	}

	.shot__wash {
		position: absolute;
