---
import { Image } from 'astro:assets';
import logoMark from '~/assets/brand/logo-mark.png';
import StepIcon from '~/components/ui/StepIcon.astro';
import { CTA, SITE } from '~/data/site';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { PROOF_HEADLINE, PROOF_SUB } from '~/data/proof';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

/**
 * Media contract — files live in `public/videos/` and `public/images/`.
 * Renaming any of these means updating `public/videos/README.md` too.
 */
const VIDEO = {
	// `poster` takes a single URL — no srcset, no <picture> — so it gets the WebP:
	// a quarter the weight of the JPEG and supported everywhere that matters. The
	// CSS fallback below negotiates AVIF/WebP/JPEG properly via image-set().
	poster: '/images/hero-poster.webp',
	// The delivered footage: 1280x720 H.264, 10s, ~3.4 MB, moov ahead of mdat so
	// it starts on the first chunk instead of waiting for the whole file. One cut
	// serves every width — see the crop note on .hero__video below.
	mp4: '/videos/Hero_video.mp4',
};

/**
 * The headline, pre-split for the entrance.
 *
 * Each part is a run of the line that shares a colour; inside it the words are
 * atomic (so a word never breaks across lines) and the letters are what
 * actually animate. Written as data rather than markup because the alternative
 * is forty hand-authored spans that nobody can edit.
 */
const TITLE_PARTS = [
	{ text: t('hero.titleLead'), accent: false },
	{ text: t('hero.titleAccent'), accent: true },
];

/** The same line as one string, for anything that reads rather than looks. */
const TITLE_TEXT = TITLE_PARTS.map((part) => part.text).join(' ');

/**
 * The three beats between paying and being seen, as three linked cards.
 *
 * The titles are the line the site already ran; the second line under each is
 * what it actually means, so a card carries the step and its answer rather than
 * a label on its own.
 */
/* The same three the footer lists, from the same source — one place to add a
   fourth account, not two. */
const SOCIAL = [
	{ label: 'Instagram', href: SITE.social.instagram, icon: 'instagram' },
	{ label: 'TikTok', href: SITE.social.tiktok, icon: 'tiktok' },
	{ label: 'YouTube', href: SITE.social.youtube, icon: 'youtube' },
] as const;

const FLOW = [
	{ title: t('hero.step1'), sub: t('hero.step1sub'), icon: 'bell' },
	{ title: t('hero.step2'), sub: t('hero.step2sub'), icon: 'link' },
	{ title: t('hero.step3'), sub: t('hero.step3sub'), icon: 'megaphone' },
] as const;
---

<section class="hero" data-hero aria-labelledby="hero-heading">
	<div class="hero__media">
		{/*
			`playsinline` + `muted` are what let iOS autoplay at all.
			The poster is required: without it there is a black flash before the
			first decoded frame, and it is also the whole picture for anyone on a
			data saver, a reduced-motion setting, or a failed video request.
		*/}
		<video
			class="hero__video"
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			poster={VIDEO.poster}
			aria-hidden="true"
			tabindex="-1"
			disablepictureinpicture
			disableRemotePlayback
		>
			<source src={VIDEO.mp4} type="video/mp4" />
		</video>

		{/* Scrim. The tooth's glow must never sit directly behind the headline. */}
		<div class="hero__scrim" data-hero-scrim></div>
		<div class="hero__vignette" aria-hidden="true"></div>
		<div class="grain" aria-hidden="true"></div>
	</div>

	{/*
		The follow rail, pinned to the left edge rather than placed in the flow.
		It is a secondary invitation — the two buttons in the middle are what the
		hero is actually asking for — and an aside belongs in the margin.

		Last in the DOM on purpose: every [data-hero-in="tail"] element shares one
		staggered tween, in document order, so putting the rail here lands the
		three marks one after another once the buttons have settled rather than
		competing with them.
	*/}
	<ul class="hero__social" aria-label="Follow MOLAR AI">
		{
			SOCIAL.map((link) => (
				<li data-hero-in="tail">
					{/*
						External, so rel="noopener". No noreferrer — these are the
						company's own accounts and the referrer is wanted in their
						analytics.
					*/}
					<a href={link.href} class="hero__social-link" target="_blank" rel="noopener">
						<SocialIcon name={link.icon} class="hero__social-icon" />
						<span class="sr-only">{link.label} {t('footer.newTab')}</span>
					</a>
				</li>
			))
		}
	</ul>

	<div class="container-content hero__inner">
		<p class="eyebrow hero__eyebrow" data-hero-in="lead">{t('site.tagline')}</p>

		{/*
			The visual copy is split into per-letter spans and hidden from assistive
			tech; the real sentence is carried once, in order, by the sr-only span.
			An aria-label on the <h1> would do the same job, but this survives a
			translation layer rewriting the visible text and leaves the accessible
			name built from actual content.
		*/}
		<h1 id="hero-heading" class="hero__title">
			<span class="sr-only">{TITLE_TEXT}</span>
			<span class="hero__title-visual" aria-hidden="true">
				{
					TITLE_PARTS.map((part) => (
						<span class:list={['hero__part', part.accent && 'hero__part--accent']}>
							{part.text.split(' ').map((word) => (
								<span class="hero__word">
									{[...word].map((char) => (
										<span class="hero__letter" data-hero-letter>
											{char}
										</span>
									))}
								</span>
							))}
						</span>
					))
				}
			</span>
		</h1>

		{/*
			The numbers are the list's own — an <ol> already says these are ordered,
			so the visible digits are decoration and are hidden from assistive tech
			rather than read out twice. Spans rather than headings inside: this rail
			sits under the hero's h1 and has no business minting h3s in it.
		*/}
		<ol class="rail" data-hero-in="tail">
			{
				FLOW.map((step, i) => (
					<li class:list={['station', i === FLOW.length - 1 && 'station--live']}>
						{/*
							Drawn per station rather than as one line behind the row. A single
							background line would run under the nodes and show through the gaps
							between them at every breakpoint; a segment owned by each station
							starts and stops exactly where its own node does, and the last
							station simply has none.
						*/}
						{i < FLOW.length - 1 && <span class="station__rail" aria-hidden="true" />}

						<span class="station__node">
							<span class="station__icon" aria-hidden="true">
								<StepIcon name={step.icon} />
							</span>
							<span class="station__num" aria-hidden="true">
								{String(i + 1).padStart(2, '0')}
							</span>
						</span>

						<span class="station__body">
							<span class="station__title">{step.title}</span>
							<span class="station__text">{step.sub}</span>
						</span>
					</li>
				))
			}
		</ol>

		<div class="hero__actions" data-hero-in="tail">
			<a href={localizePath(CTA.secondary.href, locale)} class="btn-lit">
				{/* The wordmark is not in the button, so the mark carries no meaning
				    here beyond decoration — the label is the accessible name. */}
				<span class="btn-lit__badge" aria-hidden="true">
					<Image
						src={logoMark}
						alt=""
						height={22}
						densities={[1, 2]}
						loading="eager"
						decoding="sync"
						class="hero__cta-mark"
					/>
				</span>
				<span>{t('cta.heroPlans')}</span>
			</a>

			{/*
				Second, and second on purpose: the plan is what the hero is asking for,
				the library is the way in for anyone not ready to ask about price yet.
				Same button, one modifier dimmer — see `.btn-lit--quiet`.
			*/}
			<a href={localizePath('/resources/', locale)} class="btn-lit btn-lit--quiet">
				<span class="btn-lit__badge" aria-hidden="true">
					{/* A stack of sheets. Decorative — the label is the accessible name. */}
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="hero__cta-glyph"
					>
						<path
							d="M8.2 3.6h7.2l4 4v10.2a2.2 2.2 0 0 1-2.2 2.2H8.2A2.2 2.2 0 0 1 6 17.8V5.8a2.2 2.2 0 0 1 2.2-2.2Z"
						></path>
						<path d="M15 3.8v3.8h4"></path>
						<path d="M9.6 12.6h6M9.6 16h4"></path>
					</svg>
				</span>
				<span>{t('cta.heroResources')}</span>
			</a>
		</div>

		{/*
			The proof, under the asks rather than in its own band further down.
			It answers the question the two buttons raise — "does this work?" —
			at the moment it gets raised, and it costs the hero one line to do it.

			One sentence, not a stat block: the number and what it counts read as
			a single phrase, so it is marked up as one <p> with the number given
			weight rather than as a figure with a caption.
		*/}
		<p class="hero__proof" data-hero-in="tail">
			<span class="hero__proof-number">{PROOF_HEADLINE}</span>
			<span class="hero__proof-label">{PROOF_SUB}</span>
		</p>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		/* dvh, not vh — vh is wrong the moment mobile Safari's chrome moves. */
		min-height: 100dvh;
		padding-block: calc(var(--nav-h, 5.25rem) + clamp(2.5rem, 7vh, 4.5rem)) clamp(3.5rem, 9vh, 6rem);
		overflow: clip;
		isolation: isolate;
		text-align: center;
	}

	/* Fallback for the handful of engines without dvh. */
	@supports not (height: 100dvh) {
		.hero {
			min-height: 100vh;
		}
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-color: var(--color-ink-950);
		/* Shows through if the video 404s or is still downloading. JPEG first as
		   the floor, then let the browser take the best format it supports —
		   8 KiB of AVIF against 67 KiB of JPEG on the largest paint on the page. */
		background-image: url('/images/hero-poster.jpg');
		background-image: image-set(
			url('/images/hero-poster.avif') type('image/avif'),
			url('/images/hero-poster.webp') type('image/webp'),
			url('/images/hero-poster.jpg') type('image/jpeg')
		);
		background-size: cover;
		background-position: 50% 46%;
	}

	.hero__video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/*
			The tooth sits centred and small in the footage, and with the copy
			centred too it is the composition's focal mark — there is no separate
			logo in the stack because this is it. A hair above centre keeps its glow
			between the eyebrow and the headline rather than behind the headline.
		*/
		object-position: 50% 46%;
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		background:
			/* Pool of ink under the copy stack. The footage is at its brightest
			   dead centre, which is exactly where the headline sits. */
			radial-gradient(
				68% 54% at 50% 52%,
				color-mix(in oklab, var(--color-ink-950) 74%, transparent) 0%,
				color-mix(in oklab, var(--color-ink-950) 44%, transparent) 58%,
				transparent 100%
			),
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-ink-950) 68%, transparent) 0%,
				color-mix(in oklab, var(--color-ink-950) 24%, transparent) 30%,
				color-mix(in oklab, var(--color-ink-950) 80%, transparent) 82%,
				var(--color-ink-950) 100%
			);
	}

	.hero__vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			120% 80% at 50% 46%,
			transparent 38%,
			color-mix(in oklab, var(--color-ink-950) 72%, transparent) 100%
		);
	}

	.hero__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(1.25rem, 3.2vh, 2.25rem);
	}

	.hero__eyebrow {
		margin: 0;
	}

	/* ── Headline ────────────────────────────────────────────────────────── */
	.hero__title {
		margin: 0;
		/*
			Its own scale, not --text-5xl — that token tops out at 5.25rem for
			sentence case. The 6.5rem ceiling is measured, not chosen: it is the
			largest size at which "THE EASIEST WAY TO" still holds one line inside
			the 76rem container, and it is past the size at which the accent run
			below breaks after "PATIENTS". Those two facts are the three-line
			shape. Moving the ceiling moves the shape.
		*/
		font-size: clamp(2.6rem, 6.8vw + 0.6rem, 6.5rem);
		/*
			Caps have no descenders, so the generous default leading that sentence
			case needs just opens a hole between the two lines. Under 1 is only
			safe because of that.
		*/
		line-height: 0.95;
		font-weight: 600;
		/* Caps sit further apart optically than lowercase — they want a fraction
		   of the negative tracking, not the -0.035em the lowercase line took. */
		letter-spacing: -0.018em;
		/* `balance` comes from the global h1 rule and is right below 1000px, where
		   the line count is whatever fits — see the desktop override. */
		max-width: 100%;
	}

	/*
		The transform lives here, not on the <h1>. On the heading it would also
		cover the sr-only sentence, and some screen readers read the transformed
		text rather than the source — which turns a headline into spelling.
	*/
	.hero__title-visual {
		display: block;
		text-transform: uppercase;
	}

	/*
		Block, not inline — and not only for the line break it pins down. Astro
		emits a newline between the two parts, and as inlines that collapsed to a
		real space *on top of* the word margin below, so the seam at
		"to | educate" rendered a space and a half wide.
	*/
	.hero__part {
		display: block;
	}

	.hero__part--accent {
		color: var(--color-arc-300);
		/* Applied per letter, which is what makes it cheap — no filter on a
		   forty-child block, just a shadow each glyph already needs. */
		text-shadow: 0 0 42px color-mix(in oklab, var(--color-arc-500) 45%, transparent);
	}

	/*
		Words are atomic so no letter is ever orphaned onto the next line. The
		trailing margin is the word space — real whitespace between the generated
		spans is not something the template can promise.
	*/
	.hero__word {
		display: inline-block;
		white-space: nowrap;
		/* Caps read tighter than lowercase at the same word space. */
		margin-inline-end: 0.22em;
	}

	.hero__part:last-child .hero__word:last-child {
		margin-inline-end: 0;
	}

	/* inline-block, or `transform` on the entrance has nothing to act on. No
	   `will-change` — there are forty of these, and promoting every one of them
	   costs more than the tween it would smooth. */
	.hero__letter {
		display: inline-block;
	}

	/* ── Subscribe → Connect → Stay top of mind ──────────────────────────── */
	/*
		The same rail /how-it-works/ runs, at three stations instead of four: a
		numbered node per step with the line threading through them. Three cards
		said "here are three features"; a rail says "this, then this, then this",
		and the order is the only thing this row is here to carry.

		Centred, unlike the page version, which hangs its copy off the left of each
		node. The hero is a centred composition from the headline down and a rail of
		left-ragged copy under a centred h1 reads as a different section that
		wandered in. Centring also puts every node on its column's centre line, so
		the segments between them come out symmetric without being measured.
	*/
	.rail {
		/*
			The two numbers every offset below is written in terms of, so the rail
			segments cannot drift out of line with the nodes they connect. Changing
			the node size — as the short-laptop query below does — moves the line
			with it.
		*/
		--rail-gap: clamp(1rem, 3vw, 2rem);
		--node: 3.5rem;

		position: relative;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--rail-gap);
		width: 100%;
		/* The row reads as a diagram, not as a band across the page; past this it
		   stops looking like three related things and starts looking like three
		   columns of a layout. */
		max-width: 52rem;
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.station {
		position: relative;
		display: grid;
		justify-items: center;
		align-content: start;
		gap: 0.875rem;
		text-align: center;
	}

	.station__node {
		position: relative;
		/* Over the rail segment, which runs behind it. */
		z-index: 1;
		display: grid;
		place-items: center;
		width: var(--node);
		height: var(--node);
		border-radius: 50%;
		border: 1px solid var(--color-line-strong);
		background: color-mix(in oklab, var(--color-ink-900) 88%, transparent);
		backdrop-filter: blur(10px);
		box-shadow: inset 0 1px 0 color-mix(in oklab, #dbeaff 12%, transparent);
		color: var(--color-bone-300);
		transition:
			border-color 0.4s var(--ease-out-quint),
			color 0.4s var(--ease-out-quint),
			box-shadow 0.4s var(--ease-out-quint);
	}

	/* Nothing behind it to sample, so translucency would read as washed out. */
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.station__node {
			background-color: color-mix(in oklab, var(--color-ink-900) 94%, transparent);
		}
	}

	.station__icon {
		display: block;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--color-arc-200);
		/* Two passes, tight then wide: the glyph is a hairline stroke, and one
		   large blur only smears it. */
		filter:
			drop-shadow(0 0 4px color-mix(in oklab, var(--color-arc-300) 55%, transparent))
			drop-shadow(0 0 16px color-mix(in oklab, var(--color-arc-500) 45%, transparent));
	}

	/*
		The digit rides the node's edge rather than sitting inside it — inside, it
		competes with the icon for a 56px circle and both lose.
	*/
	.station__num {
		position: absolute;
		inset-block-start: -0.4rem;
		inset-inline-start: -0.4rem;
		display: grid;
		place-items: center;
		min-width: 1.35rem;
		height: 1.35rem;
		padding-inline: 0.3rem;
		border-radius: 999px;
		border: 1px solid var(--color-line-strong);
		background: var(--color-ink-950);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		line-height: 1;
		color: var(--color-bone-500);
	}

	/*
		The segment, from this node's right edge to the next node's left edge.
		Every node is centred in its column, so it starts half a node past the
		column's centre and runs one whole column plus the gap, less the node.
	*/
	.station__rail {
		position: absolute;
		inset-block-start: calc(var(--node) / 2);
		inset-inline-start: calc(50% + var(--node) / 2);
		width: calc(100% + var(--rail-gap) - var(--node));
		height: 1px;
		background: linear-gradient(
			90deg,
			var(--color-line-strong),
			color-mix(in oklab, var(--color-arc-500) 30%, transparent)
		);
	}

	.station__body {
		display: grid;
		gap: 0.3rem;
	}

	.station__title {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-bone-50);
	}

	.station__text {
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-bone-400);
	}

	/*
		Arrival. The last node is the only one lit, and it is lit the same way the
		"after" frame on /results/ is — same accent, same halo — so the light means
		one thing across the site: this account is live.
	*/
	.station--live .station__node {
		border-color: color-mix(in oklab, var(--color-arc-400) 55%, transparent);
		background: color-mix(in oklab, var(--color-arc-600) 16%, transparent);
		color: var(--color-arc-300);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #dbeaff 22%, transparent),
			0 0 30px -6px color-mix(in oklab, var(--color-arc-400) 75%, transparent);
	}

	.station--live .station__num {
		border-color: color-mix(in oklab, var(--color-arc-400) 45%, transparent);
		color: var(--color-arc-300);
	}

	/* ── CTA ─────────────────────────────────────────────────────────────── */
	/*
		Stacked, not side by side. The two buttons are different widths and the
		hero is centre-aligned throughout — a row would hang them off a shared
		centre line with ragged ends, and it would also put the secondary CTA level
		with the primary rather than under it.

		One `max-content` column is what makes them the same width: the track sizes
		to the widest button, and both stretch into it. Doing it that way rather
		than hard-coding a width means the pair stays matched if either label is
		ever reworded — including through a translation, where a guessed width is a
		guarantee of a broken button. `min()` keeps the track from overflowing a
		narrow phone.
	*/
	.hero__actions {
		display: grid;
		grid-template-columns: min(100%, max-content);
		justify-content: center;
		gap: 0.75rem;
		margin-top: clamp(0.25rem, 1.5vh, 1rem);
	}

	/*
		The button itself is `.btn-lit` in global.css — dark glass with the accent
		around its rim, shared with the resource CTA on how-it-works so the two
		cannot drift apart. Only the logo mark inside it is sized here.
	*/
	/*
		The follow rail. Absolute against the hero rather than inside
		.hero__inner, so it sits out at the window's edge instead of on the
		content measure — the same reasoning the nav uses for the brand lockup.

		Hidden below 68rem: there is no margin left to put it in, and the footer
		carries the same three links on every page anyway, so nothing is lost.
	*/
	.hero__social {
		display: none;
	}

	@media (min-width: 68rem) {
		.hero__social {
			position: absolute;
			z-index: 2;
			inset-inline-start: clamp(1.25rem, 3vw, 2.5rem);
			inset-block-start: 50%;
			transform: translateY(-50%);
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}
	}

	/*
		The tile is the hit area, and deliberately larger than the mark it holds:
		2.75rem clears the minimum a pointer target should meet, which the 20px
		glyph on its own would not. Same dimensions as the footer's, so the two
		read as the same control in two places.
	*/
	.hero__social-link {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.7rem;
		border: 1px solid var(--color-line);
