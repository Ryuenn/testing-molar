---
/**
 * Section 01 — the hero.
 *
 * Split composition: the argument runs down the left half in a column, the
 * footage and the two floating readouts hold the right, and a five-cell figure
 * band closes the fold along the bottom.
 *
 * Order down the left is the strategy's — badge, headline, one paragraph, two
 * asks, trust line — and the thing it deliberately leaves out is a feature
 * list: the hero states the category and hands the visitor either a tour or a
 * price, then gets out of the way.
 *
 * Every figure on this page is real. The two readouts and the five cells all
 * read off `~/data/proof`, `~/data/work` and `~/data/reach` rather than being
 * typed in here, because a hero is the one place on a site where an invented
 * number does the most damage.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logoIcon from '~/assets/brand/logo-molar.png';
import { CTA, EDUCATION_CHECKOUT, SITE } from '~/data/site';
import { EDUCATION_PRICE, EDUCATION_TRIAL_DAYS } from '~/data/education';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import Glyph from '~/components/ui/Glyph.astro';
import { PROOF_HEADLINE, PROOF_SUB, PRACTICE_COUNT } from '~/data/proof';
import { COUNTRIES, REGIONS, countryName } from '~/data/reach';
import { WORK, LANGUAGE_COUNT } from '~/data/work';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

/**
 * Media contract — files live in `public/videos/` and `public/images/`.
 * Renaming any of these means updating `public/videos/README.md` too.
 */
const VIDEO = {
	// `poster` takes a single URL — no srcset, no <picture> — so it gets the WebP:
	// a quarter the weight of the JPEG and supported everywhere that matters. The
	// CSS fallback below negotiates AVIF/WebP/JPEG properly via image-set().
	poster: '/images/hero-poster.webp',
	// The footage behind the fold. One cut serves every width — see the crop note
	// on .hero__video below.
	//
	// It has to earn its place: `Blue_structure_Hero.mp4` was handsome and meant
	// nothing, moving wallpaper behind a headline, which is the note this
	// replaced it on. Whatever runs here should be the product in the room it is
	// sold for.
	//
	// The web cut of `Premium_Hero.mp4`, not the master.
	//
	// The delivered file was 1920x1080 at 14.4 Mbps — a mastering bitrate, ten
	// times what a loop behind a headline needs — plus an AAC track this element
	// is muted and never plays. Re-encoded at CRF 23 with the audio stripped and
	// `faststart` so playback begins on the first chunk: 20.9MB → 3.85MB, at a
	// measured mean difference of 0.64% per channel.
	//
	//   ffmpeg -i Premium_Hero.mp4 -an -c:v libx264 -crf 23 -preset slow \
	//     -pix_fmt yuv420p -movflags +faststart Premium_Hero-web.mp4
	//
	// Any replacement footage wants the same treatment before it goes in here.
	mp4: '/videos/Premium_Hero-web.mp4',
};

/**
 * The headline, pre-split for the entrance.
 *
 * Each part is a run of the line that shares a colour; inside it the words are
 * atomic (so a word never breaks across lines) and the letters are what
 * actually animate. Written as data rather than markup because the alternative
 * is forty hand-authored spans that nobody can edit.
 */
const TITLE_PARTS = [
	{ text: t('hero.titleLead'), accent: false },
	{ text: t('hero.titleAccent'), accent: true },
];

/** The same line as one string, for anything that reads rather than looks. */
const TITLE_TEXT = TITLE_PARTS.map((part) => part.text).join(' ');

/*
	The two promises inside the paragraph are lit in the accent, which is what
	makes the sentence scannable at a glance instead of a wall.

	Per locale, because a phrase is not a phrase once it has been translated —
	splitting the German lede on an English substring would simply never match,
	and the paragraph would render flat, which is the correct failure.
*/
const LEDE_MARKS: Record<string, readonly string[]> = {
	en: ['educate patients', 'build trust'],
	de: ['Patienten aufzuklären', 'Vertrauen aufzubauen'],
};

/** The lede as alternating plain / lit runs, in source order. */
const ledeParts = (() => {
	const marks = LEDE_MARKS[locale] ?? [];
	const raw = t('hero.lede');
	if (!marks.length) return [{ text: raw, lit: false }];
	/* One pass, splitting on whichever mark comes next — a capturing alternation
	   keeps the delimiters in the output, so nothing has to be re-joined. */
	const pattern = new RegExp(
		`(${marks.map((mark) => mark.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`,
	);
	return raw
		.split(pattern)
		.filter(Boolean)
		.map((text) => ({ text, lit: marks.includes(text) }));
})();

/* The same three the footer lists, from the same source — one place to add a
   fourth account, not two. */
const SOCIAL = [
	{ label: 'Instagram', href: SITE.social.instagram, icon: 'instagram' },
	{ label: 'TikTok', href: SITE.social.tiktok, icon: 'tiktok' },
	{ label: 'YouTube', href: SITE.social.youtube, icon: 'youtube' },
] as const;

/*
	The eighteen markets, from `~/data/reach`.

	Real flags, not emoji: HatScripts/circle-flags (MIT), vendored into
	`public/flags/` rather than hotlinked so the CSP stays locked to 'self'.
	They are `<img>` rather than inlined SVG on purpose — every one of those
	files carries a `mask id="a"`, and eighteen of them inlined on one page
	would be eighteen elements fighting over the same ID.
*/
const FLAGS = COUNTRIES.map((country) => ({
	src: `/flags/${country.code}.svg`,
	name: countryName(country, locale),
}));

/*
	The marquee needs two identical tracks: the first scrolls a full -100% of
	its own width while the second slides in behind it, so the seam never shows.
	Eighteen flags overrun the window on their own, so a track is the list once.
*/
const FLAG_TRACKS = [0, 1];

/*
	The two readouts floating over the footage. Both are figures the site can
	evidence elsewhere: the view count is the marquee's, the markets are the
	map's.
*/
const CARD_VIEWS = {
	label: t('hero.cardViews'),
	value: PROOF_HEADLINE,
	note: PROOF_SUB,
};

/*
	The second readout is the roster itself: the practices whose marks we
	actually hold, matched to accounts by slug the way the trust band does it.
	Eager, because these are build-time `ImageMetadata` records for <Image>, and
	the lookup returns undefined rather than throwing — a practice that has not
	published a logo is a practice with no logo, not a broken build.
*/
const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/clients/*.{svg,png}',
	{ eager: true },
);

const CLIENTS = WORK.map((account) => ({
	practice: account.practice,
	logo: (
		logoFiles[`../../assets/clients/${account.slug}.svg`] ??
		logoFiles[`../../assets/clients/${account.slug}.png`]
	)?.default,
})).filter((client): client is { practice: string; logo: ImageMetadata } => Boolean(client.logo));

const CARD_CLIENTS = {
	label: t('hero.cardClients'),
	note: t('hero.cardClientsNote'),
};

/*
	The band along the foot of the fold. Five figures, every one counted off the
	data rather than typed: accounts published, views across them, languages in
	the grids, countries on the map, continents in the reach section.
*/
const STATS = [
	{
		icon: 'people',
		value: PRACTICE_COUNT,
		label: t('hero.statPractices'),
		sub: t('hero.statPracticesSub'),
	},
	{
		icon: 'play-circle',
		/* "10M+ organic views" → "10M+". The figure alone, since the cell's own
		   label carries the noun. */
		value: PROOF_HEADLINE.split(' ')[0],
		label: t('hero.statViews'),
		sub: t('hero.statViewsSub'),
	},
	{
		icon: 'chat',
		value: String(LANGUAGE_COUNT),
		label: t('hero.statLanguages'),
		sub: t('hero.statLanguagesSub'),
	},
	{
		icon: 'map',
		value: String(COUNTRIES.length),
		label: t('hero.statCountries'),
		sub: t('hero.statCountriesSub'),
	},
	{
		icon: 'globe',
		value: String(REGIONS.length),
		label: t('hero.statRegions'),
		sub: t('hero.statRegionsSub'),
	},
] as const;
---

<section class="hero" data-hero aria-labelledby="hero-heading">
	<div class="hero__media">
		{/*
			`playsinline` + `muted` are what let iOS autoplay at all.
			The poster is required: without it there is a black flash before the
			first decoded frame, and it is also the whole picture for anyone on a
			data saver, a reduced-motion setting, or a failed video request.
		*/}
		<video
			class="hero__video"
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			poster={VIDEO.poster}
			aria-hidden="true"
			tabindex="-1"
			disablepictureinpicture
			disableRemotePlayback
		>
			<source src={VIDEO.mp4} type="video/mp4" />
		</video>

		{/* Scrim. The copy column is on the left, so the ink is banked there. */}
		<div class="hero__scrim" data-hero-scrim></div>
		<div class="hero__vignette" aria-hidden="true"></div>
		<div class="grain" aria-hidden="true"></div>
	</div>

	{/*
		The follow rail, pinned to the right edge rather than placed in the flow.
		It is a secondary invitation — the two buttons in the copy column are what
		the hero is actually asking for — and an aside belongs in the margin.
	*/}
	<ul class="hero__social" aria-label="Follow MOLAR AI">
		{
			SOCIAL.map((link) => (
				<li>
					{/*
						External, so rel="noopener". No noreferrer — these are the
						company's own accounts and the referrer is wanted in their
						analytics.
					*/}
					<a href={link.href} class="hero__social-link" target="_blank" rel="noopener">
						<SocialIcon name={link.icon} class="hero__social-icon" />
						<span class="sr-only">{link.label} {t('footer.newTab')}</span>
					</a>
				</li>
			))
		}
	</ul>

	<div class="hero__inner">
		<div class="hero__copy">
			<p class="hero__badge" data-hero-in="lead">{t('hero.eyebrow')}</p>

			{/*
				The visual copy is split into per-letter spans and hidden from assistive
				tech; the real sentence is carried once, in order, by the sr-only span.
				An aria-label on the <h1> would do the same job, but this survives a
				translation layer rewriting the visible text and leaves the accessible
				name built from actual content.
			*/}
			<h1 id="hero-heading" class="hero__title">
				<span class="sr-only">{TITLE_TEXT}</span>
				<span class="hero__title-visual" aria-hidden="true">
					{
						TITLE_PARTS.map((part) => (
							<span class:list={['hero__part', part.accent && 'hero__part--accent']}>
								{part.text.split(' ').map((word) => (
									<span class="hero__word">
										{[...word].map((char) => (
											<span class="hero__letter" data-hero-letter>
												{char}
											</span>
										))}
									</span>
								))}
							</span>
						))
					}
				</span>
			</h1>

			<p class="hero__lede" data-hero-in="tail">
				{
					ledeParts.map((part) =>
						part.lit ? <span class="hero__lede-lit">{part.text}</span> : part.text,
					)
				}
			</p>

			<div class="hero__actions" data-hero-in="tail">
				{/*
					/molar-complete/, not the `#ecosystem` jump this used to make.

					That jump was written when the ecosystem diagram sat immediately
					below the hero — "show me the thing" landing on the thing. The home
					page leads with MOLAR TV now and the diagram is six sections down, so
					the anchor scrolled past the whole argument to reach a summary of it.
					The page that carries the ecosystem at full length is a better answer
					to "explore" than a scroll position on this one.
				*/}
				<a href={localizePath('/molar-complete/', locale)} class="hero__btn hero__btn--solid">
					<span>{t('cta.explore')}</span>
					{/* The tile, and it needs no disc behind it — it is its own rounded
					    ground. Decorative: the label is the link's accessible name. */}
					<Image
						src={logoIcon}
						alt=""
						height={34}
						densities={[1, 2]}
						loading="eager"
						decoding="sync"
						class="hero__cta-mark"
					/>
				</a>

				{/*
					Second, and second on purpose: the tour is what the hero is asking
					for, the price is the way in for anyone who already knows what this
					is.
				*/}
				<a href={localizePath(CTA.secondary.href, locale)} class="hero__btn hero__btn--quiet">
					<span>{t('cta.seePlans')}</span>
					{/* A price tag. Decorative — the label is the accessible name. */}
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="hero__cta-glyph"
						aria-hidden="true"
					>
						<path
							d="M4 11.4V5.4a1.4 1.4 0 0 1 1.4-1.4h6l8.2 8.2a1.4 1.4 0 0 1 0 2l-6 6a1.4 1.4 0 0 1-2 0L4 11.4Z"
						></path>
						<circle cx="8.4" cy="8.4" r="1.2"></circle>
					</svg>
				</a>
			</div>

			{/*
				The offer, under the buttons.

				The reaction this page is aiming for is "I need this, and it is free
				for thirty days and only $97" — and that could not happen when the
				figure first appeared four screens down in the plan grid. It is one
				line, it names the number, and it links to the checkout that honours
				it rather than to another page about it.

				`EDUCATION_PRICE` and `EDUCATION_TRIAL_DAYS`, not literals: the same
				two constants /patient-education/ and the plan card read, so the
				headline offer cannot drift from the one being charged.
			*/}
			<p class="hero__offer" data-hero-in="tail">
				<a href={EDUCATION_CHECKOUT} class="hero__offer-link" rel="noopener">
					{t('edu.trialLong', { n: EDUCATION_TRIAL_DAYS, price: EDUCATION_PRICE })}
				</a>
			</p>

			{/*
				The trust bar the strategy asks for, at the foot of the copy column
				rather than as a band of its own: it answers the question the two
				buttons raise — "does anyone actually use this?" — at the moment it
				gets raised.

				The eighteen markets run past as a band rather than sitting still —
				see the note on `COUNTRIES` in ~/data/reach.
			*/}
			<div class="hero__trust" data-hero-in="tail">
				<p class="hero__trust-line">{t('hero.trust')}</p>
				<div class="hero__trust-row">
					{/*
						Decorative as a whole — it is one list said four times over, in two
						copies — so the row is hidden from assistive tech and the countries
						are named once, in order, by the sr-only list beside it.
					*/}
					<div class="marquee hero__flags" aria-hidden="true">
						{
							FLAG_TRACKS.map(() => (
								<div class="marquee__track">
									{FLAGS.map((country) => (
										<img
											class="hero__flag"
											src={country.src}
											alt=""
											width="40"
											height="40"
											loading="eager"
											decoding="async"
										/>
									))}
								</div>
							))
						}
					</div>
					<ul class="sr-only">
						{FLAGS.map((country) => <li>{country.name}</li>)}
					</ul>
					<span class="hero__trust-stat">{PROOF_HEADLINE}</span>
				</div>
			</div>
		</div>

		{/*
			The readouts. They float over the footage rather than sitting in a
			column, and both carry real text, so both stay in the reading order —
			after the copy they support.
		*/}
		<div class="hero__panel" data-hero-in="tail">
			<div class="hero__card hero__card--views">
				<p class="hero__card-label">{CARD_VIEWS.label}</p>
				<p class="hero__card-value">{CARD_VIEWS.value}</p>
				{/* The trend line. Pure decoration — the figure above it is the data. */}
				<svg class="hero__spark" viewBox="0 0 120 32" fill="none" aria-hidden="true">
					<path
						d="M2 27 L18 22 L32 24 L46 16 L60 18 L74 11 L88 13 L104 5 L118 3"
						stroke="url(#hero-spark)"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
					<defs>
						<linearGradient id="hero-spark" x1="0" y1="0" x2="120" y2="0">
							<stop offset="0" stop-color="#0a66ff"></stop>
							<stop offset="1" stop-color="#b3d3ff"></stop>
						</linearGradient>
					</defs>
				</svg>
				<p class="hero__card-note">
					<span class="hero__card-trend" aria-hidden="true">↗</span>
					{CARD_VIEWS.note}
				</p>
			</div>

			<div class="hero__card hero__card--clients">
				<p class="hero__card-label">{CARD_CLIENTS.label}</p>
				{/*
					Every mark knocked back to one bone silhouette. Three brand palettes
					dropped onto a navy card at their native colours would read as three
					stray images rather than as one roster — the same call the trust band
					makes, for the same reason.
				*/}
				<ul class="hero__clients">
					{
						CLIENTS.map((client) => (
							<li class="hero__client">
								<Image
									class="hero__client-logo"
									src={client.logo}
									alt={client.practice}
									height={26}
									densities={[1, 2]}
									loading="eager"
								/>
							</li>
						))
					}
					<li class="hero__client hero__client--more">{PRACTICE_COUNT}</li>
				</ul>
				<p class="hero__card-note">{CARD_CLIENTS.note}</p>
			</div>
		</div>
	</div>

	{/*
		The figure band, closing the fold. Inside the hero rather than a section
		of its own because it is the evidence for the sentence directly above it,
		and a rule between the two would break that link.
	*/}
	<ul class="hero__stats" data-hero-in="tail">
		{
			STATS.map((stat) => (
				<li class="hero__stat">
					<span class="hero__stat-icon" aria-hidden="true">
						<Glyph name={stat.icon} />
					</span>
					<span class="hero__stat-body">
						<span class="hero__stat-value">{stat.value}</span>
						<span class="hero__stat-label">
							{stat.label}
							<span class="hero__stat-sub">{stat.sub}</span>
						</span>
					</span>
				</li>
			))
		}
	</ul>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		/* dvh, not vh — vh is wrong the moment mobile Safari's chrome moves. */
		min-height: 100dvh;
		padding-block: calc(var(--nav-h, 5.25rem) + clamp(1.5rem, 4vh, 3rem)) clamp(1rem, 2vh, 1.75rem);
		overflow: clip;
		isolation: isolate;
	}

	/* Fallback for the handful of engines without dvh. */
	@supports not (height: 100dvh) {
		.hero {
			min-height: 100vh;
		}
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-color: var(--color-ink-950);
		/* Shows through if the video 404s or is still downloading. JPEG first as
		   the floor, then let the browser take the best format it supports —
		   8 KiB of AVIF against 67 KiB of JPEG on the largest paint on the page. */
		background-image: url('/images/hero-poster.jpg');
		background-image: image-set(
			url('/images/hero-poster.avif') type('image/avif'),
			url('/images/hero-poster.webp') type('image/webp'),
			url('/images/hero-poster.jpg') type('image/jpeg')
		);
		background-size: cover;
		background-position: 76% 42%;
	}

	.hero__video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/*
			Pushed off to the right: the copy column owns the left half of the
			frame now, so the footage's bright mass has to sit beside it rather
			than under it.
		*/
		object-position: 76% 42%;
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		background:
			/* Ink banked down the left, where the copy is. */
			linear-gradient(
				90deg,
				var(--color-ink-950) 0%,
				color-mix(in oklab, var(--color-ink-950) 92%, transparent) 26%,
				color-mix(in oklab, var(--color-ink-950) 62%, transparent) 46%,
				color-mix(in oklab, var(--color-ink-950) 18%, transparent) 66%,
				transparent 100%
			),
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-ink-950) 62%, transparent) 0%,
				color-mix(in oklab, var(--color-ink-950) 12%, transparent) 34%,
				color-mix(in oklab, var(--color-ink-950) 72%, transparent) 84%,
				var(--color-ink-950) 100%
			);
	}

	.hero__vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			120% 86% at 74% 44%,
			transparent 32%,
			color-mix(in oklab, var(--color-ink-950) 78%, transparent) 100%
		);
	}

	/* ── Layout ──────────────────────────────────────────────────────────── */
	/*
		Its own measure rather than `.container-content`: this fold is furniture as
		much as copy, and the band, the nav bar and the copy column all have to
		share one edge.
	*/
	.hero__inner {
		position: relative;
		width: calc(100% - var(--gutter) * 2);
		max-width: 112rem;
		margin-inline: auto;
		display: grid;
		gap: clamp(2.5rem, 6vw, 4rem);
		align-items: center;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: clamp(1rem, 2.4vh, 1.5rem);
		text-align: start;
	}

	/* ── Badge ───────────────────────────────────────────────────────────── */
	.hero__badge {
		display: inline-flex;
		align-items: center;
		margin: 0;
		height: 1.875rem;
		padding-inline: 0.875rem;
		border-radius: 999px;
		border: 1px solid var(--color-line-strong);
		background: color-mix(in oklab, var(--color-ink-950) 88%, transparent);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		letter-spacing: 0.14em;
		line-height: 1;
		text-transform: uppercase;
		color: var(--color-bone-300);
	}

	/* ── Headline ────────────────────────────────────────────────────────── */
	.hero__title {
		margin: 0;
		/*
			Sized against the half-width column it now sits in rather than against
			the window: at the old 6.1vw the line ran straight into the readouts.
		*/
		font-size: clamp(2.35rem, 3.9vw + 0.9rem, 4.35rem);
		line-height: 1.03;
		font-weight: 700;
		letter-spacing: -0.03em;
		text-wrap: balance;
		max-width: 19ch;
	}

	.hero__title-visual {
		display: block;
	}

	/*
		Block, not inline — and not only for the line break it pins down. Astro
		emits a newline between the two parts, and as inlines that collapsed to a
		real space *on top of* the word margin below, so the seam rendered a space
		and a half wide.
	*/
	.hero__part {
		display: block;
	}

