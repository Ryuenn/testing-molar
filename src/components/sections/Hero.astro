---
/**
 * Section 01 — the hero.
 *
 * Split composition: the argument runs down the left half in a column and the
 * footage holds the right. Nothing else. Order down the left is eyebrow,
 * headline, one paragraph, one ask, the price, one trust line.
 *
 * Three things came off this fold in the same pass, and all three were the site
 * arguing before it had introduced itself:
 *
 *   the readouts   two cards floating over the footage — a 10M organic-views
 *                  counter and a client roster — the first obscuring the video
 *                  it decorated, the second a small copy of the trust band
 *                  immediately below the fold.
 *   the flags      an eighteen-country marquee inside the trust line, which the
 *                  closing band already runs at full size.
 *   the figures    a five-cell statistics band closing the fold.
 *
 * None of the claims were deleted. Each now sits beside the thing that
 * evidences it — the logos in `TrustBand`, the views and the growth in the
 * MOLAR Social case study, the markets in the band under the closing CTA — and
 * the fold says one thing instead of nine.
 */
import { Image } from 'astro:assets';
/* The trimmed derivative — see the note on the same import in `~/components/Nav`. */
import logoIcon from '~/assets/brand/logo-mark.png';
import { EDUCATION_CHECKOUT, SITE } from '~/data/site';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

/**
 * Media contract — files live in `public/videos/` and `public/images/`.
 * Renaming any of these means updating `public/videos/README.md` too.
 */
const VIDEO = {
	// `poster` takes a single URL — no srcset, no <picture> — and it points at the
	// AVIF **on purpose, to match what `.hero__media`'s image-set() picks**.
	//
	// It used to be the WebP, which meant every reload fetched this one frame
	// TWICE: the CSS background took the AVIF (39KB) and the poster attribute took
	// the WebP (55KB), for two copies of an identical picture drawn in identical
	// positions. 94KB of the fold's weight, half of it for nothing.
	//
	// Pointing both at the same file makes it one request that both uses share.
	// The handful of browsers too old for AVIF simply fail to load the poster and
	// fall through to the CSS background beneath the video, which negotiates
	// WebP/JPEG for them — so the fold still has a picture, from the format they
	// can read.
	//
	// Cut from THIS footage at 2s, and re-cut whenever the clip changes, or the
	// fold shows one room before the video paints another:
	//
	//   ffmpeg -ss 2 -i Molar_Hero_Updated-web.mp4 -frames:v 1 hero-poster.png
	//   ffmpeg -i hero-poster.png -q:v 4 hero-poster.jpg
	//   ffmpeg -i hero-poster.png -c:v libwebp -quality 72 hero-poster.webp
	//   ffmpeg -i hero-poster.png -c:v libaom-av1 -still-picture 1 -crf 38 \
	//     -cpu-used 6 hero-poster.avif
	poster: '/images/hero-poster.avif',
	// The footage behind the fold. One cut serves every width — see the crop note
	// on .hero__video below.
	//
	// It has to earn its place: `Blue_structure_Hero.mp4` was handsome and meant
	// nothing, moving wallpaper behind a headline. Whatever runs here should be
	// the product in the room it is sold for — and this is exactly that: a
	// patient in the chair watching MOLAR TV on the wall.
	//
	// The web cut of `Molar_Hero_Updated.mp4`, not the master. NEVER point this
	// at a delivered file directly — every one of them so far has been mastered
	// for editing rather than for a browser.
	//
	// This delivery was 1660x1244 at 8.2 Mbps: 10.5MB for a ten-second muted loop
	// behind a headline, which is most of what a first paint has to wait through.
	// Re-encoded at CRF 23 with `faststart`, so playback begins on the first
	// chunk rather than after a range request to the end of the file — 10.5MB →
	// 1.7MB, and visually identical at this size behind a scrim. It carries no
	// audio track to strip, but `-an` stays in the command because the next
	// delivery might.
	//
	//   ffmpeg -i Molar_Hero_Updated.mp4 -an -c:v libx264 -crf 23 -preset slow \
	//     -pix_fmt yuv420p -movflags +faststart Molar_Hero_Updated-web.mp4
	//
	// Any replacement footage wants the same treatment, AND a re-cut poster —
	// see above. The two are one change: a poster from the previous clip shows a
	// different room for a moment and then jumps.
	mp4: '/videos/Molar_Hero_Updated-web.mp4',
};

/**
 * The headline, pre-split for the entrance.
 *
 * Each part is a run of the line that shares a colour; inside it the words are
 * atomic (so a word never breaks across lines) and the letters are what
 * actually animate. Written as data rather than markup because the alternative
 * is forty hand-authored spans that nobody can edit.
 */
const TITLE_PARTS = [
	{ text: t('hero.titleLead'), accent: false },
	{ text: t('hero.titleAccent'), accent: true },
];

/** The same line as one string, for anything that reads rather than looks. */
const TITLE_TEXT = TITLE_PARTS.map((part) => part.text).join(' ');

/*
	The two promises inside the paragraph are lit in the accent, which is what
	makes the sentence scannable at a glance instead of a wall.

	Still keyed by locale even with English the only one. A phrase is not a
	phrase once it has been translated, so a second locale needs its own marks
	rather than inheriting English substrings that would never match — and the
	paragraph rendering flat is the correct failure when they do not.
*/
const LEDE_MARKS: Record<string, readonly string[]> = {
	en: ['custom in-office TV playlists', '300+ patient videos'],
};

/** The lede as alternating plain / lit runs, in source order. */
const ledeParts = (() => {
	const marks = LEDE_MARKS[locale] ?? [];
	const raw = t('hero.lede');
	if (!marks.length) return [{ text: raw, lit: false }];
	/* One pass, splitting on whichever mark comes next — a capturing alternation
	   keeps the delimiters in the output, so nothing has to be re-joined. */
	const pattern = new RegExp(
		`(${marks.map((mark) => mark.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`,
	);
	return raw
		.split(pattern)
		.filter(Boolean)
		.map((text) => ({ text, lit: marks.includes(text) }));
})();

/*
	The follow rail.

	Instagram, Facebook, YouTube — the same three the footer lists, from the same
	source. TikTok came off: the accounts MOLAR runs for practices publish to
	Instagram and Facebook, which is what both social plans advertise, and a
	fourth mark pointing somewhere the product does not post is a link that
	contradicts the price list two screens down.
*/
const SOCIAL = [
	{ label: 'Instagram', href: SITE.social.instagram, icon: 'instagram' },
	{ label: 'Facebook', href: SITE.social.facebook, icon: 'facebook' },
	{ label: 'YouTube', href: SITE.social.youtube, icon: 'youtube' },
] as const;
---

<section class="hero" data-hero aria-labelledby="hero-heading">
	<div class="hero__media">
		{/*
			`playsinline` + `muted` are what let iOS autoplay at all.
			The poster is required: without it there is a black flash before the
			first decoded frame, and it is also the whole picture for anyone on a
			data saver, a reduced-motion setting, or a failed video request.
		*/}
		<video
			class="hero__video"
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			poster={VIDEO.poster}
			aria-hidden="true"
			tabindex="-1"
			disablepictureinpicture
			disableRemotePlayback
		>
			<source src={VIDEO.mp4} type="video/mp4" />
		</video>

		{/* Scrim. The copy column is on the left, so the ink is banked there. */}
		<div class="hero__scrim" data-hero-scrim></div>
		<div class="hero__vignette" aria-hidden="true"></div>
		<div class="grain" aria-hidden="true"></div>
	</div>

	{/*
		The follow rail, pinned to the right edge rather than placed in the flow.
		It is a secondary invitation — the two buttons in the copy column are what
		the hero is actually asking for — and an aside belongs in the margin.
	*/}
	<ul class="hero__social" aria-label="Follow MOLAR AI">
		{
			SOCIAL.map((link) => (
				<li>
					{/*
						External, so rel="noopener". No noreferrer — these are the
						company's own accounts and the referrer is wanted in their
						analytics.
					*/}
					<a href={link.href} class="hero__social-link" target="_blank" rel="noopener">
						<SocialIcon name={link.icon} class="hero__social-icon" />
						<span class="sr-only">{link.label} {t('footer.newTab')}</span>
					</a>
				</li>
			))
		}
	</ul>

	<div class="hero__inner">
		<div class="hero__copy">
			{/*
				No eyebrow badge either.

				"MOLAR TV · $97/MONTH" sat here in a bordered pill the same height and
				shape as the offer link below the button — so the fold presented three
				pill-shaped things and only the middle one did anything. Both pills are
				gone and the headline is the first thing on the page.

				The price still leads the section immediately under this fold and runs
				through the plan grid and the closing CTA; it is not the job of the
				first two centimetres of the page to quote it.
			*/}

			{/*
				The visual copy is split into per-letter spans and hidden from assistive
				tech; the real sentence is carried once, in order, by the sr-only span.
				An aria-label on the <h1> would do the same job, but this survives a
				translation layer rewriting the visible text and leaves the accessible
				name built from actual content.
			*/}
			<h1 id="hero-heading" class="hero__title">
				<span class="sr-only">{TITLE_TEXT}</span>
				<span class="hero__title-visual" aria-hidden="true">
					{
						TITLE_PARTS.map((part) => (
							<span class:list={['hero__part', part.accent && 'hero__part--accent']}>
								{part.text.split(' ').map((word) => (
									<span class="hero__word">
										{[...word].map((char) => (
											<span class="hero__letter" data-hero-letter>
												{char}
											</span>
										))}
									</span>
								))}
							</span>
						))
					}
				</span>
			</h1>

			<p class="hero__lede" data-hero-in="tail">
				{
					ledeParts.map((part) =>
						part.lit ? <span class="hero__lede-lit">{part.text}</span> : part.text,
					)
				}
			</p>

			{/*
				One button.

				There were two — buy, and go look at the product page. The second was
				an off-ramp at the exact moment the page has the most attention it will
				ever have, and the tour it offered is the next three sections of this
				same page. What is left is the trial, at the price, going straight to
				the checkout that honours it.
			*/}
			<div class="hero__actions" data-hero-in="tail">
				<a
					href={EDUCATION_CHECKOUT}
					target="_blank"
					rel="noopener"
					class="hero__btn hero__btn--solid"
				>
					<span>{t('cta.explore')}</span>
					<span class="sr-only"> {t('footer.newTab')}</span>
					{/* The tile, and it needs no disc behind it — it is its own rounded
					    ground. Decorative: the label is the link's accessible name. */}
					<Image
						src={logoIcon}
						alt=""
						height={34}
						densities={[1, 2]}
						loading="eager"
						decoding="sync"
						class="hero__cta-mark"
					/>
				</a>
			</div>

			{/*
				The "$97/month · 14 days free" pill that sat here is gone, along with
				the "MOLAR TV · $97/MONTH" eyebrow badge above the headline.

				Both were bordered, tinted, rounded — the same shape as the button
				between them — so the fold offered three things that looked pressable
				and one that was. The offer link went to the same checkout as the
				button directly above it, which is a second button by any reading.

				The price is not lost: `MolarTv` leads the section immediately below
				this fold, the plan grid states all four, and the closing CTA quotes
				the offer in full directly above its own single button.
			*/}

			{/*
				No trust line. "Trusted by dental practices around the world" sat at
				the foot of this column, and `TrustBand` — the very next thing on the
				page — carries the same sentence as its own heading with sixteen
				client logos under it. The claim is better made once, over the
				evidence, than twice with the first one unevidenced.

				It ran an eighteen-flag marquee and a view count beside it before
				that. Both went in the same direction: the flags are the band under
				the closing CTA, and the view count is a social-media figure that was
				being used to sell a waiting-room screen.
			*/}
		</div>

		{/*
			The floating readouts are gone.

			There were two cards over the footage — a 10M organic-views counter with a
			sparkline, and a client roster. The roster went first, as a quarter-size
			copy of the trust band directly below the fold; the counter has followed
			it, because it sat on top of the video it was meant to decorate and
			because the figure argues for social media on a fold that sells a screen.
			`~/data/proof` still carries it, and MOLAR Social's own case study is
			where it now runs.
		*/}
	</div>

	{/*
		No figure band. Five cells — practices, views, languages, countries,
		continents — closed the fold with a wall of statistics before the visitor
		had been told what the product is. The claims are all still on the site,
		each next to the thing that evidences it: the logos in `TrustBand`, the
		views and the growth in the case study, the markets in the closing band.
	*/}
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		/*
			Centred in the fold.

			The two pads are deliberately lopsided and that is what does the
			centring. The nav is a floating bar over this section rather than
			something it sits below, so the space the copy should centre in runs
			from under the bar to the bottom of the viewport — not the full height.
			Carrying `--nav-h` in the top pad and almost nothing in the bottom
			offsets the block by half that difference, which lands it in the middle
			of the space a reader actually sees.

			`--nav-h` rather than a literal: the bar's height is published on :root
			and changes with the breakpoint. Hard-coding it here would put the copy
			slightly off-centre at every width but one.
		*/
		justify-content: center;
		/* dvh, not vh — vh is wrong the moment mobile Safari's chrome moves. */
		min-height: 100dvh;
		padding-block: calc(var(--nav-h, 5.25rem) + clamp(1.5rem, 4vh, 3rem)) clamp(1rem, 2vh, 1.75rem);
		overflow: clip;
		isolation: isolate;
	}

	/* Fallback for the handful of engines without dvh. */
	@supports not (height: 100dvh) {
		.hero {
			min-height: 100vh;
		}
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-color: var(--color-ink-950);
		/* Shows through if the video 404s or is still downloading. JPEG first as
		   the floor, then let the browser take the best format it supports —
		   35 KiB of AVIF against 113 KiB of JPEG on the largest paint on the page. */
		background-image: url('/images/hero-poster.jpg');
		background-image: image-set(
			url('/images/hero-poster.avif') type('image/avif'),
			url('/images/hero-poster.webp') type('image/webp'),
			url('/images/hero-poster.jpg') type('image/jpeg')
		);
		background-size: cover;
		/* Matches `.hero__video`'s `object-position` exactly — see the note there.
		   They frame the same picture, and any difference between the two shows up
		   as the fold jolting the moment the video paints over the poster. */
		background-position: 50% 38%;
	}

	.hero__video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/*
			NOT mirrored, and this must stay that way.

			The previous clip had the patient on the right and the screen on the
			left, so it carried `transform: scaleX(-1)` to satisfy the brief's
			"patient on the left, TV on the right". `Hero_videoFinal.mp4` is already
			shot that way, so the flip would now put it back to front.

			⚠️ And this footage HAS legible type in it — "HAVE QUESTIONS?", the
			practice's wordmark on the screen, "TREATMENT ROOM 2" on the door. A
			mirror would render every one of them backwards. The old rule carried a
			warning to drop it the day the clip had text on screen; that day is now.
		*/
		/*
			The clip is 4:3 (1660x1244) against a fold that is usually much wider, so
			`cover` scales to the width and the crop is entirely vertical — which
			makes the horizontal half of this value a no-op on a desktop window and
			only load-bearing on a narrow one, where it holds the centre.

			38% vertical takes more off the bottom than the top: the floor and the
			foot of the chair are the least interesting part of the frame, and the
			screen on the wall is the part that has to survive.
		*/
		object-position: 50% 38%;
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		background:
			/*
				Ink banked down the left, where the copy is.

				Eased back a step: the near edge was FULLY opaque ink, so the left
				third of the fold was a flat black panel rather than a dark part of
				the room — the chair and the patient in it disappeared into it
				entirely. It is a scrim, and a scrim you cannot see through is a
				background colour.

				Deliberately a small move (100/92/62/18 → 90/80/54/14). The headline
				is white on this and the paragraph under it is not; whatever comes off
				here comes straight off their contrast, so the room reads through the
				ink without the copy having to fight it.
			*/
			linear-gradient(
				90deg,
				color-mix(in oklab, var(--color-ink-950) 90%, transparent) 0%,
				color-mix(in oklab, var(--color-ink-950) 80%, transparent) 26%,
				color-mix(in oklab, var(--color-ink-950) 54%, transparent) 46%,
				color-mix(in oklab, var(--color-ink-950) 14%, transparent) 66%,
				transparent 100%
			),
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-ink-950) 62%, transparent) 0%,
				color-mix(in oklab, var(--color-ink-950) 12%, transparent) 34%,
				color-mix(in oklab, var(--color-ink-950) 72%, transparent) 84%,
				var(--color-ink-950) 100%
			);
	}

	/*
		The vignette, eased back.

		It ran `transparent 32%` to 78% ink at the edge — a third of the frame
		clear and then two thirds ramping into near-black, which put the treatment
		room's corners, the doorway and the chair into shadow the footage does not
		have. The room is the argument here; darkening its edges to focus a reader
		who is already looking at a screen in the middle of the frame costs more
		than it buys.

		Clear further out (32% → 46%) and darker only by half at the edge (78% →
		42%). Still a vignette — the corners settle rather than compete with the
		headline — but the picture reaches them now.
	*/
	.hero__vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			120% 86% at 74% 44%,
			transparent 46%,
			color-mix(in oklab, var(--color-ink-950) 42%, transparent) 100%
		);
	}

	/* ── Layout ──────────────────────────────────────────────────────────── */
	/*
		Its own measure rather than `.container-content`: this fold is furniture as
		much as copy, and the band, the nav bar and the copy column all have to
		share one edge.
	*/
	.hero__inner {
		position: relative;
		width: calc(100% - var(--gutter) * 2);
		max-width: 112rem;
		margin-inline: auto;
		display: grid;
		gap: clamp(2.5rem, 6vw, 4rem);
		align-items: center;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: clamp(1rem, 2.4vh, 1.5rem);
		text-align: start;
	}

	/* `.hero__badge` and `.hero__offer` are gone with the two pills they drew —
	   see the notes in the markup. */

	/* ── Headline ────────────────────────────────────────────────────────── */
	.hero__title {
		margin: 0;
		/*
			Sized against the half-width column it now sits in rather than against
			the window: at the old 6.1vw the line ran straight into the readouts.
		*/
		font-size: clamp(2.35rem, 3.9vw + 0.9rem, 4.35rem);
		line-height: 1.03;
		font-weight: 700;
		letter-spacing: -0.03em;
		text-wrap: balance;
		max-width: 19ch;
	}

	.hero__title-visual {
		display: block;
	}

	/*
		Block, not inline — and not only for the line break it pins down. Astro
		emits a newline between the two parts, and as inlines that collapsed to a
		real space *on top of* the word margin below, so the seam rendered a space
		and a half wide.
	*/
	.hero__part {
		display: block;
	}

	.hero__part--accent {
		color: var(--color-arc-400);
		/* Applied per letter, which is what makes it cheap — no filter on a
		   forty-child block, just a shadow each glyph already needs. */
		text-shadow: 0 0 46px color-mix(in oklab, var(--color-arc-500) 45%, transparent);
	}

	/*
		Words are atomic so no letter is ever orphaned onto the next line. The
		trailing margin is the word space — real whitespace between the generated
		spans is not something the template can promise.
	*/
	.hero__word {
		display: inline-block;
		white-space: nowrap;
		margin-inline-end: 0.26em;
	}

	.hero__part:last-child .hero__word:last-child {
		margin-inline-end: 0;
	}

	/*
		The last word of the accent run takes a line of its own. Left to wrap, the
		line runs the full width of the column and reads as one long beat; broken
		here it reads as two, which is the shape the headline was written for.
	*/
	.hero__part--accent .hero__word:last-child {
		display: block;
	}

	/* inline-block, or `transform` on the entrance has nothing to act on. No
	   `will-change` — there are forty of these, and promoting every one of them
	   costs more than the tween it would smooth. */
	.hero__letter {
		display: inline-block;
	}

	/* ── Supporting copy ─────────────────────────────────────────────────── */
	.hero__lede {
		max-width: 52ch;
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--color-bone-300);
	}

	/* The two promises, lit. Not links — nothing here navigates — so no
	   underline and no pointer. */
	.hero__lede-lit {
		color: var(--color-arc-300);
	}

	/* ── CTA ─────────────────────────────────────────────────────────────── */
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: clamp(0.25rem, 1.2vh, 0.75rem);
	}

	/*
		One button, and it is the only pill on this fold now. The shape used to be
		shared by three things — the eyebrow badge, this, and the offer link — and
		two of the three did not navigate anywhere worth a button.
	*/
	.hero__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		height: 3rem;
		padding-inline: 1.25rem 0.4375rem;
		border-radius: 0.75rem;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		transition:
			background-color 0.28s var(--ease-out-quint),
			border-color 0.28s var(--ease-out-quint),
			box-shadow 0.28s var(--ease-out-quint),
			transform 0.28s var(--ease-out-quint);
	}

	.hero__btn--solid {
		border: 1px solid color-mix(in oklab, var(--color-arc-300) 55%, transparent);
		background: var(--color-arc-500);
		color: #fff;
		box-shadow: 0 18px 40px -20px color-mix(in oklab, var(--color-arc-400) 90%, transparent);
	}

	.hero__btn--solid:hover {
		background: var(--color-arc-400);
		transform: translateY(-2px);
		box-shadow: 0 24px 54px -18px color-mix(in oklab, var(--color-arc-400) 95%, transparent);
	}

	.hero__btn--quiet {
		padding-inline: 1.25rem;
		border: 1px solid var(--color-line-strong);
