---
/**
 * Section 02 — client trust, immediately under the hero.
 *
 * The strategy asks for a logo wall, and it is one now: sixteen real marks from
 * `~/data/clients`, every one supplied by the practice.
 *
 * It used to be driven by `~/data/work` — the six practices whose grids the site
 * publishes — which meant two marks and four practices rendered as names in
 * type, because those four had no logo we could source. A row that is two thirds
 * text is not a logo wall.
 *
 * ── Real colours, on plates ────────────────────────────────────────────────
 * Every mark used to be knocked back to a single bone silhouette — the artwork
 * reduced to an alpha channel by `scripts/generate-client-logos.mjs` and then
 * painted white by `filter: brightness(0) invert(1)`. The reasoning was that
 * sixteen brand palettes dropped straight onto a navy band would read as
 * sixteen stray screenshots rather than as one row, and that monochrome is what
 * makes a mixed wall a wall.
 *
 * That is true of logos sitting directly on the ground, and it is why the row
 * came out flat and grey. These are real practices' brands and they are drawn
 * as such now: full colour, each on its own plate.
 *
 * The plate is the load-bearing part. Most masters are dark artwork on a light
 * ground, so at native colours on a near-black band they would be invisible.
 * The plate gives each mark the field it was designed for, and the plates are
 * what unify the row instead of a filter.
 *
 * Two of them are drawn the other way round — near-white artwork on
 * transparency — and those get a dark plate instead. Which is which is not
 * hand-maintained: the generator measures it and writes `client-logo-tone.json`,
 * imported below.
 *
 * To add one: add a line to `~/data/clients` (that list is the filter), drop the
 * logo in `logos-master/`, and run `npm run client-logos`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CLIENT_LOGOS } from '~/data/clients';
/*
	Generated by `scripts/generate-client-logos.mjs`, not hand-written. Maps a
	slug to 'light' where the artwork is near-white on transparency and needs a
	dark plate instead of the off-white one — see the note on `.trust__client`.
*/
import LOGO_TONE from '~/data/client-logo-tone.json';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

/**
 * The marquee needs two identical tracks. The first scrolls a full -100% of its
 * own width while the second slides in behind it, so the seam is invisible and
 * the loop never shows a gap. Only the first is exposed to assistive tech.
 */
const TRACKS = [0, 1];

/*
	The marks. Eager, because these are build-time `ImageMetadata` records for
	<Image>.

	A practice listed in `~/data/clients` with no file behind it is dropped rather
	than rendered as a gap — the roster and the folder are edited separately, and
	a name in one without art in the other should cost a slot in the row, not a
	hole in it.
*/
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/clients/*.{svg,png}', {
	eager: true,
});

const tone: Record<string, string> = LOGO_TONE;

const CLIENTS = CLIENT_LOGOS.map((client) => ({
	name: client.name,
	/* True where the mark is light-on-transparent and wants a dark plate. */
	light: tone[client.slug] === 'light',
	logo: (
		logoFiles[`../../assets/clients/${client.slug}.svg`] ??
		logoFiles[`../../assets/clients/${client.slug}.png`]
	)?.default,
})).filter((client): client is { name: string; light: boolean; logo: ImageMetadata } =>
	Boolean(client.logo),
);
---

<section class="trust" aria-labelledby="trust-heading">
	<div class="container-content trust__head">
		<h2 id="trust-heading" class="trust__title" data-reveal>{t('trust.heading')}</h2>
	</div>

	<div class="marquee trust__marquee" data-reveal="fade">
		{
			TRACKS.map((track) => (
				/*
					Track 1 is the seam-filler — the same sixteen marks again, purely so
					the loop never shows a gap. `aria-hidden` on the whole track, so the
					roster is announced once rather than twice.
				*/
				<div class="marquee__track" aria-hidden={track === 1 ? 'true' : undefined}>
					{CLIENTS.map((client) => (
						/*
							A <div>, not an <a>.

							Every mark used to link to /our-work/ — all sixteen to the same
							page — which is a row of thirty-two controls that all do one
							thing. This is a statement about who uses MOLAR, not a menu, so
							there is nothing here to press and nothing pretending there is.
							Sixteen stops removed from the tab order with it.
						*/
						<div class:list={['trust__client', client.light && 'trust__client--dark']}>
							{/*
								Decorative. The practice name is carried as text beside it, on
								track 0 only — track 1 is `aria-hidden` in its entirety, so its
								copy of the name is never announced.
							*/}
							<Image
								class="trust__client-logo"
								src={client.logo}
								alt=""
								height={56}
								densities={[1, 2]}
								loading="lazy"
							/>
							<span class="sr-only">{client.name}</span>
						</div>
					))}
				</div>
			))
		}
	</div>
</section>

<style>
	.trust {
		position: relative;
		/* Roomier than it was. The band used to be squeezed between the hero's own
		   figure band and the section below it; the figure band is gone, and this
		   is now the first proof on the page rather than the fourth thing under
		   the fold. It gets the height to be looked at. */
		padding-block: clamp(2.5rem, 5vw, 4rem);
		border-bottom: 1px solid var(--color-line);
		/* A wash over the page's lit ground, not a fill on top of it. */
		background: linear-gradient(
			180deg,
			transparent,
			color-mix(in oklab, var(--color-ink-900) 62%, transparent)
		);
		overflow: clip;
	}

	.trust__head {
		margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
		text-align: center;
	}

	/*
		A heading, set as one.

		It was 10px uppercase mono at bone-500 — a caption over a row of logos
		knocked back to 72% opacity, so the one piece of social proof above the
		fold read as a disclaimer. The line is a claim about who uses this and it
		is set like a claim: display face, sentence case, near-white.
	*/
	.trust__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-bone-50);
	}

	.trust__marquee {
		--marquee-duration: 56s;
	}

	/*
		The plate. Two jobs, both of them problems the flat-white filter was
		papering over:

		  colour  the marks are dark-artwork-on-white, so at native colours on the
		          section's near-black ground most of them would be invisible. A
		          white field is what they were drawn for.
		  seams   each master carries its own slightly-off-white background —
		          Physimed's is a blue-grey gradient — which would show as a faint
		          rectangle on a pure white band. Inside a plate that tint reads
		          as the plate.

		No hover state, no cursor, no focus ring: this is not a control. See the
		note in the markup.

		Padding here rather than gap on the track: the marquee's spacing is set in
		global.css and shared by three sections.
	*/
	.trust__client {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 1.25rem;
		border-radius: 0.875rem;
		/* Not pure #fff. A hard white edge against navy reads as a cut-out; a
		   fractionally cool off-white sits on the ground instead of punching
		   through it, and no logo here is white enough to disappear into it. */
		background: #f7f9fc;
		box-shadow: 0 12px 30px -18px #000;
		white-space: nowrap;
	}

	/*
		The two marks that are drawn the other way round.

		APAC DSM and Dr Yolanda Cruz are delivered as near-white artwork on
		transparency — made for a dark background — so the off-white plate renders
		them invisible. `scripts/generate-client-logos.mjs` measures that and lists
		them in `client-logo-tone.json`; nothing here is hand-maintained, so a
		future logo of either kind lands on the right ground on the next run.

		Ink rather than pure black, and a hairline in place of the shadow: at this
		size a black rectangle in a row of white ones reads as a hole in the band.
	*/
	.trust__client--dark {
		background: var(--color-ink-800);
		border: 1px solid color-mix(in oklab, #dbe8ff 16%, transparent);
		box-shadow: 0 12px 30px -20px #000;
	}

	/*
		No filter. The marks carry their own colours — see the note at the top of
		the file and the pipeline in `scripts/generate-client-logos.mjs`, which
		stopped destroying them.

		`object-fit: contain` matters here: the plates are a uniform height and
		the artwork is not, so a mark that is 1288px wide (Dentistry on the Path)
		and one that is 93px (Adom) both have to sit inside the same box without
		being stretched to it.
	*/
	.trust__client-logo {
		width: auto;
		height: 3.5rem;
		max-width: 14rem;
		object-fit: contain;
	}

	/*
		`.trust__client--logo` and `.trust__client-name` / `-meta` are gone.

		The band once mixed marks with practice names set in type, for the four
		practices whose logo we could not source, and those three rules were what
		kept the two kinds on one baseline. Every entry is a mark now — see the
		note at the top of the file — and the centring lives on `.trust__client`
		itself.
	*/
</style>
