---
/**
 * Section 12 — customer stories.
 *
 * Three practices, each with its own feed grid, the products MOLAR runs for
 * them, and — for the one where it exists — a measured result read off a public
 * profile.
 *
 * ONE card carries a quote and the other two do not, which is the honest state
 * of the evidence rather than an oversight. `~/data/testimonials` holds the
 * client testimonials transcribed from the live /educate funnel; exactly one of
 * them names the practice it came from, and that is the only card that gets it.
 *
 * The other two testimonials run anonymously and belong in `Testimonials`,
 * which says so. They must never be attached to a named practice here: putting
 * an unattributed quote on a named card attributes it, which is a fabrication
 * however true the sentence is. The messages on /results/ are a further step
 * away again — those are from OTHER practices who saw the work in their feed,
 * not from customers at all.
 *
 * The link out goes to /customers/, which carries the same three stories beside
 * the growth exhibit and the inbound wall — the evidence this section is short
 * enough to leave out.
 */
import { Image } from 'astro:assets';
import { CUSTOMER_STORIES, PHYSIMED_RESULT } from '~/data/customers';
import { testimonialFor } from '~/data/testimonials';
import type { WorkAccount } from '~/data/work';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';

export interface Props {
	/** Heading level. /customers/ runs this under its own h1. */
	as?: 'h2' | 'h3';
	/** Render the eyebrow, headline and lede. Off where the page's own <h1>
	    already carries them. */
	head?: boolean;
}

const { as: Heading = 'h2', head = true } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/work/*.png', {
	eager: true,
});

const gridFor = (account: WorkAccount): ImageMetadata => {
	const file = files[`../../assets/work/${account.slug}.png`];
	if (!file) throw new Error(`No grid image for work account "${account.slug}".`);
	return file.default;
};

const STORIES = CUSTOMER_STORIES.map((story) => ({
	...story,
	image: gridFor(story.account),
	/* Only where a real, attributed quote exists for this exact practice. */
	testimonial: testimonialFor(story.account.slug),
	products: story.products.map((id) => t(`products.${id}Name` as 'products.socialName')),
	result:
		story.resultKey === 'physimed'
			? t('customers.resultPhysimed', {
					from: PHYSIMED_RESULT.from,
					value: PHYSIMED_RESULT.value,
				})
			: undefined,
	/* Only the featured account has a case study, and only it gets a link out
	   to one — a "read the full story" on a card with no story behind it is a
	   dead end dressed as a promise. */
	href: story.account.caseStudy
		? localizePath(story.account.caseStudy.href, locale)
		: localizePath('/our-work/', locale),
}));
---

<section
	id="customers"
	class="section section-rule cs"
	aria-labelledby={head ? 'cs-heading' : undefined}
	aria-label={head ? undefined : t('customers.eyebrow')}
>
	<div class="container-content">
		{
			head && (
				<header class="cs__head">
					<p class="eyebrow" data-reveal="fade">
						{t('customers.eyebrow')}
					</p>
					<Heading id="cs-heading" class="cs__title" data-reveal>
						{t('customers.heading')}
					</Heading>
					<p class="cs__lede measure-wide" data-reveal>
						{t('customers.lede')}
					</p>
				</header>
			)
		}

		<ul class="cs__grid" data-reveal-stagger>
			{
				STORIES.map((story) => (
					<li class="story panel panel-hover" data-reveal data-reveal-group>
						<a class="story__link" href={story.href}>
							<Image
								src={story.image}
								alt={t('work.alt', {
									practice: story.account.practice,
									specialty: story.account.specialty,
									language: story.account.language,
									a: story.account.palette[0].name,
									b: story.account.palette[1].name,
								})}
								widths={[360, 540, 720]}
								sizes="(min-width: 62rem) 30vw, (min-width: 40rem) 46vw, 90vw"
								loading="lazy"
								class="story__grid"
							/>

							<div class="story__body">
								<p class="story__where">
									{story.flag && (
										/*
											Emoji flags fall through to a two-letter box on some
											platforms, so the place is never carried by the glyph
											alone — either the account states a market, and it is
											written out beside the flag, or neither renders.
										*/
										<span class="story__flag" aria-hidden="true">
											{story.flag}
										</span>
									)}
									{story.account.place ?? story.account.specialty}
								</p>

								<h3 class="story__name">{story.account.practice}</h3>

								<p class="story__products">
									<span class="story__products-label">{t('customers.using')}</span>
									{story.products.join(' + ')}
								</p>

								{story.testimonial && (
									/*
										Attributed to this practice on the live funnel, so it can
										sit on this practice's card. The <blockquote> carries the
										quotation; the name is already the card's heading, which
										is why there is no attribution line inside it.
									*/
									<blockquote class="story__quote">
										<p>{story.testimonial.quote}</p>
									</blockquote>
								)}

								{story.result && (
									<p class="story__result">
										<span class="story__result-value">{story.result}</span>
										<span class="story__result-label">{t('customers.resultLabel')}</span>
									</p>
								)}

								<p class="story__lang">
									<span class="story__lang-label">{t('customers.languageLabel')}</span>
									<span lang={story.account.languageCode}>{story.account.language}</span>
								</p>
							</div>

							<span class="story__cta">
								{story.account.caseStudy ? t('customers.readStory') : t('customers.allCta')}
								<span aria-hidden="true">→</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<p class="cs__more" data-reveal>
			<a class="btn btn-ghost" href={localizePath('/customers/', locale)}>{t('customers.allCta')}</a>
		</p>
	</div>
</section>

<style>
	.cs__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.cs__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.cs__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	.cs__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
		gap: clamp(1rem, 2.5vw, 1.75rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.story {
		overflow: clip;
	}

	.story__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
	}

	.story__grid {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-block-end: 1px solid var(--color-line);
	}

	.story__body {
		display: grid;
		gap: 0.5rem;
		padding: 1.125rem 1.25rem 0.875rem;
	}

	.story__where {
		display: flex;
		align-items: center;
		gap: 0.4375rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	.story__flag {
		font-size: 1rem;
		line-height: 1;
	}

	.story__name {
		margin: 0;
		font-size: var(--text-lg);
		line-height: 1.3;
	}

	.story__products,
	.story__lang {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4375rem;
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-bone-300);
	}

	.story__products-label,
	.story__lang-label {
		color: var(--color-bone-500);
	}

	/*
		Set in the display face and lit, so it reads as something said rather than
		as another line of description. No quotation marks drawn here — the
		<blockquote> plus the indent rule carry it, and a decorative glyph at this
		size competes with the practice name above.
	*/
	.story__quote {
		margin: 0.25rem 0 0;
		padding-inline-start: 0.875rem;
		border-inline-start: 2px solid color-mix(in oklab, var(--color-arc-400) 50%, transparent);
	}

	.story__quote p {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 500;
		font-style: italic;
		line-height: 1.5;
		color: var(--color-bone-100);
	}

	/*
		The one figure on the card, and only one of the three has it. Boxed rather
		than set in the flow so it cannot be misread as another line of the
		description — this is a measurement, and it says where it was measured.
	*/
	.story__result {
		display: grid;
		gap: 0.1875rem;
		margin: 0.25rem 0 0;
		padding: 0.625rem 0.75rem;
		border-radius: var(--radius-md);
		border: 1px solid color-mix(in oklab, var(--color-arc-400) 32%, transparent);
		background: color-mix(in oklab, var(--color-arc-700) 16%, transparent);
	}

	.story__result-value {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 700;
		color: var(--color-bone-50);
	}

	.story__result-label {
		font-size: var(--text-xs);
		color: var(--color-bone-400);
	}

	.story__cta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-block-start: auto;
		padding: 0.875rem 1.25rem 1.125rem;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-arc-300);
	}

	.story__link:hover .story__cta {
		color: var(--color-arc-200);
	}

	.cs__more {
		display: flex;
		justify-content: center;
		margin: clamp(2rem, 4vw, 3rem) 0 0;
	}
</style>
