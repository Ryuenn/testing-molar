---
/**
 * "Skip the production budget" — the library against commissioning video.
 *
 * The same construction as the agency comparison on /pricing/, and deliberately
 * so: a practice weighing this offer is weighing it against paying a
 * videographer per explainer, and the site should answer that the same way it
 * answers "why not an agency".
 *
 * A real <table> with a <caption>, because this is tabular data. The scroll
 * region is only a scroll region when it has to be one — `tabindex` and `role`
 * make the overflow reachable by keyboard, and below 560px the table collapses
 * into stacked rows instead, because a horizontally scrolled six-row table is
 * technically acceptable and still miserable.
 */
import { EDUCATION_COMPARE, EDUCATION_PRICE } from '~/data/education';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const cap = (k: string) => k.charAt(0).toUpperCase() + k.slice(1);

const ROWS = EDUCATION_COMPARE.map((row) => ({
	...row,
	label: t(`edu.cmp${cap(row.key)}` as 'edu.cmpCost'),
	/* Only the cost row interpolates a price; the rest ignore the variable. */
	library: t(`edu.cmpLib${cap(row.key)}` as 'edu.cmpLibCost', { price: EDUCATION_PRICE }),
	diy: t(`edu.cmpDiy${cap(row.key)}` as 'edu.cmpDiyCost'),
}));
---

<section id="compare" class="section section-rule ec" aria-labelledby="ec-heading">
	<div class="container-content">
		<header class="ec__head">
			<p class="eyebrow" data-reveal="fade">{t('edu.cmpEyebrow')}</p>
			<h2 id="ec-heading" class="ec__title" data-reveal>{t('edu.cmpHeading')}</h2>
			<p class="ec__lede measure-wide" data-reveal>{t('edu.cmpLede')}</p>
		</header>

		<div class="scroll-x ec__wrap" tabindex="0" role="region" aria-labelledby="ec-caption" data-reveal>
			<table class="ec__table">
				<caption id="ec-caption" class="sr-only">{t('edu.cmpCaption')}</caption>
				<thead>
					<tr>
						<th scope="col" class="ec__rowhead">
							<span class="sr-only">{t('edu.cmpCriteria')}</span>
						</th>
						<th scope="col" class="ec__col ec__col--lib">{t('edu.cmpLibrary')}</th>
						<th scope="col" class="ec__col">{t('edu.cmpDiy')}</th>
					</tr>
				</thead>
				<tbody>
					{
						ROWS.map((row) => (
							<tr>
								<th scope="row" class="ec__rowhead">
									{row.label}
								</th>
								{/*
									`data-label` is what the stacked layout below 35rem prints
									in front of each value, once the column headers are gone.
									Carried as data rather than as two hidden spans per cell
									that would exist only for one breakpoint.
								*/}
								<td class="ec__cell ec__cell--lib" data-label={t('edu.cmpLibrary')}>
									{row.library}
								</td>
								<td
									class:list={['ec__cell', row.diyPenalty && 'ec__cell--penalty']}
									data-label={t('edu.cmpDiy')}
								>
									{row.diy}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<style>
	.ec__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.ec__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	.ec__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	.ec__wrap {
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-line);
	}

	.ec__table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-sm);
	}

	.ec__rowhead {
		width: 34%;
		padding: 0.95rem 1.125rem;
		text-align: start;
		font-weight: 500;
		color: var(--color-bone-400);
	}

	.ec__col {
		padding: 0.95rem 1.125rem;
		text-align: start;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	/* The column being argued for. Lit along its whole height, so the eye
	   reads down it rather than across the rows. */
	.ec__col--lib {
		color: var(--color-arc-300);
	}

	.ec__cell {
		padding: 0.95rem 1.125rem;
		color: var(--color-bone-300);
	}

	.ec__cell--lib {
		font-weight: 500;
		color: var(--color-bone-50);
		background: color-mix(in oklab, var(--color-arc-700) 12%, transparent);
	}

	/*
		Tinted only where the value is a genuine cost rather than merely the weaker
		of two options — the same distinction `~/data/comparison` draws. Tinting
		every cell would make the column read as a smear; tinting three makes the
		other three land as fact.
	*/
	.ec__cell--penalty {
		color: var(--color-bone-400);
	}

	.ec__table tbody tr + tr th,
	.ec__table tbody tr + tr td {
		border-block-start: 1px solid var(--color-line);
	}

	.ec__table thead th {
		border-block-end: 1px solid var(--color-line-strong);
	}

	/*
		Below this the three columns cannot hold a readable line, so each row
		becomes its own block: the criterion as a heading, the two values under it
		with their own labels. `::before` carries those labels, which is the one
		place in this file where content lives in CSS — the alternative is two
		hidden spans per cell in the markup that exist only for one breakpoint.
	*/
	@media (max-width: 35rem) {
		.ec__table,
		.ec__table thead,
		.ec__table tbody,
		.ec__table tr,
		.ec__table th,
		.ec__table td {
			display: block;
		}

		.ec__table thead {
			display: none;
		}

		.ec__table tbody tr {
			padding-block: 0.875rem;
		}

		.ec__table tbody tr + tr {
			border-block-start: 1px solid var(--color-line);
		}

		.ec__table tbody tr + tr th,
		.ec__table tbody tr + tr td {
			border-block-start: 0;
		}

		.ec__rowhead {
			width: auto;
			padding-block: 0.25rem;
			font-family: var(--font-mono);
			font-size: var(--text-2xs);
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--color-bone-500);
		}

		.ec__cell {
			padding-block: 0.35rem;
		}

		.ec__cell--lib {
			background: none;
		}

		/* The column this value came from, now that the header row is gone. */
		.ec__cell::before {
			content: attr(data-label) ': ';
			font-family: var(--font-mono);
			font-size: var(--text-2xs);
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--color-bone-500);
		}

		.ec__cell--lib::before {
			color: var(--color-arc-300);
		}
	}
</style>
