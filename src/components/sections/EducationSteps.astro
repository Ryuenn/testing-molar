---
/**
 * "Live in your practice today" — the four steps from the live /educate funnel.
 *
 * A rail, the same construction the hero once used and /how-it-works/ still
 * does: numbered nodes with a segment threading through them, the last one lit.
 * Four cards in a row would say "here are four features"; the order is the
 * entire content of this section, and a rail is what says so.
 *
 * The segment is drawn per station rather than as one line behind the row. A
 * single background line runs under the nodes and shows through the gaps
 * between them at every breakpoint; a segment owned by each station starts and
 * stops exactly where its own node does, and the last station simply has none.
 */
import Glyph from '~/components/ui/Glyph.astro';
import { EDUCATION_STEPS, EDUCATION_TRIAL_DAYS } from '~/data/education';
import type { GlyphName } from '~/data/glyphs';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const cap = (k: string) => k.charAt(0).toUpperCase() + k.slice(1);

const ICONS: Record<(typeof EDUCATION_STEPS)[number], GlyphName> = {
	start: 'check',
	search: 'search',
	play: 'play',
	grow: 'spark',
};

const STEPS = EDUCATION_STEPS.map((key) => ({
	icon: ICONS[key],
	title: t(`edu.step${cap(key)}` as 'edu.stepStart'),
	/* Only the first step interpolates anything; the rest ignore the variable,
	   which `useTranslations` allows — an unused var is not an error. */
	sub: t(`edu.step${cap(key)}Sub` as 'edu.stepStartSub', { n: EDUCATION_TRIAL_DAYS }),
}));
---

<section id="how" class="section section-rule st" aria-labelledby="st-heading">
	<div class="container-content">
		<header class="st__head">
			<p class="eyebrow" data-reveal="fade">{t('edu.stepsEyebrow')}</p>
			<h2 id="st-heading" class="st__title" data-reveal>{t('edu.stepsHeading')}</h2>
		</header>

		{/* The digits are the list's own numbering rendered for the eye and
		    hidden from assistive tech, which would announce the position twice. */}
		<ol class="st__rail" data-reveal-stagger>
			{
				STEPS.map((step, i) => (
					<li
						class:list={['step', i === STEPS.length - 1 && 'step--live']}
						data-reveal
						data-reveal-group
					>
						{i < STEPS.length - 1 && <span class="step__link" aria-hidden="true" />}

						<span class="step__node">
							<span class="step__icon" aria-hidden="true">
								<Glyph name={step.icon} />
							</span>
							<span class="step__num" aria-hidden="true">
								{String(i + 1).padStart(2, '0')}
							</span>
						</span>

						<div class="step__body">
							<h3 class="step__title">{step.title}</h3>
							<p class="step__sub">{step.sub}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.st__head {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.st__title {
		margin: 0;
		font-size: var(--text-3xl);
	}

	/* The two numbers every offset below is written in terms of, so the segments
	   cannot drift out of line with the nodes they connect. */
	.st__rail {
		--node: 3rem;
		--gap: clamp(1.25rem, 3vw, 2rem);

		display: grid;
		gap: var(--gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.step {
		position: relative;
		display: grid;
		grid-template-columns: var(--node) minmax(0, 1fr);
		gap: 0 1.125rem;
	}

	.step__node {
		position: relative;
		/* Over the segment, which runs behind it. */
		z-index: 1;
		display: grid;
		place-items: center;
		width: var(--node);
		height: var(--node);
		border-radius: 50%;
		border: 1px solid var(--color-line-strong);
		background: color-mix(in oklab, var(--color-ink-900) 90%, transparent);
	}

	.step__icon {
		width: 1.25rem;
		height: 1.25rem;
		color: var(--color-arc-200);
	}

	.step__num {
		position: absolute;
		inset-block-start: -0.4rem;
		inset-inline-start: -0.4rem;
		display: grid;
		place-items: center;
		min-width: 1.3rem;
		height: 1.3rem;
		padding-inline: 0.28rem;
		border-radius: 999px;
		border: 1px solid var(--color-line-strong);
		background: var(--color-ink-950);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		line-height: 1;
		color: var(--color-bone-500);
	}

	/* Down to the next node: this station's own height past the node, plus the
	   gap below it. */
	.step__link {
		position: absolute;
		inset-block-start: var(--node);
		inset-inline-start: calc(var(--node) / 2);
		width: 1px;
		height: calc(100% - var(--node) + var(--gap));
		background: linear-gradient(
			180deg,
			var(--color-line-strong),
			color-mix(in oklab, var(--color-arc-500) 30%, transparent)
		);
	}

	.step__body {
		display: grid;
		gap: 0.25rem;
		padding-block: 0.35rem 0.5rem;
	}

	.step__title {
		margin: 0;
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.3;
	}

	.step__sub {
		margin: 0;
		max-width: 42ch;
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-bone-400);
	}

	/* Arrival. Same accent and halo the journey rail and /results/ use — the
	   light means one thing across this site. */
	.step--live .step__node {
		border-color: color-mix(in oklab, var(--color-arc-400) 55%, transparent);
		background: color-mix(in oklab, var(--color-arc-600) 16%, transparent);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #dbeaff 22%, transparent),
			0 0 30px -6px color-mix(in oklab, var(--color-arc-400) 75%, transparent);
	}

	.step--live .step__num {
		border-color: color-mix(in oklab, var(--color-arc-400) 45%, transparent);
		color: var(--color-arc-300);
	}

	/*
		Wide: the rail lies flat. Four subgrid rows keep the titles and the copy
		aligned across the columns when one title wraps and the others do not —
		see the same construction in PatientJourney, and the same fallback: where
		subgrid is unsupported the declaration is dropped and the row is merely
		ragged.
	*/
	@media (min-width: 60rem) {
		.st__rail {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			grid-template-rows: auto auto auto;
			gap: 0.5rem var(--gap);
		}

		.step {
			grid-row: span 3;
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: subgrid;
			gap: 0;
		}

		.step__body {
			display: contents;
		}

		.step__node {
			margin-block-end: 0.375rem;
		}

		.step__link {
			inset-block-start: calc(var(--node) / 2);
			inset-inline-start: var(--node);
			width: calc(100% + var(--gap) - var(--node));
			height: 1px;
			background: linear-gradient(
				90deg,
				var(--color-line-strong),
				color-mix(in oklab, var(--color-arc-500) 30%, transparent)
			);
		}
	}
</style>
