---
import {
	PLANS,
	isCheckout,
} from '~/data/pricing';
import { PROMO } from '~/data/site';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

export interface Props {
	/**
	 * Render the eyebrow, headline and lede. Off where the page already carries
	 * them — /pricing/ puts the same line in its <h1> and would otherwise say it
	 * twice.
	 */
	head?: boolean;
}

const { head = true } = Astro.props;

/**
 * The plans. Three glass panes over a field of arc light, the middle one lit.
 *
 * Every button here leaves the site — two into Stripe Checkout, one into a
 * booking calendar — so each carries `rel="noopener"` and says where it goes.
 * They are `<a>`, not buttons in a form: nothing is submitted from this page,
 * and `form-action 'self'` in the CSP would block it if it were.
 */
---

<section
	id="plans"
	class:list={['plans', !head && 'plans--bare']}
	aria-labelledby={head ? 'plans-heading' : undefined}
	aria-label={head ? undefined : 'Plans and pricing'}
>
	{/*
		Glass needs something behind it or it is a translucent grey box. Three
		wide arc blooms, low enough to read as light in the room, which the cards
		then blur and saturate.
	*/}
	<div class="plans__aurora" aria-hidden="true"></div>
	<div class="grain" aria-hidden="true"></div>

	<div class="container-content plans__inner">
		{
			head && (
				<header class="plans__head">
					<p class="eyebrow" data-reveal="fade">
						Plans
					</p>
					<h2 id="plans-heading" class="plans__title" data-reveal>
						{t('pricing.headline')}
					</h2>
					<p class="plans__lede" data-reveal>
						{t('pricing.lede')}
					</p>
				</header>
			)
		}

		<ul class="plans__grid" data-reveal-stagger>
			{
				PLANS.map((plan) => (
					<li
						class:list={['plan', plan.featured && 'plan--featured']}
						data-reveal
						data-reveal-group
					>
						{plan.badge && <p class="plan__badge">{t('pricing.badge')}</p>}

						<h3 class="plan__name">{t(`pricing.${plan.key}Name` as never)}</h3>

						<p class="plan__price">
							<span class="plan__amount">{plan.price || t('pricing.custom')}</span>
							{plan.perMonth && <span class="plan__cadence">{t('pricing.perMonth')}</span>}
						</p>

						{/*
							The promo rides the plan it belongs to rather than the section, so
							blanking `PROMO.code` in site.ts removes it from the one card that
							shows it and nothing else moves.
						*/}
						{plan.id === PROMO.tier && PROMO.code && (
							<p class="plan__promo">
								<span>
									{PROMO.discount} {PROMO.appliesTo}
								</span>
								<span class="plan__code">
									Code <b>{PROMO.code}</b>
								</span>
							</p>
						)}

						<p class="plan__summary">{t(`pricing.${plan.key}Summary` as never)}</p>
						<p class="plan__blurb">{t(`pricing.${plan.key}Blurb` as never)}</p>

						<ul class="plan__features">
							{Array.from({ length: plan.featureCount }, (_, i) => t(`pricing.${plan.featureKey}${i + 1}` as never)).map((feature) => (
								<li class="plan__feature">
									<svg
										class="tick plan__tick"
										viewBox="0 0 16 16"
										fill="none"
										aria-hidden="true"
									>
										<path
											d="m3.5 8.5 3 3 6-7"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									{feature}
								</li>
							))}
						</ul>

						<a
							class:list={['plan__cta', plan.featured && 'plan__cta--featured']}
							href={plan.cta.href}
							rel="noopener"
						>
							{t(`pricing.${plan.key}Cta` as never)}
							{/* Says where the button goes without putting it in the label
							    twice for people who can see the button. */}
							<span class="sr-only">
								{isCheckout(plan) ? ' — opens Stripe Checkout' : ' — opens a booking calendar'}
							</span>
							<span class="plan__cta-arrow" aria-hidden="true">
								&rarr;
							</span>
						</a>

						<p class="plan__note">{t(`pricing.${plan.key}Note` as never)}</p>
					</li>
				))
			}
		</ul>

		<p class="plans__foot" data-reveal="fade">{t('pricing.footnote')}</p>
	</div>
</section>

<style>
	.plans {
		position: relative;
		isolation: isolate;
		overflow: clip;
		padding-block: clamp(2.5rem, 4.5vw, 4rem) clamp(3rem, 5vw, 4.5rem);
		background: var(--color-ink-950);
	}

	.plans__aurora {
		position: absolute;
		inset: -15% 0;
		z-index: -1;
		background:
			radial-gradient(
				38% 46% at 14% 18%,
				color-mix(in oklab, var(--color-arc-600) 28%, transparent),
				transparent 72%
			),
			radial-gradient(
				42% 40% at 50% 4%,
				color-mix(in oklab, var(--color-arc-500) 20%, transparent),
				transparent 74%
			),
			radial-gradient(
				56% 44% at 86% 88%,
				color-mix(in oklab, var(--color-arc-700) 34%, transparent),
				transparent 72%
			);
		filter: blur(26px);
	}

	/*
		Headless variant: the page supplies the heading, so this band starts at the
		cards.

		It used to take a 1.25rem top pad on the reasoning that the page heading had
		already set the rhythm. That was wrong in practice — this section paints its
		own ground and aurora, so there is a visible edge above the cards, and 20px
		of clearance under it against 48–72px below left the row sitting hard
		against the seam. Matching the bottom is what makes the band read as
		deliberate rather than as content that overflowed into place.

		It also has to stay generous enough for the featured card's badge, which
		overhangs the top edge and would otherwise be cut by `overflow: clip`.
	*/
	.plans--bare {
		padding-block-start: clamp(3rem, 5vw, 4.5rem);
	}

	.plans__inner {
		position: relative;
	}

	.plans__head {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
		text-align: center;
	}

	.plans__title {
		margin: 0;
		max-width: 18ch;
		font-size: var(--text-4xl);
		line-height: 1.06;
		letter-spacing: -0.018em;
	}

	.plans__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	/*
		Three across once there is room for them, one column below. Nothing in
		between: at two across the third card is orphaned on its own row, and the
		featured one stops being the middle of anything.
	*/
	.plans__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(0.875rem, 1.5vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
		/* Stretch, not start: the cards are equal height and `flex: 1` on the
		   feature list pushes all three buttons onto the same baseline however
		   uneven the lists above them are. */
		align-items: stretch;
	}

	@media (min-width: 62rem) {
		.plans__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	/*
		The glass, worn by all three so they read as one material:

		  ground   only enough ink to hold the copy over whatever light is
		           behind it — the blur does most of that work
		  sheen    a wash of cool grey, which is what makes a pane read as glass
		           rather than as tinted navy. Ink alone only ever goes darker
		  edge     the lit top edge, at the threshold of visible
	*/
	.plan {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: clamp(1.5rem, 2.4vw, 2rem);
		border: 1px solid var(--color-line);
		border-radius: clamp(0.875rem, 1.1vw, 1.125rem);
		background-color: color-mix(in oklab, var(--color-ink-950) 46%, transparent);
		background-image: linear-gradient(
			180deg,
			color-mix(in oklab, #a3adbd 13%, transparent) 0%,
			color-mix(in oklab, #a3adbd 4%, transparent) 100%
		);
		backdrop-filter: blur(22px) saturate(140%);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #e6ecf5 10%, transparent),
			0 30px 60px -40px #000;
	}

	/* Without a backdrop to sample, translucency reads as washed out rather than
	   as glass. Give those engines a solid pane instead. */
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.plan {
			background-color: color-mix(in oklab, var(--color-ink-800) 92%, transparent);
		}
	}

	/*
		The one the eye should land on. Lit rather than enlarged — scaling the
		middle card breaks the shared baseline the three prices sit on, and at one
		column it would just be the odd one out.
	*/
	.plan--featured {
		border-color: color-mix(in oklab, var(--color-arc-400) 46%, transparent);
		background-image:
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-arc-400) 12%, transparent) 0%,
				transparent 42%
			),
			linear-gradient(
				180deg,
				color-mix(in oklab, #a3adbd 14%, transparent) 0%,
				color-mix(in oklab, #a3adbd 4%, transparent) 100%
			);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #cfe4ff 20%, transparent),
			0 40px 90px -46px color-mix(in oklab, var(--color-arc-600) 85%, transparent);
	}

	/*
		A light running the perimeter of the featured card.

		Drawn as a ring rather than an animated border, because `border-image`
		cannot take a conic gradient and animating four border colours in sequence
		reads as a blink, not as travel. The technique: lay a full conic gradient
		over the card, then mask out everything except a 1px band at its edge.

		  padding: 1px          defines the band — the gap between border-box and
		                        content-box is exactly what survives the mask
		  mask ×2 + exclude     border-box minus content-box, i.e. the ring
		  --trail-angle         rotates the gradient's origin; the comet is the
		                        last few degrees of the sweep, so it reads as a
		                        head with a tail fading out behind it

		It sits ABOVE the content (`z-index: 2`) rather than behind it, which is
		safe because the mask leaves the middle fully transparent — it cannot
		obscure anything — and because a ring painted underneath would be hidden by
		the card's own translucent background. The badge is lifted past it.
	*/
	.plan--featured::after {
		content: '';
		position: absolute;
		z-index: 2;
		/* Out to the border ring itself, so the light travels along the card's
		   edge rather than just inside it. */
		inset: -1px;
		border-radius: inherit;
		padding: 1px;
		background: conic-gradient(
			from var(--trail-angle),
			transparent 0turn,
			transparent 0.55turn,
			color-mix(in oklab, var(--color-arc-500) 45%, transparent) 0.82turn,
			color-mix(in oklab, var(--color-arc-300) 90%, transparent) 0.955turn,
			#eaf3ff 1turn
		);
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		/*
			Slow. At anything under about three seconds a light circling a card stops
			reading as a highlight and starts reading as a loading state.
		*/
		animation: plan-trail 5s linear infinite;
		pointer-events: none;
	}

	@keyframes plan-trail {
		to {
			--trail-angle: 360deg;
		}
	}

	/*
		The global reduced-motion rule collapses every animation to 0.001ms, which
		would leave the comet frozen at one corner looking like a rendering fault.
		Drop the ring entirely instead — the card is already marked by its lit
		border, its glow and its badge, none of which move.
	*/
	@media (prefers-reduced-motion: reduce) {
		.plan--featured::after {
			display: none;
		}
	}

	.plan__badge {
		position: absolute;
		/* Above the travelling ring, which crosses the top border it straddles. */
		z-index: 3;
		inset-block-start: 0;
		inset-inline-start: 50%;
		transform: translate(-50%, -50%);
		margin: 0;
		padding: 0.3rem 0.7rem;
		border: 1px solid color-mix(in oklab, var(--color-arc-300) 45%, transparent);
		border-radius: 99px;
		background: color-mix(in oklab, var(--color-arc-600) 72%, transparent);
		backdrop-filter: blur(10px);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--color-bone-50);
	}

	.plan__name {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.plan__price {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		margin: 0.75rem 0 0;
	}

	.plan__amount {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 3.4vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--color-bone-50);
		font-variant-numeric: tabular-nums;
	}

	.plan__cadence {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-bone-400);
	}

	.plan__promo {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.6rem;
		margin: 0.85rem 0 0;
		padding: 0.5rem 0.75rem;
		border: 1px dashed color-mix(in oklab, var(--color-arc-300) 42%, transparent);
		border-radius: 0.625rem;
		background: color-mix(in oklab, var(--color-arc-700) 26%, transparent);
		font-size: var(--text-sm);
		color: var(--color-bone-100);
	}

	.plan__code {
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-arc-200);
	}

	.plan__code b {
		font-weight: 500;
		color: var(--color-bone-50);
	}

	.plan__summary {
		margin: 1.1rem 0 0;
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--color-bone-50);
	}

	.plan__blurb {
		margin: 0.35rem 0 0;
		font-size: var(--text-sm);
		color: var(--color-bone-400);
	}

	.plan__features {
		display: grid;
		gap: 0.55rem;
		/* Pushes the button to the bottom, so the three buttons line up across the
		   row however uneven the feature lists are. */
		margin: 1.35rem 0 1.5rem;
		padding: 1.35rem 0 0;
		border-block-start: 1px solid var(--color-line);
		list-style: none;
		flex: 1;
	}

	.plan__feature {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.6rem;
		align-items: start;
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--color-bone-300);
	}

	.plan__tick {
		width: 1rem;
		height: 1rem;
		/* Optical alignment with the cap height of the line beside it, not its
		   box. */
		margin-block-start: 0.2em;
	}

	.plan__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		min-height: 3rem;
		padding-inline: 1.25rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 0.75rem;
		background-color: color-mix(in oklab, var(--color-bone-50) 8%, transparent);
		backdrop-filter: blur(10px);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1;
		text-align: center;
		text-decoration: none;
		color: var(--color-bone-50);
		transition:
			background-color 0.28s var(--ease-out-quint),
			border-color 0.28s var(--ease-out-quint),
			transform 0.28s var(--ease-out-quint),
			box-shadow 0.28s var(--ease-out-quint);
	}

	.plan__cta:hover {
		background-color: color-mix(in oklab, var(--color-bone-50) 14%, transparent);
		border-color: color-mix(in oklab, var(--color-arc-300) 50%, transparent);
		transform: translateY(-2px);
	}

	.plan__cta--featured {
		border-color: transparent;
		background-color: var(--color-bone-50);
		color: var(--color-ink-950);
		box-shadow: 0 18px 44px -18px color-mix(in oklab, var(--color-arc-400) 80%, transparent);
	}

	.plan__cta--featured:hover {
		background-color: #fff;
		border-color: transparent;
		box-shadow: 0 22px 56px -18px color-mix(in oklab, var(--color-arc-400) 100%, transparent);
	}

	.plan__cta-arrow {
		transition: transform 0.28s var(--ease-out-quint);
	}

	.plan__cta:hover .plan__cta-arrow {
		transform: translateX(3px);
	}

	.plan__note {
		/* Two lines' worth, whether it needs them or not, so a note that wraps
		   does not push its button off the line the other two share. */
		min-height: 2lh;
		margin: 0.85rem 0 0;
		font-size: var(--text-2xs);
		line-height: 1.5;
		text-align: center;
		color: var(--color-bone-500);
	}

	.plans__foot {
		margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-align: center;
		color: var(--color-bone-500);
	}
</style>
