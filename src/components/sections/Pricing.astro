---
import {
	PLANS,
	isCheckout,
} from '~/data/pricing';
import { PROMO, EDUCATION_CHECKOUT } from '~/data/site';
import {
	EDUCATION_PRICE,
	EDUCATION_PRICE_ANNUAL,
	EDUCATION_ANNUAL_MONTHLY,
	EDUCATION_ANNUAL_SAVING,
} from '~/data/education';
import { getLocale, useTranslations } from '~/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

export interface Props {
	/**
	 * Render the eyebrow, headline and lede. Off where the page already carries
	 * them — /pricing/ puts the same line in its <h1> and would otherwise say it
	 * twice.
	 */
	head?: boolean;
}

const { head = true } = Astro.props;

/**
 * The plans. Four panes over a field of arc light, the third one lit.
 *
 * Every button here leaves the site — two into Stripe Checkout, two into a
 * booking calendar — so each carries `rel="noopener"` and says where it goes.
 * They are `<a>`, not buttons in a form: nothing is submitted from this page,
 * and `form-action 'self'` in the CSP would block it if it were.
 *
 * All of them also open in a new tab. Every one of these is a decision point a
 * visitor may back out of — a checkout they abandon, a calendar with no slot
 * that suits — and navigating away in place means coming back to the top of a
 * page they had read most of the way down, having lost the annual toggle's
 * state with it. The plan grid stays where they left it.
 *
 * `target="_blank"` is why `rel="noopener"` matters rather than merely being
 * tidy: without it the opened tab gets a live `window.opener` handle back to
 * this page. Never add one of these without the other.
 *
 * ── The annual toggle ──────────────────────────────────────────────────────
 * MOLAR TV is sold monthly or annually and the card carries a two-state switch
 * between them. It is progressive enhancement: the card renders with the
 * monthly price already chosen, and the script below only swaps which of two
 * server-rendered states is hidden. No JS leaves a working monthly card.
 *
 * ⚠️ THERE IS STILL NO ANNUAL PAYMENT LINK. `EDUCATION_CHECKOUT` in
 * `~/data/site` is the monthly subscription and nothing in this repo can take
 * $849 for a year — the annual state's button used to book a call instead of
 * risking that wrong charge, which is the correct default for this problem.
 *
 * By request, it now points at the monthly checkout instead, as a stopgap
 * until the real annual link is connected: a visitor who presses it gets
 * MOLAR TV, billed monthly with the 14-day trial, rather than a booking
 * calendar. The annual PRICE and savings copy on the card are unchanged, so
 * the card still shows $849/yr while the button underneath quietly opens a
 * $97/mo checkout — worth reconciling once the annual link exists. The moment
 * it does, put it in `~/data/education`, point `href` below at it, and swap
 * the button back to `pricing.annualCta` (still defined, unused for now).
 */
const annual = {
	price: EDUCATION_PRICE_ANNUAL,
	perMonth: EDUCATION_ANNUAL_MONTHLY,
	saving: EDUCATION_ANNUAL_SAVING,
	href: EDUCATION_CHECKOUT,
};
---

<section
	id="plans"
	class:list={['plans', !head && 'plans--bare']}
	aria-labelledby={head ? 'plans-heading' : undefined}
	aria-label={head ? undefined : 'Plans and pricing'}
>
	<div class="container-content plans__inner">
		{
			head && (
				<header class="plans__head">
					<p class="eyebrow" data-reveal="fade">
						Plans
					</p>
					<h2 id="plans-heading" class="plans__title" data-reveal>
						{t('pricing.headline')}
					</h2>
					<p class="plans__lede" data-reveal>
						{t('pricing.lede')}
					</p>
				</header>
			)
		}

		<ul class="plans__grid" data-reveal-stagger>
			{
				PLANS.map((plan) => (
					<li
						class:list={['plan', plan.featured && 'plan--featured']}
						data-reveal
						data-reveal-group
					>
						{plan.badge && (
							<p class:list={['plan__badge', `plan__badge--${plan.badge}`]}>
								{t(plan.badge === 'popular' ? 'pricing.badge' : 'pricing.badgeTrial')}
							</p>
						)}

						<h3 class="plan__name">{t(`pricing.${plan.key}Name` as never)}</h3>

						{plan.id === 'education' ? (
							/*
								Two prices, both rendered, one hidden. `[hidden]` rather than a
								class, so the hidden half is out of the accessibility tree as
								well as off the screen — a screen reader must never read two
								prices for one plan.
							*/
							<div class="plan__billing" data-billing>
								<p class="plan__price" data-billing-pane="monthly">
									<span class="plan__amount">{EDUCATION_PRICE}</span>
									<span class="plan__cadence">{t('pricing.perMonth')}</span>
								</p>

								<p class="plan__price" data-billing-pane="annual" hidden>
									<span class="plan__amount">{annual.price}</span>
									<span class="plan__cadence">{t('pricing.perYear')}</span>
								</p>

								{/*
									A radio group, not two buttons: this is one choice with two
									options, and a real pair of <input type="radio"> gives the
									arrow-key behaviour and the "1 of 2" announcement without a
									keyboard handler of our own.
								*/}
								<div class="switch" role="radiogroup" aria-label={t('pricing.billingLabel')}>
									<label class="switch__opt">
										<input
											type="radio"
											name="molar-tv-billing"
											value="monthly"
											checked
											data-billing-input
										/>
										<span>{t('pricing.monthly')}</span>
									</label>
									<label class="switch__opt">
										<input
											type="radio"
											name="molar-tv-billing"
											value="annual"
											data-billing-input
										/>
										<span>{t('pricing.annual')}</span>
									</label>
								</div>

								<p class="plan__saving" data-billing-pane="annual" hidden>
									{t('pricing.annualSaving', {
										monthly: annual.perMonth,
										saving: annual.saving,
									})}
								</p>
							</div>
						) : (
							<p class="plan__price">
								<span class="plan__amount">{plan.price || t('pricing.custom')}</span>
								{plan.perMonth && <span class="plan__cadence">{t('pricing.perMonth')}</span>}
							</p>
						)}

						{/*
							The promo rides the plan it belongs to rather than the section, so
							blanking `PROMO.code` in site.ts removes it from the one card that
							shows it and nothing else moves.
						*/}
						{plan.id === PROMO.tier && PROMO.code && (
							<p class="plan__promo">
								<span>
									{PROMO.discount} {PROMO.appliesTo}
								</span>
								<span class="plan__code">
									Code <b>{PROMO.code}</b>
								</span>
							</p>
						)}

						<p class="plan__summary">{t(`pricing.${plan.key}Summary` as never)}</p>
						<p class="plan__blurb">{t(`pricing.${plan.key}Blurb` as never)}</p>

						<ul class="plan__features">
							{Array.from({ length: plan.featureCount }, (_, i) => t(`pricing.${plan.featureKey}${i + 1}` as never)).map((feature) => (
								<li class="plan__feature">
									<svg
										class="tick plan__tick"
										viewBox="0 0 16 16"
										fill="none"
										aria-hidden="true"
									>
										<path
											d="m3.5 8.5 3 3 6-7"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									{feature}
								</li>
							))}
						</ul>

						{plan.id === 'education' ? (
							<>
								<a
									class="plan__cta"
									href={plan.cta.href}
									target="_blank"
									rel="noopener"
									data-billing-pane="monthly"
								>
									{t('pricing.educationCta')}
									<span class="sr-only"> — opens Stripe Checkout {t('footer.newTab')}</span>
									<span class="plan__cta-arrow" aria-hidden="true">
										&rarr;
									</span>
								</a>

								{/*
									Same destination as the monthly button above, for now — see
									the ⚠️ in the frontmatter for why, and what changes once the
									annual Payment Link exists. The label matches it too, rather
									than promising a call this does not book.
								*/}
								<a
									class="plan__cta"
									href={annual.href}
									target="_blank"
									rel="noopener"
									data-billing-pane="annual"
									hidden
								>
									{t('pricing.educationCta')}
									<span class="sr-only"> — opens Stripe Checkout {t('footer.newTab')}</span>
									<span class="plan__cta-arrow" aria-hidden="true">
										&rarr;
									</span>
								</a>
							</>
						) : (
							<a
								class:list={['plan__cta', plan.featured && 'plan__cta--featured']}
								href={plan.cta.href}
								target="_blank"
								rel="noopener"
							>
								{t(`pricing.${plan.key}Cta` as never)}
								{/* Says where the button goes without putting it in the label
								    twice for people who can see the button. */}
								<span class="sr-only">
									{isCheckout(plan) ? ' — opens Stripe Checkout' : ' — opens a booking calendar'}{' '}
									{t('footer.newTab')}
								</span>
								<span class="plan__cta-arrow" aria-hidden="true">
									&rarr;
								</span>
							</a>
						)}

						{plan.id === 'education' ? (
							<>
								<p class="plan__note" data-billing-pane="monthly">
									{t('pricing.educationNote')}
								</p>
								{/*
									The annual half of the note, and it says the two things that
									are true and unwelcome: billed in full today, and no free
									trial. Burying either would be the kind of surprise that
									produces a chargeback rather than a customer.
								*/}
								<p class="plan__note" data-billing-pane="annual" hidden>
									{t('pricing.annualNote')}
								</p>
							</>
						) : (
							<p class="plan__note">{t(`pricing.${plan.key}Note` as never)}</p>
						)}
					</li>
				))
			}
		</ul>

		{/*
			One line across both social cards, per the brief. Under the grid rather
			than repeated inside Lite and Premium: it is the same sentence about the
			same product sold at two volumes, and printing it twice on adjacent
			cards reads as filler.
		*/}
		<p class="plans__social-note" data-reveal="fade">{t('pricing.socialNote')}</p>

		<p class="plans__foot" data-reveal="fade">{t('pricing.footnote')}</p>
	</div>
</section>

<script>
	/*
		The MOLAR TV billing switch.

		Both states are server-rendered and one is `hidden`; this only moves which.
		That is why the card works with no JS at all — it renders showing the
		monthly price, which is the offer the page advertises everywhere else.

		Scoped to each `[data-billing]` rather than to the document: `Pricing` runs
		on the home page, /pricing/ and /social-media/, and while only one instance
		is on any given page, a global querySelectorAll would silently couple two
		if that ever changed.
	*/
	for (const group of document.querySelectorAll<HTMLElement>('[data-billing]')) {
		const inputs = group.querySelectorAll<HTMLInputElement>('[data-billing-input]');
		if (!inputs.length) continue;

		/*
			The panes are not all inside `[data-billing]` — the note pair sits at the
			foot of the card, past the feature list — so they are collected from the
			card the switch belongs to.
		*/
		const card = group.closest('.plan') ?? group;
		const panes = card.querySelectorAll<HTMLElement>('[data-billing-pane]');

		const show = (mode: string) => {
			for (const pane of panes) pane.hidden = pane.dataset.billingPane !== mode;
		};

		for (const input of inputs) {
			input.addEventListener('change', () => {
				if (input.checked) show(input.value);
			});
		}

		/* A browser restoring a checked radio on reload (bfcache, or a back
		   navigation) would otherwise leave the switch and the price disagreeing. */
		const checked = [...inputs].find((input) => input.checked);
		if (checked) show(checked.value);
	}
</script>

<style>
	/*
		No ground of its own — see `PlansField`, which every caller renders on the
		band around this grid.

		It used to paint a still here, stretched `100% 100%` to the section, with a
		`--plans-ground` custom property so an ancestor painting the same picture
		could switch this copy off. Both are gone: the field is a video now, a video
		cannot be a CSS background, and the element that carries it belongs on the
		band that spans the heading and this grid together rather than on the grid
		alone. Nothing here is transparent-by-accident as a result — the band
		underneath paints ink, and this section simply lets it through.
	*/
	.plans {
		position: relative;
		isolation: isolate;
		overflow: clip;
		padding-block: clamp(2.5rem, 4.5vw, 4rem) clamp(3rem, 5vw, 4.5rem);
	}

	/*
		Headless variant: the page supplies the heading, so this band starts at the
		cards.

		It used to take a 1.25rem top pad on the reasoning that the page heading had
		already set the rhythm. That was wrong in practice — this section paints its
		own ground, so there is a visible edge above the cards, and 20px of
		clearance under it against 48–72px below left the row sitting hard
		against the seam. Matching the bottom is what makes the band read as
		deliberate rather than as content that overflowed into place.

		It also has to stay generous enough for the featured card's badge, which
		overhangs the top edge and would otherwise be cut by `overflow: clip`.
	*/
	.plans--bare {
		padding-block-start: clamp(3rem, 5vw, 4.5rem);
	}

	.plans__inner {
		position: relative;
	}

	/*
		Wider than the page's own measure, but only where there are four cards.

		`--container-content` is 76rem, which is the right width for a column of
		prose and the wrong one for four plans side by side: minus the gaps and each
		card's own padding it leaves about 215px of text per card, and at that width
		"Search by treatment or by the question a patient asks" takes four lines. The
		cards then grow tall and thin and the section runs on for a screen and a
		half.

		At 88rem each card gets nearer 300px, most of those lines pull back to two,
		and the row loses a third of its height without a single font size changing.

		It has to go on `.plans__inner` rather than on the grid: the grid is inside
		it, and a child cannot be wider than a parent that caps it. The heading and
		footnote widen with it, which is harmless — the title carries its own `18ch`
		measure and both are centred.
	*/
	@media (min-width: 72rem) {
		.plans__inner {
			max-width: 88rem;
		}
	}

	.plans__head {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
		text-align: center;
	}

	.plans__title {
		margin: 0;
		max-width: 18ch;
		font-size: var(--text-4xl);
		line-height: 1.06;
		letter-spacing: -0.018em;
	}

	.plans__lede {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--color-bone-300);
	}

	/*
		Four across at the top, two in the middle, one below.

		Two is allowed now in a way it was not with three cards: four splits into
		an even 2×2 with nothing orphaned, and the ladder still reads across then
		down. The old rule — no intermediate step — was about three cards leaving
		one alone on its own row, which four does not do.
	*/
	.plans__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(0.875rem, 1.5vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
		/* Stretch, not start: the cards are equal height and `flex: 1` on the
		   feature list pushes all four buttons onto the same baseline however
		   uneven the lists above them are. */
		align-items: stretch;
	}

	@media (min-width: 46rem) {
		.plans__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 72rem) {
		.plans__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	/*
		The pane, worn by all three so they read as one material.

		Flat ink, and deliberately so. These were glass — `backdrop-filter:
		blur(22px) saturate(140%)`, with more of it on the badge and on all three
		buttons — which meant seven layers each re-reading and re-blurring the
		backdrop behind them on every frame the page scrolled. That is what made
		the section drag. A near-opaque fill over the picture costs one composite
		and reads much the same at this value.

		Left a few points short of solid so the ground still shows through: enough
		that the cards sit IN the field rather than on top of it, not enough for
		the lattice to interfere with the copy.
	*/
	.plan {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: clamp(1.5rem, 2.4vw, 2rem);
		border: 1px solid var(--color-line);
		border-radius: clamp(0.875rem, 1.1vw, 1.125rem);
		background-color: color-mix(in oklab, var(--color-ink-950) 88%, transparent);
		box-shadow: 0 30px 60px -40px #000;
	}

	/*
		The one the eye should land on. Lit rather than enlarged — scaling the
		middle card breaks the shared baseline the three prices sit on, and at one
		column it would just be the odd one out.

		It also carries a comet travelling its perimeter — see below.
	*/
	.plan--featured {
		border-color: color-mix(in oklab, var(--color-arc-400) 55%, transparent);
		background-color: color-mix(in oklab, var(--color-ink-900) 86%, transparent);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #cfe4ff 20%, transparent),
			0 40px 90px -46px color-mix(in oklab, var(--color-arc-600) 85%, transparent);
	}

	/*
		A light running the perimeter of the featured card.

		Drawn as a ring rather than an animated border, because `border-image`
		cannot take a conic gradient and animating four border colours in sequence
		reads as a blink, not as travel. The technique: lay a full conic gradient
		over the card, then mask out everything except a 1px band at its edge.

		  padding: 1px          defines the band — the gap between border-box and
		                        content-box is exactly what survives the mask
		  mask ×2 + exclude     border-box minus content-box, i.e. the ring
		  --trail-angle         rotates the gradient's origin; the comet is the
		                        last few degrees of the sweep, so it reads as a
		                        head with a tail fading out behind it

		It sits ABOVE the content (`z-index: 2`) rather than behind it, which is
		safe because the mask leaves the middle fully transparent — it cannot
		obscure anything — and because a ring painted underneath would be hidden by
		the card's own translucent background. The badge is lifted past it.

		A conic gradient cannot be composited, so this repaints every frame it
		runs, and `contain: paint` is what holds that cost down — it fences the
		invalidation to this element's box rather than letting it walk up into the
		card.

		What actually makes it affordable, though, is what is NOT underneath it any
		more. The cards used to be glass, and a repaint here forced every
		`backdrop-filter` in the section to re-sample its backdrop; the ring was
		paying for six other elements as well as itself. They are flat ink now, so
		this repaints one 1px band and nothing else.
	*/
	.plan--featured::after {
		content: '';
		position: absolute;
		z-index: 2;
		/* Out to the border ring itself, so the light travels along the card's
		   edge rather than just inside it. */
		inset: -1px;
		border-radius: inherit;
		padding: 1px;
		background: conic-gradient(
			from var(--trail-angle),
			transparent 0turn,
			transparent 0.55turn,
			color-mix(in oklab, var(--color-arc-500) 45%, transparent) 0.82turn,
			color-mix(in oklab, var(--color-arc-300) 90%, transparent) 0.955turn,
			#eaf3ff 1turn
		);
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		contain: paint;
		/*
			Slow. At anything under about three seconds a light circling a card stops
			reading as a highlight and starts reading as a loading state.
		*/
		animation: plan-trail 5s linear infinite;
		pointer-events: none;
	}

	@keyframes plan-trail {
		to {
			--trail-angle: 360deg;
		}
	}

	/*
		The global reduced-motion rule collapses every animation to 0.001ms, which
		would leave the comet frozen at one corner looking like a rendering fault.
		Drop the ring entirely instead — the card is already marked by its lit
		border, its glow and its badge, none of which move.
	*/
	@media (prefers-reduced-motion: reduce) {
		.plan--featured::after {
			display: none;
		}
	}

	/*
		A lapel pin, not a flat label: a deep gradient fill so it has body of its
		own, a bright rim to draw the eye, a glow to lift it off both the ink
		behind it and the card below, and an inset highlight along the top edge
		for the same "lit from above" read every other raised surface on this
		site gets. The dark ring in the box-shadow is a cutout — a hairline of
		true ink between the badge and whatever is directly behind it, so it
		reads as sitting ON the seam rather than smudged across it.
	*/
	.plan__badge {
		position: absolute;
		/* Above the travelling ring, which crosses the top border it straddles. */
		z-index: 3;
		inset-block-start: 0;
		inset-inline-start: 50%;
		transform: translate(-50%, -50%);
		margin: 0;
		padding: 0.4rem 0.9rem;
		border: 1px solid color-mix(in oklab, var(--color-arc-300) 65%, transparent);
		border-radius: 99px;
		/* Solid: it straddles the card's top edge, so it has the picture behind
		   half of it and needs to read against both. */
		background: linear-gradient(155deg, var(--color-arc-500) 0%, var(--color-arc-700) 100%);
		box-shadow:
			inset 0 1px 0 color-mix(in oklab, #eaf3ff 45%, transparent),
			0 0 0 4px var(--color-ink-950),
			0 10px 24px -8px color-mix(in oklab, var(--color-arc-300) 65%, transparent);
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--color-bone-50);
	}

	/*
		The "Most Popular" pin only, isolated so its own pseudo-element has
		something to stack a glow on.
	*/
	.plan__badge--popular {
		isolation: isolate;
	}

	/*
		The bright glow, breathing in and out all the way around at once —
		rather than travelling, like the card's own border ring does.

		A separate layer behind the badge rather than an animated box-shadow on
		the badge itself: a custom property holding a full shadow value does not
		interpolate — browsers only ever snap between the two keyframes' literal
		values, which reads as a flicker, not a breath. `opacity` on its own
		element is a property browsers genuinely tween, so this fades a fixed,
		already-bright shadow in and out instead of trying to animate the shadow
		itself.
	*/
	.plan__badge--popular::before {
		content: '';
		position: absolute;
		inset: -0.4rem;
		z-index: -1;
		border-radius: inherit;
		box-shadow: 0 0 24px 8px color-mix(in oklab, var(--color-arc-300) 90%, transparent);
