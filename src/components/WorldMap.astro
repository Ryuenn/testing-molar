---
import { REGIONS } from '~/data/reach';

/**
 * Equirectangular graticule with the six served continents plotted from their
 * real latitude/longitude. Everything below is computed at build time and ships
 * as inline SVG: no tiles, no map library, no image request — a few kB of path
 * data. Emoji flags were the alternative and are not a map.
 */
const W = 1000;
const H = 500;

/** Longitude −180…180 → 0…W, latitude 90…−90 → 0…H. */
const x = (lon: number) => ((lon + 180) / 360) * W;
const y = (lat: number) => ((90 - lat) / 180) * H;

const round = (n: number) => Math.round(n * 100) / 100;

// Graticule: meridians every 30°, parallels every 20°.
const meridians = Array.from({ length: 11 }, (_, i) => round(x(-180 + (i + 1) * 30)));
const parallels = Array.from({ length: 8 }, (_, i) => round(y(80 - i * 20)));

const nodes = REGIONS.map((region) => ({
	...region,
	cx: round(x(region.lon)),
	cy: round(y(region.lat)),
}));

// Connect each node to the next so the map reads as one network, not six pins.
const links = nodes.slice(0, -1).map((from, i) => {
	const to = nodes[i + 1]!;
	const mx = round((from.cx + to.cx) / 2);
	// Bow the link away from the equator for a great-circle feel.
	const my = round((from.cy + to.cy) / 2 - Math.abs(to.cx - from.cx) * 0.16);
	return `M${from.cx} ${from.cy} Q${mx} ${my} ${to.cx} ${to.cy}`;
});

const titleId = 'world-map-title';
const descId = 'world-map-desc';
---

<figure class="map">
	<svg
		class="map__svg"
		viewBox={`0 0 ${W} ${H}`}
		role="img"
		aria-labelledby={`${titleId} ${descId}`}
		preserveAspectRatio="xMidYMid meet"
	>
		<title id={titleId}>MOLAR AI practices by continent</title>
		<desc id={descId}>
			A world graticule with MOLAR AI practices marked across {REGIONS.map((r) => r.name).join(', ')}.
		</desc>

		<defs>
			<radialGradient id="node-glow">
				<stop offset="0%" stop-color="var(--color-arc-300)" stop-opacity="0.55"></stop>
				<stop offset="100%" stop-color="var(--color-arc-500)" stop-opacity="0"></stop>
			</radialGradient>
		</defs>

		{/* Graticule */}
		<g class="map__grid" fill="none" stroke="currentColor" stroke-width="1">
			<rect x="0.5" y="0.5" width={W - 1} height={H - 1} rx="2"></rect>
			{meridians.map((mx) => <line x1={mx} y1="0" x2={mx} y2={H} />)}
			{parallels.map((py) => <line x1="0" y1={py} x2={W} y2={py} />)}
			<line class="map__equator" x1="0" y1={H / 2} x2={W} y2={H / 2}></line>
		</g>

		{/* Network */}
		<g class="map__links" fill="none" stroke="currentColor" stroke-width="1.5">
			{links.map((d) => <path d={d} />)}
		</g>

		{/* Nodes */}
		<g class="map__nodes">
			{
				nodes.map((node, i) => (
					<g class="map__node" style={`--i:${i}`}>
						<circle cx={node.cx} cy={node.cy} r="34" fill="url(#node-glow)" />
						<circle class="map__node-ring" cx={node.cx} cy={node.cy} r="11" />
						<circle class="map__node-dot" cx={node.cx} cy={node.cy} r="4" />
						<text
							class="map__label"
							x={node.cx}
							y={node.cy + (node.dy ?? -14)}
							text-anchor={node.align}
						>
							{node.name}
						</text>
					</g>
				))
			}
		</g>
	</svg>
</figure>

<style>
	.map {
		margin: 0;
		position: relative;
	}

	.map__svg {
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.map__grid {
		color: color-mix(in oklab, var(--color-arc-400) 13%, transparent);
	}

	.map__equator {
		stroke: color-mix(in oklab, var(--color-arc-400) 26%, transparent);
		stroke-dasharray: 6 8;
	}

	.map__links {
		color: color-mix(in oklab, var(--color-arc-400) 34%, transparent);
		stroke-dasharray: 3 7;
		stroke-linecap: round;
		animation: map-flow 3.2s linear infinite;
	}

	@keyframes map-flow {
		to {
			stroke-dashoffset: -20;
		}
	}

	.map__node-ring {
		fill: none;
		stroke: var(--color-arc-400);
		stroke-width: 1.25;
		opacity: 0.55;
		transform-origin: center;
		transform-box: fill-box;
		animation: node-breathe 3.6s var(--ease-out-quint) infinite;
		animation-delay: calc(var(--i) * 0.42s);
	}

	.map__node-dot {
		fill: var(--color-arc-300);
	}

	@keyframes node-breathe {
		0%,
		100% {
			opacity: 0.5;
			scale: 1;
		}
		50% {
			opacity: 0.95;
			scale: 1.22;
		}
	}

	.map__label {
		font-family: var(--font-mono);
		font-size: 21px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		fill: var(--color-bone-300);
	}

	/*
		The viewBox scales with the container, so on a phone these labels land at
		around 6px — unreadable noise over the graticule. The list beside the map
		names every region legibly, so drop them rather than shrink the map.
	*/
	@media (max-width: 700px) {
		.map__label {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.map__links,
		.map__node-ring {
			animation: none;
		}
	}
</style>
