---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
/* The trimmed mark — see the note on the same import in `~/components/Nav`. */
import logoMark from '~/assets/brand/logo-mark.png';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { SITE, CTA, PORTAL_LOGIN, EDUCATION_CHECKOUT } from '~/data/site';
import { EDUCATION_PRICE, EDUCATION_TRIAL_DAYS } from '~/data/education';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';
import { PRACTICE_COUNT } from '~/data/proof';
import { COUNTRIES, REGIONS } from '~/data/reach';

/**
 * Every link here points at something that exists.
 *
 * The resource links are pulled from the collection at build time rather than
 * transcribed, and the social accounts come from SITE.
 *
 * ── The 09/01 trim ─────────────────────────────────────────────────────────
 * This footer carried far too much, and most of it contradicted the page above
 * it. What came off, and why:
 *
 *   Patient Education Library   listed as a product beside MOLAR TV, while
 *                               every plan card says it is INCLUDED in MOLAR
 *                               TV. Two names for one thing at the bottom of a
 *                               page that spent five sections merging them.
 *   MOLAR Complete              a product name nothing is actively sold under.
 *   Managed Social Media        renamed MOLAR Social, which is what the rest
 *                               of the site now calls it.
 *   Customers                   the page is gone; its content is on
 *                               /social-media/.
 *   Results                     the same evidence as Our Work, one stop apart.
 *   Global reach                a link to a home-page anchor making a claim the
 *                               flag band directly above this footer already
 *                               makes.
 *   the two badges              "10M+ organic views" and the $500 promo code,
 *                               sitting in the brand column. Both belong where
 *                               they are being argued — the views in the social
 *                               case study, the code on the plan it discounts.
 *   nine resource links         six guides plus a "view all"; three now.
 *
 * The bottom row gained Privacy and Terms. See `LEGAL_LINKS` — they are
 * rendered only once the pages exist, which is why this file used to have none.
 */
const locale = getLocale(Astro);
const t = useTranslations(locale);

/*
	Two products, matching the nav.

	Not derived from `PRODUCTS` any more, and deliberately: that file still
	carries four, because /patient-education/ and /molar-complete/ are real
	routes that real links point at. What the footer lists is what is being SOLD,
	and that is MOLAR TV and MOLAR Social. The other two stay reachable; they
	stop being advertised as separate purchases.
*/
const PRODUCT_LINKS = [
	{ label: t('nav.menuTv'), href: localizePath('/molar-tv/', locale) },
	{ label: t('nav.menuSocial'), href: localizePath('/social-media/', locale) },
	{ label: t('pricing.enterpriseName'), href: localizePath('/pricing/', locale) + '#plans' },
	{ label: t('nav.pricing'), href: localizePath('/pricing/', locale) },
];

/* Everything that is not a product: the pages that explain and prove. */
const COMPANY_LINKS = [
	{ label: t('nav.how'), href: localizePath('/how-it-works/', locale) },
	{ label: t('nav.work'), href: localizePath('/our-work/', locale) },
	{ label: t('nav.resources'), href: localizePath('/resources/', locale) },
	/* Only once there is somewhere for it to go — see PORTAL_LOGIN. */
	...(PORTAL_LOGIN ? [{ label: t('nav.login'), href: PORTAL_LOGIN }] : []),
];

/*
	Same ordering the resource hub uses — featured first, then by `order` — so
	the footer surfaces the same guides the site already leads with.

	THREE, not six. A footer column is a shortlist; a dump of every freebie is a
	page of its own, and there is one, linked underneath. The count in that link
	is derived, so adding a tenth resource updates it without anyone remembering.
*/
const resources = (await getCollection('resources', ({ data }) => !data.draft)).sort((a, b) => {
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return a.data.order - b.data.order;
});

const shownResources = resources.slice(0, 3);

/*
	Shown as marks rather than words. The label is still carried on every one of
	them — see the sr-only span in the markup — because an icon-only link with no
	text is an unnamed control, and an `aria-label` on its own would leave anyone
	driving the page by voice with nothing visible to say.

	Instagram, Facebook, YouTube — the three the plans advertise posting to, and
	the same three the hero rail carries. TikTok is still in `SITE.social` and is
	still declared to Google via `sameAs`; it is simply not one of the channels
	this product publishes.
*/
const SOCIAL_LINKS = [
	{ label: 'Instagram', href: SITE.social.instagram, icon: 'instagram' },
	{ label: 'Facebook', href: SITE.social.facebook, icon: 'facebook' },
	{ label: 'YouTube', href: SITE.social.youtube, icon: 'youtube' },
] as const;

/**
 * Privacy, Terms and Cookies for the bottom row.
 *
 * ⚠️ EMPTY, AND THE ROW RENDERS NOTHING WHILE IT IS. The 09/01 brief asks for
 * "© 2026 MOLAR AI · Privacy Policy · Terms of Service", optionally a Cookie
 * Policy — and none of those three pages exists in this repo. A footer link to
 * a 404 is worse than no link, and a *legal* link to a 404 is worse again,
 * because it implies a policy that cannot be read.
 *
 * Write the pages, add them here, and the row picks them up:
 *   { label: 'Privacy Policy', href: '/privacy/' },
 *   { label: 'Terms of Service', href: '/terms/' },
 */
const LEGAL_LINKS: readonly { label: string; href: string }[] = [];

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__inner">
		<div class="footer__top">
			{/* ── Brand ─────────────────────────────────────────────────────── */}
			<div class="footer__brand">
				{/*
					The mark and the wordmark, assembled here rather than shipped as one
					picture.

					It was `logo-lockup.png`: a raster of the tooth, "MOLAR" and the
					strapline in a single file — and a bad one. The letterforms carried
					heavy compression artefacts, the O was speckled through, and the
					whole thing was soft at every size the footer draws it. It was also
					the last place on the site still rendering the wordmark as pixels;
					the nav went to live text for exactly these reasons.

					So: the real tooth as an image, the name as text. Sharp at any zoom,
					recolours with the theme, and selectable.

					Not a link. The header already carries a home link on its wordmark
					and the nav has an explicit "Home" — a third would just be one more
					stop for anyone tabbing through.
				*/}
				<div class="footer__lockup">
					{/*
						Decorative: the wordmark beside it names the company, and an alt
						here would have a screen reader say "MOLARAI MOLARAI".
					*/}
					<Image
						src={logoMark}
						alt=""
						height={44}
						densities={[1, 2]}
						loading="lazy"
						decoding="async"
						class="footer__mark"
					/>
					{/*
						`AI` is a span rather than a second element so the whole thing stays
						one selectable, copyable string — `MOLARAI`, not `MOLAR` + `AI` with
						a break the clipboard can find. Only its colour differs. The same
						construction as `.nav__wordmark`.
					*/}
					<span class="footer__wordmark">MOLAR<span class="footer__wordmark-ai">AI</span></span>
				</div>

				<p class="footer__pitch">{t('footer.pitch')}</p>

				{/*
					The reach line — practices, countries, continents — counted off the
					data rather than typed. It replaced two badges: a "10M+ organic views"
					pill and the $500 promo code. Both were real, and both were arguing
					in the wrong place; the views belong in the social case study and the
					code belongs on the plan it discounts.
				*/}
				<p class="footer__reach">
					{t('footer.reachLine', {
						practices: PRACTICE_COUNT,
						countries: COUNTRIES.length,
						regions: REGIONS.length,
					})}
				</p>

				{/*
					The follow marks, in the brand column rather than in a column of their
					own. The brief puts them "underneath" the reach line, and it is right:
					four link columns and a fifth holding three icons was a column of
					furniture.
				*/}
				<ul class="footer__social" aria-label={t('footer.follow')}>
					{
						SOCIAL_LINKS.map((link) => (
							<li>
								{/*
									External, so `rel="noopener"`. No `noreferrer` — these are the
									company's own accounts and the referrer is wanted in their
									analytics.
								*/}
								<a href={link.href} class="footer__social-link" target="_blank" rel="noopener">
									<SocialIcon name={link.icon} class="footer__social-icon" />
									{/*
										The link's accessible name. Hidden, not removed — an icon on
										its own names nothing, and "opens in a new tab" is worth
										saying once rather than leaving as a surprise.
									*/}
									<span class="sr-only">{link.label} {t('footer.newTab')}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			{/* ── Link columns ──────────────────────────────────────────────── */}
			<nav aria-label="Footer" class="footer__nav">
				<div class="footer__col">
					<h2 class="footer__heading" id="footer-products">{t('footer.products')}</h2>
					<ul class="footer__list" aria-labelledby="footer-products">
						{
							PRODUCT_LINKS.map((link) => (
								<li>
									<a href={link.href} class="footer__link">
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div class="footer__col">
					<h2 class="footer__heading" id="footer-company">{t('footer.company')}</h2>
					<ul class="footer__list" aria-labelledby="footer-company">
						{
							COMPANY_LINKS.map((link) => (
								<li>
									<a href={link.href} class="footer__link">
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div class="footer__col">
					<h2 class="footer__heading" id="footer-resources">{t('footer.resources')}</h2>
					<ul class="footer__list" aria-labelledby="footer-resources">
						{
							shownResources.map((entry) => (
								<li>
									<a href={localizePath(`/resources/${entry.id}/`, locale)} class="footer__link">
										{entry.data.title}
									</a>
								</li>
							))
						}
						<li>
							<a href={localizePath('/resources/', locale)} class="footer__link footer__link--more">
								{t('footer.allGuides', { n: resources.length })}
								<span aria-hidden="true">&nbsp;&rarr;</span>
							</a>
						</li>
					</ul>
				</div>

				<div class="footer__col">
					{/*
						The follow marks used to head this column; they are in the brand
						column now, under the reach line. What is left is the one thing the
						foot of the page should end on: the offer, priced, with a button.
					*/}
					<h2 class="footer__heading" id="footer-start">{t('footer.getStarted')}</h2>

					{/*
						No aria-labelledby on either paragraph. On a plain <p> an accessible
						name replaces the content rather than introducing it, so these would
						be announced as "Get started" and the sentences would be lost. The
						list below carries the association instead.
					*/}
					<p class="footer__offer">
						{t('footer.startOffer', { price: EDUCATION_PRICE })}
					</p>
					<p class="footer__note">
						{t('footer.startNote', { n: EDUCATION_TRIAL_DAYS })}
					</p>

					<ul class="footer__list" aria-labelledby="footer-start">
						<li>
							<a
								href={EDUCATION_CHECKOUT}
								target="_blank"
								rel="noopener"
								class="footer__link footer__link--more"
							>
								{t('pricing.educationCta')}
								<span class="sr-only"> {t('footer.newTab')}</span>
								<span aria-hidden="true">&nbsp;&rarr;</span>
							</a>
						</li>
					</ul>

					{/* The other door, for the two plans that are not bought from a
					    button. */}
					<p class="footer__note footer__note--spaced">{t('footer.needMore')}</p>
					<ul class="footer__list">
						<li>
							<a
								href={CTA.sales.href}
								target="_blank"
								rel="noopener"
								class="footer__link footer__link--more"
							>
								{t('cta.talk')}
								<span class="sr-only"> {t('footer.newTab')}</span>
								<span aria-hidden="true">&nbsp;&rarr;</span>
							</a>
						</li>
					</ul>
				</div>
			</nav>
		</div>

		{/* ── Bottom bar ────────────────────────────────────────────────────── */}
		{/*
			Copyright, then the policies, then the address. The tagline came off the
			end of the copyright line: the brief's rule for the bottom of this page
			is that it gets simpler, and a strapline in a legal row is a claim in a
			place nobody reads claims.

			`SITE.legalName` — "MOLAR AI", with the space, because this is the legal
			line and that is the registered name. The wordmarks above and in the nav
			are the brand and set it solid as MOLARAI; the difference between the
			two spellings is deliberate and is the one place on the site where it is.
		*/}
		<div class="footer__bottom">
			<p class="footer__legal">&copy; {year} {SITE.legalName}</p>

			{/* Rendered only once the pages exist — see LEGAL_LINKS. */}
			{
				LEGAL_LINKS.length > 0 && (
					<nav aria-label={t('footer.legal')} class="footer__legal-nav">
						<ul class="footer__legal-list">
							{LEGAL_LINKS.map((link) => (
								<li>
									<a href={localizePath(link.href, locale)} class="footer__mail">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}

			<p class="footer__contact">
				<a href={`mailto:${SITE.email}`} class="footer__mail">{SITE.email}</a>
			</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--color-line);
		background: var(--color-ink-950);
		padding-block: clamp(3rem, 6vw, 5rem) clamp(1.75rem, 3vw, 2.5rem);
	}

	/*
		Its own measure rather than `.container-content`'s 76rem. The footer is
		furniture like the nav and the hero band, and it takes the same 112rem
		shell they do — held to the reading measure it leaves a third of a wide
		window empty at the sides while squeezing four link columns into 11rem
		each, which is what wraps every second label.
	*/
	.footer__inner {
		width: calc(100% - var(--gutter) * 2);
		max-width: 112rem;
		margin-inline: auto;
	}

	.footer__top {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	/* ── Brand ───────────────────────────────────────────────────────────── */
	.footer__brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.footer__lockup {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
	}

	/*
		Bigger than the nav's 30px. This lockup is the only thing holding the left
		column, so it carries the weight the nav shares with its links.

		The glow is the art's own light carried past its edges. The delivered file
		is a lit object on transparent, and a `drop-shadow` follows the tooth's
		silhouette rather than boxing it — which is the difference between the mark
		emitting light and sitting in a rectangle of it.
	*/
	.footer__mark {
		width: auto;
		height: 2.75rem;
		filter: drop-shadow(0 0 10px color-mix(in oklab, var(--color-arc-500) 40%, transparent));
	}

	/*
		Live text, the same decision the nav made. See the note in the markup for
		what it replaced.

		MOLARAI, the same as the nav — one word, no space and no point, with the
		`AI` lit in arc-400.

		It read plain `MOLAR` here on the reasoning that the nav names the PRODUCT
		and the foot of the page names the COMPANY. That distinction stopped being
		true when the nav went to `MOLARAI`: both now name the company, the
		copyright line two rows down says `MOLAR AI`, and the only thing the split
		was achieving was a header and a footer that spelt the brand two ways on
		one screen.
	*/
	.footer__wordmark {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1;
		white-space: nowrap;
		color: var(--color-bone-50);
	}

	/* The one difference between the two halves, and the same value the nav
	   uses: arc-400 rather than the brighter 300, which beside white at this
	   weight reads as a highlight rather than as part of the same word. */
	.footer__wordmark-ai {
		color: var(--color-arc-400);
	}

	.footer__pitch {
		margin: 0;
		max-width: 34ch;
		font-size: var(--text-sm);
		color: var(--color-bone-400);
	}

	/*
		The reach line, plain. It replaced two bordered pills — the view count and
		the promo code — and a plain line is what a fact wants down here; a badge
		is a thing that draws the eye, and the foot of the page is where the eye
		should be resting.
	*/
	.footer__reach {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-bone-400);
	}

	/* ── Link columns ────────────────────────────────────────────────────── */
	.footer__nav {
		display: grid;
		gap: 2.25rem 3rem;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
	}

	.footer__col {
		min-width: 0;
	}

	.footer__heading {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}


	.footer__list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/*
		A row, not a column. Three marks stacked vertically read as a list of
		things to decide between; side by side they read as one set — which is what
		a social row is.
	*/
	.footer__social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/*
		The tile is the hit area, and it is deliberately larger than the mark it
		holds: 2.75rem clears the 24px minimum a pointer target should meet, which
		the 20px glyph on its own would not.
	*/
	.footer__social-link {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.7rem;
		border: 1px solid var(--color-line);
		background: color-mix(in oklab, var(--color-ink-900) 70%, transparent);
		color: var(--color-bone-300);
		transition:
			color 0.24s var(--ease-out-quint),
			border-color 0.24s var(--ease-out-quint),
			background-color 0.24s var(--ease-out-quint);
	}

	.footer__social-link:hover {
		color: var(--color-bone-50);
		border-color: color-mix(in oklab, var(--color-arc-400) 45%, transparent);
		background: color-mix(in oklab, var(--color-arc-600) 16%, transparent);
	}

	.footer__social-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	.footer__link {
		display: inline-block;
		font-size: var(--text-sm);
		line-height: 1.45;
		color: var(--color-bone-300);
		text-decoration: none;
		transition: color 0.24s var(--ease-out-quint);
	}

	.footer__link:hover {
		color: var(--color-bone-50);
	}

	.footer__link--more {
		color: var(--color-arc-300);
	}

	.footer__link--more:hover {
		color: var(--color-arc-200);
	}

	/* The offer, at the head of the Get Started column. The one line in this
	   footer set at reading weight rather than as a caption. */
	.footer__offer {
		margin: -0.25rem 0 0.25rem;
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-bone-50);
	}

	.footer__note {
		margin: 0 0 0.85rem;
		max-width: 24ch;
		font-size: var(--text-xs);
		color: var(--color-bone-500);
	}

	.footer__note--spaced {
		margin-top: 1.5rem;
	}

	/* ── Bottom bar ──────────────────────────────────────────────────────── */
	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: clamp(2.5rem, 5vw, 4rem);
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--color-line);
	}

	.footer__legal,
	.footer__contact {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-bone-500);
	}

	.footer__legal-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.footer__mail {
		color: var(--color-bone-400);
		text-decoration: none;
		transition: color 0.24s var(--ease-out-quint);
	}

	.footer__mail:hover {
		color: var(--color-arc-300);
		text-decoration: underline;
	}

	/*
		The brand column holds its own measure and the link columns take what is
		left. Below this they stack, and the link columns keep auto-fitting so
		three become two become one without another breakpoint.
	*/
	@media (min-width: 900px) {
		.footer__top {
			grid-template-columns: minmax(18rem, 26rem) 1fr;
			gap: clamp(3rem, 7vw, 8rem);
		}

		.footer__nav {
			/* Four columns now that products and company are separate lists.
			   The resource column runs longest, so it is the one that decides
			   the row height either way. */
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
