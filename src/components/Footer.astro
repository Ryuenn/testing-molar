---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logoLockup from '~/assets/brand/logo-lockup.png';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { SITE, PROMO, CTA, PORTAL_LOGIN } from '~/data/site';
import { PRODUCTS } from '~/data/products';
import { localizePath } from '~/i18n/config';
import { getLocale, useTranslations } from '~/i18n/utils';
import { PROOF_HEADLINE, PROOF_SUB } from '~/data/proof';

/**
 * Every link here points at something that exists.
 *
 * The section anchors are real ids on the home page, the resource links are
 * pulled from the collection at build time rather than transcribed, and the
 * social accounts come from SITE. There is deliberately no Terms or Privacy
 * link: those pages have not been written, and a footer link to a 404 is worse
 * than no link at all.
 */
const locale = getLocale(Astro);
const t = useTranslations(locale);

/*
	The four products, from the one place they are defined. A product that
	exists in ~/data/products appears here without anybody remembering to add
	it, which is the whole reason that file is the spine of the site.
*/
const PRODUCT_LINKS = PRODUCTS.map((product) => ({
	label: t(`products.${product.key}Name` as 'products.socialName'),
	href: localizePath(product.href, locale),
}));

/* Everything that is not a product: the pages that explain, prove and price. */
const COMPANY_LINKS = [
	{ label: t('nav.how'), href: localizePath('/how-it-works/', locale) },
	{ label: t('nav.customers'), href: localizePath('/customers/', locale) },
	{ label: t('nav.work'), href: localizePath('/our-work/', locale) },
	{ label: t('nav.results'), href: localizePath('/results/', locale) },
	{ label: t('nav.pricing'), href: localizePath('/pricing/', locale) },
	// The one home-page section with no page of its own.
	{ label: t('footer.reach'), href: localizePath('/', locale) + '#reach' },
	/* Only once there is somewhere for it to go — see PORTAL_LOGIN. */
	...(PORTAL_LOGIN ? [{ label: t('nav.login'), href: PORTAL_LOGIN }] : []),
];

/*
	Same ordering the resource hub uses — featured first, then by `order` — so
	the footer surfaces the same guides the site already leads with. Sliced
	rather than listed in full: the count in the "all guides" link is derived,
	so adding a tenth resource updates it without anyone remembering to.
*/
const resources = (await getCollection('resources', ({ data }) => !data.draft)).sort((a, b) => {
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return a.data.order - b.data.order;
});

const shownResources = resources.slice(0, 6);

/*
	Shown as marks rather than words. The label is still carried on every one of
	them — see the sr-only span in the markup — because an icon-only link with no
	text is an unnamed control, and an `aria-label` on its own would leave anyone
	driving the page by voice with nothing visible to say.
*/
const SOCIAL_LINKS = [
	{ label: 'Instagram', href: SITE.social.instagram, icon: 'instagram' },
	{ label: 'TikTok', href: SITE.social.tiktok, icon: 'tiktok' },
	{ label: 'YouTube', href: SITE.social.youtube, icon: 'youtube' },
] as const;

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__inner">
		<div class="footer__top">
			{/* ── Brand ─────────────────────────────────────────────────────── */}
			<div class="footer__brand">
				{/*
					Not a link. The header already carries a home link on the wordmark
					and the nav now has an explicit "Home" — a third would just be one
					more stop for anyone tabbing through.
				*/}
				<div class="footer__lockup">
					<Image
						src={logoLockup}
						alt="MOLAR — dental content, intelligently delivered."
						height={52}
						densities={[1, 2]}
						loading="lazy"
						decoding="async"
						class="footer__mark"
					/>
				</div>

				<p class="footer__pitch">{t('site.positioning')}</p>

				{/*
					Two facts the site already makes elsewhere, not badges invented for
					the footer: the headline proof stat, and the promo code that runs on
					the Premium tier.
				*/}
				<p class="footer__pill">
					<span class="footer__pill-dot" aria-hidden="true"></span>
					<span><strong>{PROOF_HEADLINE}</strong> {PROOF_SUB}</span>
				</p>

				<p class="footer__pill">
					<code class="footer__code">{PROMO.code}</code>
					<span>{PROMO.discount} {PROMO.appliesTo}</span>
				</p>
			</div>

			{/* ── Link columns ──────────────────────────────────────────────── */}
			<nav aria-label="Footer" class="footer__nav">
				<div class="footer__col">
					<h2 class="footer__heading" id="footer-products">{t('footer.products')}</h2>
					<ul class="footer__list" aria-labelledby="footer-products">
						{
							PRODUCT_LINKS.map((link) => (
								<li>
									<a href={link.href} class="footer__link">
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div class="footer__col">
					<h2 class="footer__heading" id="footer-company">{t('footer.company')}</h2>
					<ul class="footer__list" aria-labelledby="footer-company">
						{
							COMPANY_LINKS.map((link) => (
								<li>
									<a href={link.href} class="footer__link">
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div class="footer__col">
					<h2 class="footer__heading" id="footer-resources">{t('footer.resources')}</h2>
					<ul class="footer__list" aria-labelledby="footer-resources">
						{
							shownResources.map((entry) => (
								<li>
									<a href={localizePath(`/resources/${entry.id}/`, locale)} class="footer__link">
										{entry.data.title}
									</a>
								</li>
							))
						}
						<li>
							<a href={localizePath('/resources/', locale)} class="footer__link footer__link--more">
								{t('footer.allGuides', { n: resources.length })}
								<span aria-hidden="true">&nbsp;&rarr;</span>
							</a>
						</li>
					</ul>
				</div>

				<div class="footer__col">
					<h2 class="footer__heading" id="footer-follow">{t('footer.follow')}</h2>
					<ul class="footer__social" aria-labelledby="footer-follow">
						{
							SOCIAL_LINKS.map((link) => (
								<li>
									{/*
										External, so `rel="noopener"`. No `noreferrer` — these are
										the company's own accounts and the referrer is wanted in
										their analytics.
									*/}
									<a
										href={link.href}
										class="footer__social-link"
										target="_blank"
										rel="noopener"
									>
										<SocialIcon name={link.icon} class="footer__social-icon" />
										{/*
											The link's accessible name. Hidden, not removed — an icon
											on its own names nothing, and "opens in a new tab" is
											worth saying once rather than leaving as a surprise.
										*/}
										<span class="sr-only">{link.label} {t('footer.newTab')}</span>
									</a>
								</li>
							))
						}
					</ul>

					<h2 class="footer__heading footer__heading--spaced" id="footer-start">{t('footer.getStarted')}</h2>
					{/*
						No aria-labelledby on the note. On a plain <p> an accessible name
						replaces the content rather than introducing it, so this would be
						announced as "Get started" and the sentence would be lost. The
						list below carries the association instead.
					*/}
					<p class="footer__note">{t('footer.startNote')}</p>
					<ul class="footer__list" aria-labelledby="footer-start">
						<li>
							<a href={localizePath(CTA.secondary.href, locale)} class="footer__link footer__link--more">
								{t('cta.plans')}
								<span aria-hidden="true">&nbsp;&rarr;</span>
							</a>
						</li>
						<li>
							<a href={CTA.sales.href} class="footer__link footer__link--more">
								{t('cta.sales')}
								<span aria-hidden="true">&nbsp;&rarr;</span>
							</a>
						</li>
					</ul>
				</div>
			</nav>
		</div>

		{/* ── Bottom bar ────────────────────────────────────────────────────── */}
		<div class="footer__bottom">
			<p class="footer__legal">
				&copy; {year} {SITE.legalName}. {t('site.tagline')}
			</p>
			<p class="footer__contact">
				<a href={`mailto:${SITE.email}`} class="footer__mail">{SITE.email}</a>
			</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--color-line);
		background: var(--color-ink-950);
		padding-block: clamp(3rem, 6vw, 5rem) clamp(1.75rem, 3vw, 2.5rem);
	}

	/*
		Its own measure rather than `.container-content`'s 76rem. The footer is
		furniture like the nav and the hero band, and it takes the same 112rem
		shell they do — held to the reading measure it leaves a third of a wide
		window empty at the sides while squeezing four link columns into 11rem
		each, which is what wraps every second label.
	*/
	.footer__inner {
		width: calc(100% - var(--gutter) * 2);
		max-width: 112rem;
		margin-inline: auto;
	}

	.footer__top {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	/* ── Brand ───────────────────────────────────────────────────────────── */
	.footer__brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.footer__lockup {
		display: inline-flex;
		align-items: center;
	}

	/*
		The full lockup, tagline included — the nav carries the wordmark alone
		because 5px type is not type, but down here there is room to set it and
		the strapline is the last thing the page says.

		Taller than the nav's, at 3.25rem: this is the only thing holding the left
		column, so it carries the weight the nav shares with its links.
	*/
	.footer__mark {
		width: auto;
		height: 3.25rem;
		filter: drop-shadow(0 0 10px color-mix(in oklab, var(--color-arc-500) 40%, transparent));
	}

	.footer__pitch {
		margin: 0;
		max-width: 34ch;
		font-size: var(--text-sm);
		color: var(--color-bone-400);
	}

	.footer__pill {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		padding: 0.5rem 0.875rem;
		border: 1px solid var(--color-line);
		border-radius: 0.625rem;
		background: color-mix(in oklab, var(--color-ink-800) 55%, transparent);
		font-size: var(--text-xs);
		color: var(--color-bone-300);
	}

	.footer__pill strong {
		color: var(--color-bone-50);
		font-weight: 600;
	}

	.footer__pill-dot {
		flex: none;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--color-arc-400);
		box-shadow: 0 0 8px color-mix(in oklab, var(--color-arc-400) 80%, transparent);
	}

	.footer__code {
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		letter-spacing: 0.08em;
		padding: 0.2rem 0.45rem;
		border-radius: var(--radius-sm);
		background: color-mix(in oklab, var(--color-arc-500) 18%, transparent);
		color: var(--color-arc-200);
	}

	/* ── Link columns ────────────────────────────────────────────────────── */
	.footer__nav {
		display: grid;
		gap: 2.25rem 3rem;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
	}

	.footer__col {
		min-width: 0;
	}

	.footer__heading {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: var(--text-2xs);
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-bone-500);
	}

	.footer__heading--spaced {
		margin-top: 2rem;
	}

	.footer__list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/*
		A row, not a column. Three marks stacked vertically read as a list of
		things to decide between; side by side they read as one set — which is what
		a social row is.
	*/
	.footer__social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/*
		The tile is the hit area, and it is deliberately larger than the mark it
		holds: 2.75rem clears the 24px minimum a pointer target should meet, which
		the 20px glyph on its own would not.
	*/
	.footer__social-link {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.7rem;
		border: 1px solid var(--color-line);
		background: color-mix(in oklab, var(--color-ink-900) 70%, transparent);
		color: var(--color-bone-300);
		transition:
			color 0.24s var(--ease-out-quint),
			border-color 0.24s var(--ease-out-quint),
			background-color 0.24s var(--ease-out-quint);
	}

	.footer__social-link:hover {
		color: var(--color-bone-50);
		border-color: color-mix(in oklab, var(--color-arc-400) 45%, transparent);
		background: color-mix(in oklab, var(--color-arc-600) 16%, transparent);
	}

	.footer__social-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	.footer__link {
		display: inline-block;
		font-size: var(--text-sm);
		line-height: 1.45;
		color: var(--color-bone-300);
		text-decoration: none;
		transition: color 0.24s var(--ease-out-quint);
	}

	.footer__link:hover {
		color: var(--color-bone-50);
	}

	.footer__link--more {
		color: var(--color-arc-300);
	}

	.footer__link--more:hover {
		color: var(--color-arc-200);
	}

	.footer__note {
		margin: -0.25rem 0 0.85rem;
		max-width: 24ch;
		font-size: var(--text-xs);
		color: var(--color-bone-500);
	}

	/* ── Bottom bar ──────────────────────────────────────────────────────── */
	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: clamp(2.5rem, 5vw, 4rem);
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--color-line);
	}

	.footer__legal,
	.footer__contact {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-bone-500);
	}

	.footer__mail {
		color: var(--color-bone-400);
		text-decoration: none;
		transition: color 0.24s var(--ease-out-quint);
	}

	.footer__mail:hover {
		color: var(--color-arc-300);
		text-decoration: underline;
	}

	/*
		The brand column holds its own measure and the link columns take what is
		left. Below this they stack, and the link columns keep auto-fitting so
		three become two become one without another breakpoint.
	*/
	@media (min-width: 900px) {
		.footer__top {
			grid-template-columns: minmax(18rem, 26rem) 1fr;
			gap: clamp(3rem, 7vw, 8rem);
		}

		.footer__nav {
			/* Four columns now that products and company are separate lists.
			   The resource column runs longest, so it is the one that decides
			   the row height either way. */
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
