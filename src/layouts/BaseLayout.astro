---
/*
	Self-hosted variable fonts. Bundled by Vite and served same-origin, so there
	is no third-party font request to allow through the CSP and no render-blocking
	round trip to fonts.googleapis.com.
*/
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import '~/styles/global.css';

import Seo from '~/components/Seo.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import type { OgImage, PageType } from '~/data/seo';
import { SITE } from '~/data/site';
import { organizationSchema, websiteSchema } from '~/data/schema';
import { LOCALES, DEFAULT_LOCALE, localizePath } from '~/i18n/config';
import { getLocale } from '~/i18n/utils';

export interface Props {
	title: string;
	description: string;
	/** Per-page social card. No sitewide default — see Seo.astro. */
	ogImage: OgImage;
	type?: PageType;
	noindex?: boolean;
	/** Page-specific JSON-LD. Organization + WebSite are added here for every page. */
	schema?: Record<string, unknown>[];
	/** Hero pages let the nav start transparent. */
	transparentNav?: boolean;
	class?: string;
}

const {
	title,
	description,
	ogImage,
	type = 'website',
	noindex = false,
	schema = [],
	transparentNav = false,
	class: className,
} = Astro.props;

const locale = getLocale(Astro);
const htmlLang = LOCALES.find((l) => l.code === locale)?.htmlLang ?? 'en';

/*
	One alternate per locale plus x-default, built from this page's own path so
	each page points at its own translation rather than at the other language's
	home page. Absolute URLs — hreflang is ignored when it is relative.
*/
const alternates = LOCALES.map((l) => ({
	hreflang: l.htmlLang,
	href: new URL(localizePath(Astro.url.pathname, l.code), SITE.origin).href,
}));
const xDefault = new URL(localizePath(Astro.url.pathname, DEFAULT_LOCALE), SITE.origin).href;

const graph = [organizationSchema(), websiteSchema(), ...schema];

/**
 * Cache-buster on the favicon links below. Bump it when the icons change —
 * their filenames are stable, and a browser that has one will not go looking
 * for another.
 */
const ICON_VERSION = 2;
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#05070d" />
		<meta name="format-detection" content="telephone=no" />

		{/*
			Icons are generated from one master by `npm run icons` — see
			scripts/generate-icons.mjs. The .ico carries 16/32/48 for browsers that
			still ask for it by convention; the PNG is there for everything that
			would rather have a bigger one.

			`?v=` because the filenames are stable and browsers keep favicons in a
			cache of their own that pays no attention to `must-revalidate` — a
			replaced icon can sit unnoticed in a tab for days. The query is part of
			the cache key, so bumping it is what actually ships a new mark. Bump it
			whenever `npm run icons` produces a different one.
		*/}
		<link rel="icon" href={`/favicon.ico?v=${ICON_VERSION}`} sizes="32x32" />
		<link rel="icon" href={`/favicon-96.png?v=${ICON_VERSION}`} type="image/png" sizes="96x96" />
		<link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${ICON_VERSION}`} />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		{/*
			Every locale points at every locale, itself included — that reciprocity is
			what Google requires before it will treat two pages as translations rather
			than as duplicates. Suppressed on noindex pages, which have no canonical
			either and are not meant to be discovered in any language.
		*/}
		{
			!noindex &&
				alternates.map((alt) => (
					<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
				))
		}
		{!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}

		<Seo
			title={title}
			description={description}
			ogImage={ogImage}
			type={type}
			noindex={noindex}
			schema={graph}
		/>

		{/*
			Runs before first paint so reveal targets are only hidden when there is
			both JS to reveal them and a motion preference that allows it. Any other
			ordering risks a page of invisible content.
		*/}
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				try {
					if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						root.classList.add('motion-ok');
					}
				} catch (e) {
					/* no matchMedia — leave content visible */
				}
			})();
		</script>

		<slot name="head" />
	</head>

	<body class={className}>
		<a class="skip-link" href="#main">Skip to content</a>

		<Nav transparent={transparentNav} />

		<main id="main">
			<slot />
		</main>

		<Footer />

		<script>
			import '~/scripts/motion';
		</script>
	</body>
</html>
